@{
    ViewData["Title"] = "To Return Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CleanBrilliantCompany.Models.Entity;
@model List<Dictionary<string, object>>

<div class="px-5">
<button class="btn btn-secondary" onclick="history.back()">Go Back</button>
<h2 class="mt-5">Items to be returned:</h2>
<p>Click on Return Item to generate a return form.</p>

@if (Model != null && Model.Count > 0)
{

    <table class="table">
        <thead>
            <tr>
                <th>Item ID</th>
                <th>Product ID</th>
                <th>Sale Price</th>
                <th>Batch Code</th>
                <th>Warehouse ID</th>
                <th>Status</th>
                <th>Expiry Date</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var itemInfo in Model)
            {
                <tr>
                    <td>@itemInfo["ItemId"]</td>
                    <td>@itemInfo["ProductId"]</td>
                    <td>@itemInfo["SalePrice"]</td>
                    <td>@itemInfo["BatchCode"]</td>
                    <td>@itemInfo["WarehouseId"]</td>
                    <td>@itemInfo["ItemStatus"]</td>
                    <td>@itemInfo["ExpiryDate"]</td>
                    <td>
                        <a asp-controller="ReturnForm" asp-action="Create"
                           asp-route-productId="@itemInfo["ProductId"]"
                           asp-route-itemId="@itemInfo["ItemId"]"
                           class="btn btn-primary">Return Item</a>
                    </td>
                </tr>

            }
        </tbody>
    </table>

}

else
{
    <p class="text-center">Nothing to return.</p>
}

</div>
<body>
    </div>
    </div>
    </div>
</body>
</html>