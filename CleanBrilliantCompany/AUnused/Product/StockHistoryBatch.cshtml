@* @model Dictionary<string, List<CleanBrilliantCompany.Models.Entity.StockHistory>> *@
@model List<Dictionary<string, object>>

<h2>Product Batch Listings</h2>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Product Batch Listings</title>
</head>
<body>

@if (Model != null && Model.Any())
    {
        <table border="1">
            <tr>
                <th>Stock ID</th>
                <th>Batch Code</th>
                <th>Stock Take Date</th>
                <th>Quantity</th>
                <th>Time Recorded</th>
            </tr>
            @foreach (var stockHistoryInfo in Model) 
            {
                <tr>
                    <td>@stockHistoryInfo["StockId"]</td>
                    <td>@stockHistoryInfo["BatchCode"]</td>
                    <td>@stockHistoryInfo["StockTakeDate"]</td>
                    <td>@stockHistoryInfo["Quantity"]</td>
                    <td>@stockHistoryInfo["RecordedDate"]</td>
                </tr>
            }
        </table>
    }
    else
    {
        <p>No product batches available.</p>
    }


