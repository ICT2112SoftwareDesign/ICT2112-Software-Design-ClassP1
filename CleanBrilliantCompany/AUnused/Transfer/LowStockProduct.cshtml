@{
    ViewData["Title"] = "View Low Product Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<Dictionary<string, object>>

@* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> *@
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<body id="page-top">

                <!-- Begin Page Content -->
 <div class="container-fluid">

    <h2>Low Stock Product List</h2>

    <a class="btn btn-primary" id="redirectToTransfer" asp-controller="Transfer" asp-action="Transfer">
        View Transfer Request
    </a>

    <br /><br />

    <form method="get" action="@Url.Action("LowStockProduct", "Transfer")">
        <div class="form-group">
            <label for="warehouseFilter">Filter by Warehouse:</label>
            <select name="warehouseId" id="warehouseFilter" class="form-control"
                onchange="this.form.submit()">
                <option value="">All Warehouses</option>
                @foreach (var warehouse in ViewBag.Warehouses)
                {
                                    int warehouseId = Convert.ToInt32(warehouse.Id); // Ensure it's an integer
                                                                                                                                                                                                                                        <option value="@warehouseId"
                                                                                                                                                                                                                                            selected="@(ViewBag.SelectedWarehouse != null && Convert.ToInt32(ViewBag.SelectedWarehouse) == warehouseId ? "selected" : null)">
                                                                                                                                                                                                                                            @warehouse.Name
                                                                                                                                                                                                                                        </option>
                }
            </select>
        </div>
    </form>


                    @if (Model == null || !Model.Any())
                    {
                                        <p>No Transfer Record Found.</p>
                    }
                    else
                    {
                        <script>
                            // Store all warehouse details for JavaScript - use ViewBag.AllWarehouses instead of extracting from Model
                            const allWarehouses = [
                                @foreach (var warehouse in ViewBag.AllWarehouses)
                                {
                                                    <text>{id: "@warehouse.Id", name: "@warehouse.Name" },</text>
                                }
                            ];
                        </script>


                        <table class="table table-bordered table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Product Name</th>
                                    <th>Warehouse</th>
                                    <th>Total Quantity</th>
                                    <th>Available Capacity</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var productInfo in Model)
                                {
                                                    <tr>
                                                        <td>@productInfo["ProductName"]</td>
                                                        <td>@productInfo["WarehouseName"]</td>
                                                        <td>@productInfo["TotalQuantity"]</td>
                                                        <td>@productInfo["AvailableCapacity"]</td>
                                                        <td>
                                                            <button type="button" class="btn btn-primary create-transfer-btn"
                                                                data-bs-toggle="modal" data-bs-target="#transferModal"
                                                                data-product-id="@productInfo["ProductId"]"
                                                                data-destination-warehouse-id="@productInfo["WarehouseId"]"
                                                                data-destination-warehouse-name="@productInfo["WarehouseName"]">
                                                                Create Transfer Request
                                                            </button>
                                                        </td>
                                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Modal for Transfer Request -->
                        <div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalLabel"
                            aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="transferModalLabel">Create Transfer Request</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <form id="transferForm" method="post" asp-controller="Transfer"
                                            asp-action="AddTransfer">
                                            <input type="hidden" id="productIdInput" name="productId" value="" />

                                            <!-- Source Warehouse -->
                                            <div class="mb-3">
                                                <label for="sourceWarehouse" class="form-label">Source Warehouse</label>
                                                <select class="form-control" name="sourceWarehouse" id="sourceWarehouse"
                                                    required>
                                                    <option value="">Select Source Warehouse</option>
                                                </select>
                                            </div>


                                            <!-- Available Stock -->
                                            <div class="mb-3">
                                                <label class="form-label">Available Stock</label>
                                                <input type="text" class="form-control" id="availableStock" readonly>
                                            </div>

                                            <!-- Destination Warehouse (Uneditable) -->
                                            <div class="mb-3">
                                                <label class="form-label">Destination Warehouse</label>
                                                <input type="text" class="form-control" id="destinationWarehouseDisplay"
                                                    readonly>
                                                <input type="hidden" name="destinationWarehouse" id="destinationWarehouse"
                                                    required>
                                            </div>


                                            <div class="mb-3">
                                                <label for="quantity" class="form-label">Transfer Quantity</label>
                                                <input type="number" class="form-control" name="quantity" id="quantity"
                                                    required>
                                            </div>

                                            <button type="submit" class="btn btn-primary">Submit Request</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <nav>
                            <ul class="pagination">
                                @if (ViewBag.CurrentPage > 1)
                                {
                                                    <li class="page-item">
                                                        <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)">Previous</a>
                                                    </li>
                                }

                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                        <a class="page-link" href="?page=@i">@i</a>
                                                    </li>
                                }

                                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                {
                                                    <li class="page-item">
                                                        <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)">Next</a>
                                                    </li>
                                }
                            </ul>
                        </nav>

            }
        </div>
            <!-- /.container-fluid -->

            <!-- End of Main Content -->

   <script>
    function populateSourceWarehouses(destinationWarehouseId) {
        const sourceSelect = document.getElementById('sourceWarehouse');

        // Clear previous options except the default one
        while (sourceSelect.options.length > 1) {
            sourceSelect.remove(1);
        }

        // Add all warehouses except the destination warehouse
        allWarehouses.forEach(warehouse => {
            if (warehouse.id !== destinationWarehouseId) {
                const option = document.createElement('option');
                option.value = warehouse.id;
                option.text = warehouse.name;
                sourceSelect.add(option);
            }
        });
    }

    async function fetchAvailableStock(productId, warehouseId) {
        try {
            document.getElementById('availableStock').value = "Loading...";
            let response = await
                fetch(`/inventory/management/stockflow/transfer/getStockForWarehouse?productId=${productId}&warehouseId=${warehouseId}`);
            let data = await response.json();
            if (response.ok) {
                document.getElementById('availableStock').value = data.quantity;
            } else {
                document.getElementById('availableStock').value = "Error: " + (data.message || "Could not fetch stock");
                console.error("API error:", data);
            }
        } catch (error) {
            console.error("Fetch error:", error);
            document.getElementById('availableStock').value = "Error fetching stock";
        }
    }

    // Set up event listeners once the DOM is fully loaded
    document.addEventListener('DOMContentLoaded', function () {
        // Button click event handlers
        document.querySelectorAll(".create-transfer-btn").forEach(button => {
            button.addEventListener("click", function () {
                const productId = this.getAttribute('data-product-id');
                const destinationWarehouseId = this.getAttribute('data-destination-warehouse-id');
                const destinationWarehouseName = this.getAttribute('data-destination-warehouse-name');

                // Set product ID in the form
                document.getElementById('productIdInput').value = productId;

                // Set destination warehouse details (Uneditable)
                document.getElementById('destinationWarehouse').value = destinationWarehouseId;
                document.getElementById('destinationWarehouseDisplay').value = destinationWarehouseName;

                // Populate source warehouse dropdown (excluding destination warehouse)
                populateSourceWarehouses(destinationWarehouseId);

                // Reset quantity field
                document.getElementById('quantity').value = '';

                // Reset available stock field
                document.getElementById('availableStock').value = '';
            });
        });

        // Set up the source warehouse change event listener only once
        document.getElementById('sourceWarehouse').addEventListener("change", function () {
            let selectedSourceWarehouse = this.value;
            let productId = document.getElementById('productIdInput').value;

            if (selectedSourceWarehouse && productId) {
                fetchAvailableStock(productId, selectedSourceWarehouse);
            } else {
                document.getElementById('availableStock').value = '';
            }
        });

        // Form submission handling
        document.getElementById("transferForm").addEventListener("submit", function (event) {
            event.preventDefault();

            let quantity = parseInt(document.getElementById("quantity").value, 10);
            let sourceWarehouse = document.getElementById("sourceWarehouse").value;
            let destinationWarehouse = document.getElementById("destinationWarehouse").value;
            let availableStock = parseInt(document.getElementById("availableStock").value, 10) || 0;

            // Client-side validation
            if (!sourceWarehouse) {
                alert("Please select a source warehouse.");
                return;
            }

            if (isNaN(quantity) || quantity <= 0) { 
                alert("Please enter a valid quantity."); 
                return; 
            } 
            
            // Uncomment if you want to validate against available stock
            /* if (quantity > availableStock) {
                alert("Quantity exceeds available stock!"); 
                return;
            } */

            let form = this; 
            let formData = new FormData(form); 
            
            fetch(form.action, { 
                method: "POST", 
                body: formData 
            }).then(response => {
                if (!response.ok) {
                    // If the server responds with an error status code
                    return Promise.reject('Server error occurred');
                }
                return response.json(); // Continue parsing the JSON if no error
            })
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.href = "transfer/ViewTransfer"; // Redirect to ViewTransfer
                } else {
                    console.log("Error:", data.message);
                    alert("Error: " + (data.message || "An unexpected error occurred.")); // Display message
                }
            })
            .catch(error => {
                // Handle unexpected fetch errors (e.g., network issues)
                console.error("Fetch error:", error);
                alert("An unexpected error occurred. Please try again.");
            });
        });
    });
</script>



</body>
