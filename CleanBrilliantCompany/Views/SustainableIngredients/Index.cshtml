<description>
    View displaying sustainable ingredient inventory with alerts for low stock.
</description>
<version> 1.2 </version>
*@

@model List<CleanBrilliantCompany.Models.Entity.IngredientSDM>

@{
    ViewData["Title"] = "Sustainable Resource Inventory";
}

<div class="card">
    <div class="card-header bg-success text-white">
        <h5>🌱 Sustainable Resource Inventory</h5>
        using CleanBrilliantCompany.Models.Entity;
    </div>

    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Resource Name</th>
                    <th>Quantity</th>
                    <th>Measurement Unit</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody id="inventoryTable">
                @foreach (var ingredient in Model)
                {
                    var status = ingredient.ReorderStatus ? "Low" : "Available";
                    var statusClass = ingredient.ReorderStatus ? "text-warning" : "text-success";

                    if (ingredient.Quantity == 0)
                    {
                        status = "Out of Stock";
                        statusClass = "text-danger";
                    }
                <tr>
                    <td>@ingredient.IngredientName</td>
                    <td>@ingredient.ThresholdQuantity</td>
                    <td>@ingredient.MeasurementUnit</td>
                    <td class="@statusClass">
                        <strong>
                            @(status == "Available" ? "✅ Available" :
                                                        status == "Low" ? "⚠️ Low" : "❌ Out of Stock")
                        </strong>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>

@{
    decimal totalCarbonBefore = 0;
    decimal totalCarbonAfter = 0;
    decimal overallReduction = 0;
    string overallReductionClass = "";
}
<div class="card mt-4">
    <div class="card-header bg-success text-white">
        <h5>🌱 Carbon Footprint Reduction</h5>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Category</th>
                    <th>Before (kg CO₂)</th>
                    <th>After (kg CO₂)</th>
                    <th>Reduction (%)</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.CarbonData is List<CleanBrilliantCompany.Models.Entity.CarbonFootprintRecord> carbonData)
                {
                    var groupedData = carbonData
                    .GroupBy(d => d.EntityId)
                    .Select(group =>
                    {
                        // Correctly find "Before" (Not Eco-Friendly) emissions.
                        var beforeEmission = group
                                    .Where(x => x.EcoStatus == "Not Eco-Friendly")
                                    .Select(x => x.CarbonEmission)
                                    .DefaultIfEmpty(0)
                                    .Sum();

                        // Correctly find "After" (Eco-Friendly) emissions
                        var afterEmission = group
                                    .Where(x => x.EcoStatus == "Eco-Friendly")
                                    .Select(x => x.CarbonEmission)
                                    .Sum();

                        decimal reductionPercentage = 0;

                        // Calculate reduction percentage.
                        if (beforeEmission != 0)
                        {
                            // Standard reduction calculation.
                            reductionPercentage = (decimal)((beforeEmission - afterEmission) / beforeEmission) * 100;
                        }
                        else
                        {
                            // If emission increased (or stayed the same)
                            // If after > 0, it's an increase (100% increase) -> -100% reduction.
                            reductionPercentage = (afterEmission > 0) ? -100 : 0;
                        }

                        return new
                        {
                            EntityID = group.Key,
                            BeforeEmission = beforeEmission,
                            AfterEmission = afterEmission,
                            ReductionPercentage = reductionPercentage,
                        };
                    }).ToList();

                    foreach (var item in groupedData)
                    {
                        totalCarbonBefore += (decimal)item.BeforeEmission;
                        totalCarbonAfter += (decimal)item.AfterEmission;

                        string reductionClass =
                        // Green for good reduction (greater than 50%)
                        item.ReductionPercentage > 50 ? "bg-success" :
                        // Gray for no reduction (0%)
                        item.ReductionPercentage == 0 ? "bg-secondary" :
                        // Yellow for moderate reduction (20% to 50%)
                        item.ReductionPercentage > 0 ? "bg-warning" :
                        // Red for negative reduction (any decrease / increase of CO2)
                        "bg-danger";

                        <tr>
                            <td>@item.EntityID</td>
                            <td>@item.BeforeEmission.ToString("F2") kg CO₂</td>
                            <td>@item.AfterEmission.ToString("F2") kg CO₂</td>
                            <td class="@reductionClass text-white"><strong>@item.ReductionPercentage.ToString("F2") %</strong>
                            </td>
                        </tr>
                    }
                }

                @{
                    // Log the values for debugging purposes.
                    Console.WriteLine($"Total Carbon Before: {totalCarbonBefore}");
                    Console.WriteLine($"Total Carbon After: {totalCarbonAfter}");

                    if (totalCarbonBefore > 0)
                    {
                        // Normal reduction calculation
                        overallReduction = ((totalCarbonBefore - totalCarbonAfter) / totalCarbonBefore) * 100;
                    }
                    else if (totalCarbonBefore == 0 && totalCarbonAfter > 0)
                    {
                        // If no emissions before, but there are emissions after, consider a 100% increase.
                        overallReduction = -100;
                    }
                    else if (totalCarbonBefore == 0 && totalCarbonAfter == 0)
                    {
                        // If no emissions before and after, no reduction.
                        overallReduction = 0;
                    }

                    // Log overall reduction for debugging.
                    Console.WriteLine($"Overall Reduction: {overallReduction}");

                    // Decide the overall reduction class based on the value.
                    overallReductionClass = overallReduction >= 50 ? "bg-success" : overallReduction >= 20 ?
                    "bg-warning" : "bg-danger";
                }
            </tbody>

            @* Progrss bar *@
            <div class="progess mt-3">
                <div class="progress-bar progress-bar-striped progress-bar-animated @overallReductionClass"
                    role="progressbar" style="width: @overallReduction%;" aria-valuenow="@overallReduction"
                    aria-valuemin="0" aria-valuemax="100">
                    @overallReduction.ToString("F2")% Reduction
                </div>
            </div>
        </table>
    </div>
</div>

@* Insert New Sustainable Resource Form *@
<h3 class="mt-4">Add New sustainable Resource</h3>

<form asp-action="ProcessResource" asp-controller="SustainableIngredients" method="post"
    class="border p-3 bg-light rounded">
    <div class="mb-3">
        <label for="IngredientName" class="form-label">Resource Name: </label>
        <input type="text" id="IngredientName" name="IngredientName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label for="ThresholdQuantity" class="form-label">Quantity:</label>
        <input type="number" id="ThresholdQuantity" name="ThresholdQuantity" class="form-control" required />
    </div>

    <div class="mb-3">
        <label for="MeasurementUnit" class="form-label">Measurement Unit:</label>
        <select id="MeasurementUnit" name="MeasurementUnit" class="form-select" required>
            <option value="">-- Select Unit --</option>
            <option value="kg">Kilograms (kg)</option>
            <option value="g">Grams (g)</option>
            <option value="l">Litres (l)</option>
            <option value="ml">Millilitres (ml)</option>
            <option value="pcs">Pieces (pcs)</option>
        </select>
    </div>

    <div class="mb-3">
        <label for="ProductId" class="form-label">Associated Product</label>
        <select id="ProductId" name="ProductId" class="form-select" required>
            <option value="">-- Select Product --</option>
            @foreach (var product in ViewBag.Products)
            {
                <option value="@product.Id">@product.ProductName</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Add Resource</button>
</form>


@* Alert Section *@
@{
    var lowStockItems = Model.Where(i => i.ReorderStatus || i.ThresholdQuantity == 0).ToList();
}

@if (lowStockItems.Any())
{
    <div class="alert alert-warning mt-4">
        <h4 class="alert-heading">⚠️ Inventory Alert!</h4>
        <p>The following items need attention:</p>

        <ul>
            @foreach (var ingredient in lowStockItems)
            {
                <li>
                    <strong>@ingredient.IngredientName</strong>: @ingredient.Quantity available
                    (Threshold: @ingredient.ThresholdQuantity) - @(ingredient.Quantity == 0 ? "🚨 Replenish Now!" :
                                (ingredient.Quantity < ingredient.ThresholdQuantity ? "📌 Consider reordering." : "✅ Stock is sufficient."))
        </li>
                }
        </ul>
    </div>
}