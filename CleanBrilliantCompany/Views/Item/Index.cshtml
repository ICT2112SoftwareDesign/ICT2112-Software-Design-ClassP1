@model List<Dictionary<string, object>>

<h2>Item List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Item ID</th>
            <th>Product ID</th>
            <th>Sale Price</th>
            <th>Batch Code</th>
            <th>Warehouse ID</th>
            <th>Status</th>
            <th>Reservation ID</th>
            <th>Order ID</th>
            <th>Transfer ID</th>
            <th>Return ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var itemInfo in Model)
        {
            <tr>
                <td>@itemInfo["ItemId"]</td>
                <td>@itemInfo["ProductId"]</td>
                <td>@itemInfo["SalePrice"]</td>
                <td>@itemInfo["BatchCode"]</td>
                <td>@itemInfo["WarehouseId"]</td>
                <td>@itemInfo["ItemStatus"]</td>
                <td>@(itemInfo.ContainsKey("ReservationId") ? itemInfo["ReservationId"] ?? "NULL" : "NULL")</td>
                <td>@(itemInfo.ContainsKey("OrderId") ? itemInfo["OrderId"] ?? "NULL" : "NULL")</td>
                <td>@(itemInfo.ContainsKey("TransferId") ? itemInfo["TransferId"] ?? "NULL" : "NULL")</td>
                <td>@(itemInfo.ContainsKey("ReturnId") ? itemInfo["ReturnId"] ?? "NULL" : "NULL")</td>
            </tr>
        }
    </tbody>
</table>

@* button to trigger model *@
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addItemModal">
    Add Item
</button>

@* modal *@
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addItemModalLabel">Add New Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="addItem">
                    <div class="mb-3">
                        <label for="productId" class="form-label">Product ID</label>
                        <input type="text" class="form-control" id="productId" name="productId" required>
                    </div>
                    <div class="mb-3">
                        <label for="salePrice" class="form-label">Sale Price</label>
                        <input type="number" class="form-control" id="salePrice" name="salePrice" required>
                    </div>
                    <div class="mb-3">
                        <label for="batchCode" class="form-label">Batch Code</label>
                        <input type="text" class="form-control" id="batchCode" name="batchCode" required>
                    </div>
                    <div class="mb-3">
                        <label for="warehouseId" class="form-label">Warehouse ID</label>
                        <input type="text" class="form-control" id="warehouseId" name="warehouseId" required>
                    </div>
                    <div class="mb-3">
                        <label for="itemStatus" class="form-label">Status</label>
                        <input type="text" class="form-control" id="itemStatus" name="itemStatus" required>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.getElementById("addItemForm").addEventListener("submit", function (event) {
        event.preventDefault();

        let newItem = {
            ItemId: document.getElementById("itemId").value,
            ProductId: document.getElementById("productId").value,
            SalePrice: document.getElementById("salePrice").value,
            BatchCode: document.getElementById("batchCode").value,
            WarehouseId: document.getElementById("warehouseId").value,
            ItemStatus: document.getElementById("itemStatus").value
        };

        console.log("New Item Added:", newItem); // Replace this with actual logic to update the table or send data to the server.

        // Close modal
        var modal = new bootstrap.Modal(document.getElementById('addItemModal'));
        modal.hide();

        // Clear form fields
        document.getElementById("addItemForm").reset();
    });
</script>
