    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Show success toast if success message exists
            let successMessage = "@TempData["SuccessMessage"]";
            if (successMessage.trim() !== "") {
                document.getElementById("successMessageText").innerText = successMessage;
                let toastElement = new bootstrap.Toast(document.getElementById("successToast"));
                toastElement.show();
            }

            // Show error toast if error message exists
            let errorMessage = "@TempData["ErrorMessage"]";
            if (errorMessage.trim() !== "") {
                document.getElementById("errorMessageText").innerText = errorMessage;
                let toastElement = new bootstrap.Toast(document.getElementById("errorToast"));
                toastElement.show();
            }
        });
    </script>



