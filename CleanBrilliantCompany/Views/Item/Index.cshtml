@* update item id & status model (to test for iItemUpdate) *@
<div class="modal fade" id="updateItemStatusModal" tabindex="-1" aria-labelledby="updateItemStatusModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateItemStatusModalLabel">Update Item Id & Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="updateItemStatus">
                    <input type="hidden" id="updateStatusItemId" name="itemId">
                    <div class="mb-3">
                        <label for="reservationId" class="form-label">Reservation Id</label>
                        <input type="text" class="form-control" id="reservationId" name="reservationId">
                    </div>

                    <div class="mb-3">
                        <label for="orderId" class="form-label">Order Id</label>
                        <input type="text" class="form-control" id="orderId" name="orderId">
                    </div>

                    <div class="mb-3">
                        <label for="orderId" class="form-label">Return Id</label>
                        <input type="text" class="form-control" id="returnId" name="returnId">
                    </div>

                    <div class="mb-3">
                        <label for="orderId" class="form-label">Transfer Id</label>
                        <input type="text" class="form-control" id="transferId" name="transferId">
                    </div>

                    <div class="mb-3">
                        <label for="itemStatus" class="form-label">Status</label>
                        <select class="form-control" id="itemStatus" name="status" required>
                            <option value="Available">Available</option>
                            <option value="Reserved">Reserved</option>
                            <option value="Sold">Sold</option>
                            <option value="Refunded">Refunded</option>
                        </select>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* popup messages *@
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1050; right: 20px; top: 20px;">
    <!-- Success Toast -->
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive"
        aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <strong>Success:</strong> <span id="successMessageText"></span>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <!-- Error Toast -->
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive"
        aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <strong>Error:</strong> <span id="errorMessageText"></span>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Show success toast if success message exists
        let successMessage = "@TempData["SuccessMessage"]";
        if (successMessage.trim() !== "") {
            document.getElementById("successMessageText").innerText = successMessage;
            let toastElement = new bootstrap.Toast(document.getElementById("successToast"));
            toastElement.show();
        }

        // Show error toast if error message exists
        let errorMessage = "@TempData["ErrorMessage"]";
        if (errorMessage.trim() !== "") {
            document.getElementById("errorMessageText").innerText = errorMessage;
            let toastElement = new bootstrap.Toast(document.getElementById("errorToast"));
            toastElement.show();
        }
    });
</script>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var updateModal = document.getElementById("updateItemModal");

        updateModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            var itemId = button.getAttribute("data-item-id");

            var hiddenInput = document.getElementById("updateItemId");
            hiddenInput.value = itemId;
            console.log(hiddenInput.value);
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        var updateModal = document.getElementById("updateItemStatusModal");

        updateModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            var itemId = button.getAttribute("data-updateitem-id");

            var hiddenInput = document.getElementById("updateStatusItemId");
            hiddenInput.value = itemId;

            console.log(hiddenInput.value);
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        var updateModal = document.getElementById("updateItemStatusModalOld");

        updateModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            var itemId = button.getAttribute("data-updateitemOld-id");

            var hiddenInput = document.getElementById("updateStatusItemIdOld");
            hiddenInput.value = itemId;

            console.log(hiddenInput.value);
        });
    });
</script>
