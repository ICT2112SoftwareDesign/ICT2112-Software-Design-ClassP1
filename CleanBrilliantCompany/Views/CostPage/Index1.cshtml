<!DOCTYPE html>
<html>
<head>
    <title>Cost Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* ✅ Make alerts section scrollable */
        #alertsContainer {
            max-height: 250px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h2>Cost Dashboard - @Model.Name</h2>
        <p>Start Date: @Model.StartDate.ToShortDateString()</p>
        <p>End Date: @Model.EndDate.ToShortDateString()</p>

        <!-- ✅ Manufacturers Dropdown (Accordion) -->
        <h3 class="mt-4">🏭 Manufacturers</h3>
        <div class="accordion" id="manufacturersAccordion">
            @foreach (var manufacturer in Model.GetAllManufacturers()) 
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading-@manufacturer.ManufacturerId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@manufacturer.ManufacturerId" aria-expanded="false" aria-controls="collapse-@manufacturer.ManufacturerId">
                            @manufacturer.CompanyName
                        </button>
                    </h2>
                    <div id="collapse-@manufacturer.ManufacturerId" class="accordion-collapse collapse" aria-labelledby="heading-@manufacturer.ManufacturerId" data-bs-parent="#manufacturersAccordion">
                        <div class="accordion-body">
                            <p><strong>Address:</strong> @manufacturer.Address</p>
                            <p><strong>Email:</strong> @manufacturer.Email</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ✅ Product Batches by Manufacturer (Dropdowns) -->
        <h3 class="mt-5">📦 Product Batches by Manufacturer</h3>
        <div class="accordion" id="batchesAccordion">
            @foreach (var manufacturer in Model.GetAllManufacturers()) 
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="batchHeading-@manufacturer.ManufacturerId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#batchCollapse-@manufacturer.ManufacturerId" aria-expanded="false" aria-controls="batchCollapse-@manufacturer.ManufacturerId">
                            @manufacturer.CompanyName
                        </button>
                    </h2>
                    <div id="batchCollapse-@manufacturer.ManufacturerId" class="accordion-collapse collapse" aria-labelledby="batchHeading-@manufacturer.ManufacturerId" data-bs-parent="#batchesAccordion">
                        <div class="accordion-body">
                            <ul class="list-group">
                                @foreach (var batch in Model.GetBatchesByManufacturer(manufacturer.ManufacturerId))
                                {
                                    <li class="list-group-item">
                                        <strong>Batch Code:</strong> @batch.BatchCode <br />
                                        <strong>Product ID:</strong> @batch.ProductId <br />
                                        <strong>Batch Price:</strong> @batch.BatchPrice <br />
                                        <strong>Batch Quantity:</strong> @batch.BatchQuantity <br />
                                        <strong>Expiry Date:</strong> @batch.ExpiryDate.ToShortDateString() <br />
                                        <strong>Receive Date:</strong> @batch.ReceiveDate.ToShortDateString() <br />
                                        <strong>Manufacture Date:</strong> @batch.ManufactureDate.ToShortDateString() <br />
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ✅ Alerts & Notifications Card -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h2>Alerts & Notifications</h2>
                        <div id="alertsContainer" class="mt-2"></div> <!-- Individual alerts go here -->
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h2>Supplier Comparison</h2>
                        <canvas id="supplierChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h2>Cost Visualization</h2>
                        <canvas id="costChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        // ✅ Fetch Cost Visualization Data
        fetch("/CostPage/GetCostVisualization")
            .then(response => response.json())
            .then(data => renderCostChart(data))
            .catch(error => console.error("Error fetching Cost Visualization:", error));

        // ✅ Fetch Supplier Comparison Data
        fetch("/CostPage/GetSupplierComparison")
            .then(response => response.json())
            .then(data => renderSupplierChart(data))
            .catch(error => console.error("Error fetching Supplier Comparison:", error));

        // ✅ Fetch Alerts & Notifications
        fetch("/CostPage/GetAlerts")
            .then(response => response.json())
            .then(data => {
                if (data.alerts && data.alerts.length > 0) {
                    displayAlerts(data.alerts);
                }
            })
            .catch(error => console.error("Error fetching Alerts:", error));
    });

    // ✅ Function to Display Alerts as Individual Boxes
    function displayAlerts(alerts) {
        const alertsContainer = document.getElementById("alertsContainer");
        alertsContainer.innerHTML = ""; // Clear previous alerts

        alerts.forEach(alert => {
            const alertDiv = document.createElement("div");
            alertDiv.className = "alert alert-danger alert-dismissible fade show";
            alertDiv.setAttribute("role", "alert");
            alertDiv.innerHTML = `
                <strong>⚠ Note:</strong> ${alert.message} <br>
                <small>Generated on ${new Date(alert.timestamp).toLocaleString()}</small>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            alertsContainer.appendChild(alertDiv);
        });
    }

    // ✅ Function to Render Cost Chart (Bar Chart)
    function renderCostChart(data) {
        const ctx = document.getElementById("costChart").getContext("2d");
        const labels = data.map(item => `Batch ${item.batchCode}`);
        const prices = data.map(item => item.batchPrice);

        new Chart(ctx, {
            type: "bar",
            data: {
                labels: labels,
                datasets: [{
                    label: "Batch Prices",
                    data: prices,
                    backgroundColor: "rgba(54, 162, 235, 0.6)",
                    borderColor: "rgba(54, 162, 235, 1)",
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
            }
        });
    }

    // ✅ Function to Render Supplier Chart (Pie Chart)
    function renderSupplierChart(data) {
        const ctx = document.getElementById("supplierChart").getContext("2d");
        const labels = data.map(item => item.manufacturerName);
        const batchCounts = data.map(item => item.batchCount);

        const backgroundColors = generateUniqueColors(labels.length);

        new Chart(ctx, {
            type: "pie",
            data: {
                labels: labels,
                datasets: [{
                    label: "Batches per Supplier",
                    data: batchCounts,
                    backgroundColor: backgroundColors,
                    borderColor: "#ffffff",
                    borderWidth: 1
                }]
            },
            options: { responsive: true }
        });
    }

    // ✅ Function to Generate Unique Colors
    function generateUniqueColors(count) {
        const colors = [];
        for (let i = 0; i < count; i++) {
            const color = `hsl(${(i * 360 / count)}, 70%, 50%)`;
            colors.push(color);
        }
        return colors;
    }
    </script>
</body>
</html>