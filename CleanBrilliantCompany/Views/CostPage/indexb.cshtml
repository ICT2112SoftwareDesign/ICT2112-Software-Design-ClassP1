    <style>
        /* ✅ Make alerts section scrollable */
        #alertsContainer {
            max-height: 250px;
            overflow-y: auto;
        }
    </style>
</head>

<body id="page-top">
    <!-- Page Wrapper -->
    <div id="wrapper">

