  function renderRecentProductBatchesChart(data) {
    console.log("[DEBUG] Received batch data:", data);
    if (!data || data.length === 0) {
      console.log("[DEBUG] No recent batch data available.");
      return;
    }
    const canvas = document.getElementById("recentBatchesProductChart");
    if (!canvas) {
      console.log("[DEBUG] Canvas element not found!");
      return;
    }
    const ctx = canvas.getContext("2d");
    if (window.recentProductBatchesChartInstance) {
      window.recentProductBatchesChartInstance.destroy();
    }
    const labels = data.map(batch => `Batch ${batch.batchCode}`);
    const prices = data.map(batch => batch.batchPrice);
    window.recentProductBatchesChartInstance = new Chart(ctx, {
      type: "line",
      data: {
        labels: labels,
        datasets: [{
          label: "Batch Price ($)",
          data: prices,
          backgroundColor: "rgba(54, 162, 235, 0.6)",
          borderColor: "rgba(54, 162, 235, 1)",
          borderWidth: 2,
          fill: false
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: { 
            beginAtZero: true,
            title: { display: true, text: "Batch Price ($)" }
          },
          x: { title: { display: true, text: "Recent Batches" } }
        }
      }
    });
  }

