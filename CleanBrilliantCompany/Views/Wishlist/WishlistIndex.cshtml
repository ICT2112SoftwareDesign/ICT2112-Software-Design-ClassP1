@model Dictionary<int, Dictionary<string, object>>
@{
    ViewData["Title"] = ViewBag.CustomerName + "'s Wishlist";
}


<div class="container">
    <h1 class="mb-4">@ViewBag.CustomerName's Wishlist</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Your wishlist is empty. <a href="@Url.Action("GetAllProducts", "CustomerPage")">Browse products</a> to add items to your wishlist.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var productId = item.Key;
                var product = item.Value;

                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (product.ContainsKey("ImageURL") && product["ImageURL"] != null)
                        {
                            <img src="~/img/placeholderimg.png" class="card-img-top" alt="@product["ProductName"]">
                        }
                        else
                        {
                            <img src="~/img/placeholderimg.png" class="card-img-top" alt="No Image">
                        }
                        <div class="card-body">
                            <h5 class="card-title">@product["ProductName"]</h5>
                            <p class="card-text text-primary font-weight-bold">$@product["CostPrice"]</p>
                            
                            <div class="d-flex justify-content-between mt-3">
                                <form asp-controller="CustomerPage" asp-action="removeFromWishlist" method="post">
                                    <input type="hidden" name="productId" value="@productId" />
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="fas fa-heart-broken"></i> Remove
                                    </button>
                                </form>
                                
                                <form asp-controller="CustomerPage" asp-action="addToCart" method="post">
                                    <input type="hidden" name="productId" value="@productId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-shopping-cart"></i> Add to Cart
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

