<!DOCTYPE html>
<html lang="en">

@model CleanBrilliantCompany.Models.ShippingAgent_RDM

@{
    ViewData["Title"] = "Edit Shipping Agent";
}

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <!-- Custom fonts for this template-->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Include the sidebar -->
        @await Html.PartialAsync("~/Views/Staff/staff-sidebar.cshtml")

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">
                <!-- Begin Page Content -->
                <div class="container-fluid  mt-4">


                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Edit Shipping Agent</h1>
                    </div>
                    <!-- Edit Form -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Shipping Agent Details</h6>
                        </div>
                        <div class="card-body">
                            <form method="post" action="@Url.Action("Update", "ShippingAgent", new { id = Model.ShippingAgentId })">
                                <input type="hidden" asp-for="ShippingAgentId" />
                                <div class="form-group">
                                    <label asp-for="ShippingAgentCompany">Company Name</label>
                                    <input asp-for="ShippingAgentCompany" class="form-control"
                                        placeholder="Enter company name" maxlength="124" required
                                        oninput="showCharLimit(this, 124)" id="companyNameInput" />
                                    <span asp-validation-for="ShippingAgentCompany" class="text-danger"></span>
                                    <small id="charLimitMessage" class="form-text text-muted"
                                        style="display: none;">Maximum 124 characters</small>
                                </div>
                                <div class="form-group">
                                    <label asp-for="ShippingMethod">Shipping Method</label>
                                    <select required asp-for="ShippingMethod" class="form-control">
                                        <option value="Air">Air</option>
                                        <option value="Truck">Truck</option>
                                    </select>
                                    <span asp-validation-for="ShippingMethod" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="ServiceType">Service Type</label>
                                    <select required asp-for="ServiceType" class="form-control">
                                        <option value="1 Day">1 Day</option>
                                        <option value="3 Days">3 Days</option>
                                        <option value="7 Days">7 Days</option>
                                    </select>
                                    <span asp-validation-for="ServiceType" class="text-danger"></span>
                                </div>
                                <div class="form-group mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save mr-1"></i> Save Changes
                                    </button>
                                    <a href="/staff/shippingagent" class="btn btn-secondary ml-2">
                                        <i class="fas fa-times mr-1"></i> Cancel
                                    </a>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>

            </div>
            <!-- /.container-fluid -->

            <!-- Initialize tooltips -->

            <script>

                function showCharLimit(input, maxLength) {
                    const messageElement = document.getElementById('charLimitMessage');
                    const remainingChars = maxLength - input.value.length;

                    if (remainingChars <= 10) {
                        messageElement.style.display = 'block';

                        // Optional: Change the message to show characters remaining
                        if (remainingChars === 0) {
                            messageElement.innerHTML = 'Maximum character limit reached';
                            messageElement.classList.add('text-danger');
                            messageElement.classList.remove('text-muted');
                        } else {
                            messageElement.innerHTML = `${remainingChars} characters remaining`;
                            messageElement.classList.add('text-muted');
                            messageElement.classList.remove('text-danger');
                        }
                    } else {
                        messageElement.style.display = 'none';
                    }
                }

                // Initialize on page load
                document.addEventListener('DOMContentLoaded', function () {
                    const companyInput = document.getElementById('companyNameInput');
                    if (companyInput) {
                        showCharLimit(companyInput, 124);
                    }
                });

            </script>
        </div>
        <!-- End of Main Content -->


    </div>
    <!-- End of Content Wrapper -->

    <!-- Include the footer -->
    @await Html.PartialAsync("staff-footer")

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="js/demo/chart-area-demo.js"></script>
    <script src="js/demo/chart-pie-demo.js"></script>

</body>

</html>