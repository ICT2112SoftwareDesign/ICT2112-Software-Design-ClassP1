<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>CLEAN BRILLIANT COMPANY - PROFILE</title>

    <link href="vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<div class="container mt-5">
@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}
    <!-- Profile Header -->
    <div class="profile-header mb-4">
        <h3 class="font-weight-bold text-white">Orders/Purchases: </h3>
    </div>

    <!-- Four smaller cards in a row -->
    <div class="row mb-4">
        <!-- To Pay -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ViewCart" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-wallet" style="margin-right: 5px;"></i>To Pay</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- To Ship -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ToShip" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-box" style="margin-right: 5px;"></i>To Ship</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- To Receive -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ToReceive" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-truck" style="margin-right: 5px;"></i>To Receive</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Completed -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="Completed" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-check" style="margin-right: 5px;"></i>Completed</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="card p-4" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
        <h4 class="card-title font-weight-bold">Change Password</h4>
        <form method="post" asp-action="UpdateCustomerDetails">
            <div class="form-group row">
                <label for="username" class="col-sm-3 col-form-label">Password</label>
                <div class="col-sm-6 d-flex align-items-center">
                    <input type="password" class="form-control" id="password" maxlength="10" name="password" value="@ViewBag.Password" disabled />
                    <i class="fas fa-chevron-right" style="margin-left: 18px;"></i>
                </div>
            </div>
        </form>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body">
                    <form method="post" asp-action="updatePassword">
                        <div class="form-group">
                            <label for="newPassword">New Password</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required />
                        </div>
                        <div class="form-group">
                            <label for="confirmPassword">Confirm New Password</label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required />
                        </div>
                        <!-- Modal Footer -->
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-warning">Update Password</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <br>
    <!-- Profile Details inside a card -->
    <div class="card p-4">
        <h4 class="card-title font-weight-bold">Edit Profile Details</h4>
        <form method="post" asp-action="updateCustomerDetails">
            <div class="form-group row">
                <label for="username" class="col-sm-3 col-form-label">Username</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" id="username" name="username" value="@ViewBag.Username" />
                </div>
            </div>

            <div class="form-group row">
                <label for="email" class="col-sm-3 col-form-label">Email</label>
                <div class="col-sm-6">
                    <input type="email" class="form-control" id="email" name="email" value="@ViewBag.Email" />
                </div>
            </div>
            <div class="form-group row">
                <label for="address" class="col-sm-3 col-form-label">Address</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" id="address" name="address" value="@ViewBag.CustomerAddress" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-12 text-center">
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </div>
             <!-- <div class="form-group row">
                <div class="col-sm-12 text-center">
                    <button type="submit" class="btn btn-danger">Delete Account</button>
                </div>
            </div> -->
        </form>
    </div>
</div>

<!-- Bootstrap core JavaScript-->
<script src="vendor/jquery/jquery.min.js"></script>
<script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

<!-- Core plugin JavaScript-->
<script src="vendor/jquery-easing/jquery.easing.min.js"></script>

</body>
</html>
