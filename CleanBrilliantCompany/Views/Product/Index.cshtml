                    <!-- Product List -->
                    @* <h3>Product List</h3> *@

                    @if (Model != null && Model.Any())
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product ID</th>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Cost Price ($)</th>
                                    <th>Manufacturer ID</th>
                                    <th>Weight (kg)</th>
                                    <th>Quantity</th>
                                    <th>Volume</th>
                                    <th>Toxicity (%)</th>
                                    <th>Carbon Footprint</th>
                                    <th>Product State</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var productInfo in Model)
                                {
                                    <tr class="product-item">
                                        <td>@productInfo["ProductId"]</td>
                                        <td class="product-name">@productInfo["ProductName"]</td>
                                        <td class="product-category">@productInfo["ProductCategory"]</td>
                                        <td>@productInfo["ProductCost"]</td>
                                        @* <td>@productInfo["ManufacturerId"]</td> *@
                                        <td>
                                            @{
                                                var manufacturerId = Convert.ToInt32(productInfo["ManufacturerId"]);
                                                var manufacturerName = ((List<Dictionary<string, object>>)ViewBag.Manufacturers)
                                                    .FirstOrDefault(m => Convert.ToInt32(m["ManufacturerId"]) == manufacturerId)?["CompanyName"] ?? "Unknown";
                                            }
                                            @manufacturerName
                                        </td>
                                        <td>@productInfo["ProductWeight"]</td>
                                        <td>@productInfo["Quantity"]</td>
                                        <td>@productInfo["Volume"]</td>
                                        <td>@productInfo["ToxicityPercentage"]</td>
                                        <td>@productInfo["CarbonFootprint"]</td>
                                        @* <td>@productInfo["ProductState"]</td> *@
                                        <td>@(productInfo["ProductState"].ToString() == "0" ? "Solid" : "Liquid")</td>
                                        <td>
                                            <button type="button" class="btn btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#updateProductModal"
                                                data-product-id="@productInfo["ProductId"]"
                                                data-product-name="@productInfo["ProductName"]"
                                                data-product-category="@productInfo["ProductCategory"]"
                                                data-product-cost="@productInfo["ProductCost"]"
                                                data-manufacturer-id="@productInfo["ManufacturerId"]"
                                                data-product-weight="@productInfo["ProductWeight"]"
                                                data-quantity="@productInfo["Quantity"]"
                                                data-volume="@productInfo["Volume"]"
                                                data-toxicity="@productInfo["ToxicityPercentage"]"
                                                data-carbon="@productInfo["CarbonFootprint"]"
                                                data-state="@productInfo["ProductState"]">
                                                Update
                                            </button>
                                        </td>
                                        <td>
                                            @* <form method="post" asp-action="DeleteProduct" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                <input type="hidden" name="productId" value="@productInfo["ProductId"]" />
                                                <button type="submit" class="btn btn-danger">Delete</button>
                                            </form> *@
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No products available.</p>
                    }

