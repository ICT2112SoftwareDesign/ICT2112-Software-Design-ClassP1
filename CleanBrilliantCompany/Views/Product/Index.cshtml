                                        </div>

                                        <div class="mb-3">
                                            <label for="modalToxicity" class="form-label">Toxicity Percentage</label>
                                            <input type="number" class="form-control" id="modalToxicity" name="toxicityPercentage" required />
                                        </div>

                                        <div class="mb-3">
                                            <label for="modalCarbon" class="form-label">Carbon Footprint</label>
                                            <input type="number" class="form-control" id="modalCarbon" name="carbonFootprint" required />
                                        </div>

                                        <div class="mb-3">
                                            <label for="isLiquid" class="form-label">Product State</label>
                                            <select class="form-control" name="isLiquid" id="isLiquid" required>
                                                <option value="true">Liquid</option>
                                                <option value="false">Solid</option>
                                            </select>
                                        </div>

                                        @* <div class="mb-3">
                                            <label for="modalProductState" class="form-label">Product State</label>
                                            <input type="text" class="form-control" id="modalProductState" name="productState" required />
                                        </div> *@

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Save Product</button>
                                        </div>

                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

            </div>
