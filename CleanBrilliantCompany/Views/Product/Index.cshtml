                <!-- Content goes here -->
                <!-- === Product List === -->
                <!-- Test Product Fectch -->
                <form method="post" asp-action="FetchProduct">
                    <h3>Fetch Product</h3>
                    <label>Enter Product ID:</label>
                    <input type="number" name="productId" required />
                    <button type="submit">Fetch Product</button>
                </form>

                <!-- Test ProductManufecturer Fetch -->
                <form method="post" asp-action="FetchProductManufecturer">
                    <h3>Fetch Manufacturer</h3>
                    <label>Enter Manufacturer ID:</label>
                    <input type="number" name="manufacturerId" required />
                    <button type="submit">Fetch Manufacturer</button>
                </form>

                <!-- Simulate Reorder Request -->
                <form method="post" asp-action="ReorderRequest">
                    <button type="submit">Reorder Request Simulation</button>
                </form>

                <!-- Button to trigger Create Product modal -->
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createProductModal">
                    + Add Product
                </button>

                <!-- Modal for Create Product -->
                <div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title" id="createProductModalLabel">Create New Product</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <form method="post" asp-action="CreateProduct">
                                    <div class="mb-3">
                                        <label for="createProductName" class="form-label">Product Name</label>
                                        <input type="text" class="form-control" id="createProductName" name="productName" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="createProductCategory" class="form-label">Category</label>
                                        <input type="text" class="form-control" id="createProductCategory" name="productCategory" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="createProductCost" class="form-label">Cost Price</label>
                                        <input type="number" step="0.01" class="form-control" id="createProductCost" name="productCost" required />
                                    </div>

                                    @* <div class="mb-3">
                                        <label for="createManufacturerId" class="form-label">Manufacturer ID</label>
                                        <input type="number" class="form-control" id="createManufacturerId" name="manufacturerId" required />
                                    </div> *@

                                    <div class="mb-3">
                                        <label for="modalManufacturerId" class="form-label">Manufacturer</label>
                                        <select class="form-control" name="manufacturerId" id="modalManufacturerId" required>
                                            <option value="">Select Manufacturer</option>
                                            @foreach (var manufacturer in ((List<Dictionary<string, object>>)ViewBag.Manufacturers).Select(m => new
                                            {
                                                Id = m["ManufacturerId"],
                                                Name = m["CompanyName"]
                                            }))
                                            {
                                                <option value="@manufacturer.Id">@manufacturer.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label for="createProductWeight" class="form-label">Weight (kg)</label>
                                        <input type="number" step="0.01" class="form-control" id="createProductWeight" name="weight" required />
                                    </div>

                                    @* <div class="mb-3">
                                        <label for="createQuantity" class="form-label">Quantity</label>
                                        <input type="number" class="form-control" id="createQuantity" name="quantity" required />
                                    </div> *@

                                    <div class="mb-3">
                                        <label for="createVolume" class="form-label">Volume</label>
                                        <input type="number" class="form-control" id="createVolume" name="volume" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="createToxicity" class="form-label">Toxicity Percentage</label>
                                        <input type="number" class="form-control" id="createToxicity" name="toxicityPercentage" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="createCarbon" class="form-label">Carbon Footprint</label>
                                        <input type="number" class="form-control" id="createCarbon" name="carbonFootprint" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="isLiquid" class="form-label">Product State</label>
                                        <select class="form-control" name="isLiquid" id="isLiquid" required>
                                            <option value="true">Liquid</option>
                                            <option value="false">Solid</option>
                                        </select>
                                    </div>

                                    @* <div class="mb-3">
                                        <label for="createProductState" class="form-label">Product State</label>
                                        <input type="text" class="form-control" id="createProductState" name="productState" required />
                                    </div> *@

                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-success">Create Product</button>
                                    </div>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Go to Product Batch Listings Link -->
                <a asp-controller="Product" asp-action="displayProductBatch" class="btn btn-primary">Go to Product Batch Listings</a>

                <!-- Search input for filtering the product list -->
                <h3>Search Products</h3>
                <label for="searchInput">Search by Product Name or Category:</label>
                <input type="text" id="searchInput" onkeyup="filterProducts()" placeholder="Search..." />

                <!-- Product List -->
                <h3>Product List</h3>

                @if (Model != null && Model.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Cost Price ($)</th>
                                <th>Manufacturer ID</th>
                                <th>Weight (kg)</th>
                                <th>Quantity</th>
                                <th>Volume</th>
                                <th>Toxicity (%)</th>
                                <th>Carbon Footprint</th>
                                <th>Product State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var productInfo in Model)
                            {
                                <tr class="product-item">
                                    <td>@productInfo["ProductId"]</td>
                                    <td class="product-name">@productInfo["ProductName"]</td>
                                    <td class="product-category">@productInfo["ProductCategory"]</td>
                                    <td>@productInfo["ProductCost"]</td>
                                    <td>@productInfo["ManufacturerId"]</td>
                                    <td>@productInfo["ProductWeight"]</td>
                                    <td>@productInfo["Quantity"]</td>
                                    <td>@productInfo["Volume"]</td>
                                    <td>@productInfo["ToxicityPercentage"]</td>
                                    <td>@productInfo["CarbonFootprint"]</td>
                                    <td>@productInfo["ProductState"]</td>
                                    <td>
                                        <button type="button" class="btn btn-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#updateProductModal"
                                            data-product-id="@productInfo["ProductId"]"
                                            data-product-name="@productInfo["ProductName"]"
                                            data-product-category="@productInfo["ProductCategory"]"
                                            data-product-cost="@productInfo["ProductCost"]"
                                            data-manufacturer-id="@productInfo["ManufacturerId"]"
                                            data-product-weight="@productInfo["ProductWeight"]"
                                            data-quantity="@productInfo["Quantity"]"
                                            data-volume="@productInfo["Volume"]"
                                            data-toxicity="@productInfo["ToxicityPercentage"]"
                                            data-carbon="@productInfo["CarbonFootprint"]"
                                            data-state="@productInfo["ProductState"]">
                                            Update
                                        </button>
                                    </td>
                                    <td>
                                        <form method="post" asp-action="DeleteProduct" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <input type="hidden" name="productId" value="@productInfo["ProductId"]" />
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No products available.</p>
                }

                <div class="modal fade" id="updateProductModal" tabindex="-1" aria-labelledby="updateItemStatusModalLabelOld" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title" id="updateProductModalLabel">Update Product</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <form method="post" asp-action="UpdateProduct">

                                    <!-- Hidden field for Product ID -->
                                    <input type="hidden" id="modalProductId" name="productId" />

                                    <div class="mb-3">
                                        <label for="modalProductName" class="form-label">Product Name</label>
                                        <input type="text" class="form-control" id="modalProductName" name="productName" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="modalProductCategory" class="form-label">Category</label>
                                        <input type="text" class="form-control" id="modalProductCategory" name="productCategory" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="modalProductCost" class="form-label">Cost Price</label>
                                        <input type="number" step="0.01" class="form-control" id="modalProductCost" name="productCost" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="modalManufacturerId" class="form-label">Manufacturer ID</label>
                                        <input type="number" class="form-control" id="modalManufacturerId" name="manufacturerId" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="modalProductWeight" class="form-label">Weight (kg)</label>
                                        <input type="number" step="0.01" class="form-control" id="modalProductWeight" name="productWeight" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="modalQuantity" class="form-label">Quantity</label>
                                        <input type="number" class="form-control" id="modalQuantity" name="quantity" required />
