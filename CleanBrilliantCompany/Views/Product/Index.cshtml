                <div>
                    <div class="row mb-3 mt-5">
                        @* Add Button *@
                        <div class="col-auto">
                            <!-- Button to trigger Create Product modal -->
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProductModal">
                                + Add Product
                            </button>
                        </div>

                        <!-- Modal for Create Product -->
                        <div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h5 class="modal-title" id="createProductModalLabel">Create New Product</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <form method="post" asp-action="CreateProduct">
                                            <div class="mb-3">
                                                <label for="createProductName" class="form-label">Product Name</label>
                                                <input type="text" class="form-control" id="createProductName" name="productName" required />
                                            </div>

                                            @* <div class="mb-3">
                                                <label for="createProductCategory" class="form-label">Category</label>
                                                <input type="text" class="form-control" id="createProductCategory" name="productCategory" required />
                                            </div> *@

                                            <div class="mb-3">
                                                <label for="modalProductCategory" class="form-label">Category</label>
                                                <select class="form-control" id="modalProductCategory" name="productCategory" required>
                                                    <option value=""> Select Category </option>
                                                    <option value="Personal Care">Personal Care</option>
                                                    <option value="Detergent">Detergent</option>
                                                    <option value="Household">Household</option>
                                                    <option value="Packaging">Packaging</option>
                                                    <option value="Kitchen">Kitchen</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label for="createProductCost" class="form-label">Cost Price</label>
                                                <input type="number" step="0.01" class="form-control" id="createProductCost" name="productCost" required />
                                            </div>

                                            <div class="mb-3">
                                                <label for="modalManufacturerId" class="form-label">Manufacturer</label>
                                                <select class="form-control" name="manufacturerId" id="modalManufacturerId" required>
                                                    <option value="">Select Manufacturer</option>
                                                    @foreach (var manufacturer in ((List<Dictionary<string, object>>)ViewBag.Manufacturers).Select(m => new
                                                    {
                                                        Id = m["ManufacturerId"],
                                                        Name = m["CompanyName"]
                                                    }))
                                                    {
                                                        <option value="@manufacturer.Id">@manufacturer.Name</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label for="createProductWeight" class="form-label">Weight (kg)</label>
                                                <input type="number" step="0.01" class="form-control" id="createProductWeight" name="weight" required />
                                            </div>

                                            <div class="mb-3">
                                                <label for="createVolume" class="form-label">Volume</label>
                                                <input type="number" class="form-control" id="createVolume" name="volume" required />
                                            </div>

                                            <div class="mb-3">
                                                <label for="createToxicity" class="form-label">Toxicity Percentage</label>
                                                <input type="number" class="form-control" id="createToxicity" name="toxicityPercentage" required />
                                            </div>

                                            <div class="mb-3">
                                                <label for="createCarbon" class="form-label">Carbon Footprint</label>
                                                <input type="number" class="form-control" id="createCarbon" name="carbonFootprint" required />
                                            </div>

                                            <div class="mb-3">
                                                <label for="isLiquid" class="form-label">Product State</label>
                                                <select class="form-control" name="isLiquid" id="isLiquid" required>
                                                    <option value="true">Liquid</option>
                                                    <option value="false">Solid</option>
                                                </select>
                                            </div>

