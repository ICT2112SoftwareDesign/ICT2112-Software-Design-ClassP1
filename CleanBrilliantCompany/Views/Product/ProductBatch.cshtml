@model List<Dictionary<string, object>>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Product Batch Listings</title>
</head>
<body>
    
    <h2>Product Batch Listings</h2>
    <!-- Form to Enter Product ID -->
    <form method="post" asp-action="FetchBatch">
        <h3>Fetch Product Batch</h3>
        <label>Product Batch Code:</label>
        <input type="number" name="batchCode" required />
        <button type="submit">Fetch Product</button>
    </form>

    <form method="post" asp-action="FetchBatchStockHistoryByCode">
        <h3>Fetch Batch Stock History</h3>
        <label>Product Batch Code:</label>
        <input type="number" name="batchCode" required />
        <button type="submit">Fetch Batch History</button>
    </form>

    <form method="post" asp-action="FetchBatchStockHistoryByDate">
        <h3>Fetch Batch Stock History</h3>
        <label>Product Batch Code:</label>
        <input type="date" name="stockTakeDate" required />
        <button type="submit">Fetch Batch History (yyyy-MM-dd)</button>
    </form>

    <!-- Button to trigger Create Product Batch modal -->
    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#createBatchModal">
        + Add Product Batch
    </button>

    <!-- Modal for Create Product Batch -->
    <div class="modal fade" id="createBatchModal" tabindex="-1" aria-labelledby="createBatchModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="createBatchModalLabel">Add New Product Batch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form method="post" asp-action="CreateProductBatch">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label>Product ID</label>
                            <input type="number" name="productId" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Expiry Date</label>
                            <input type="date" name="expiryDate" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Receive Date</label>
                            <input type="date" name="receiveDate" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Manufacture Date</label>
                            <input type="date" name="manufactureDate" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Quantity</label>
                            <input type="number" name="quantity" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Batch Cost</label>
                            <input type="number" name="batchCost" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Batch</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table border="1">
            <tr>
                <th>Batch Code</th>
                <th>Product ID</th>
                <th>Expiry Date</th>
                <th>Receive Date</th>
                <th>Manufacture Date</th>
                <th>Quantity</th>
                <th>Batch Cost</th>
            </tr>
            @foreach (var batchInfo in Model)
            {
                <tr>
                    <td>@batchInfo["BatchCode"]</td>
                    <td>@batchInfo["ProductId"]</td>
                    <td>@DateTime.Parse(batchInfo["ExpiryDate"].ToString()).ToString("dd/MM/yyyy")</td>
                    <td>@DateTime.Parse(batchInfo["ReceiveDate"].ToString()).ToString("dd/MM/yyyy")</td>
                    <td>@DateTime.Parse(batchInfo["ManufactureDate"].ToString()).ToString("dd/MM/yyyy")</td>
                    <td>@batchInfo["Quantity"]</td>
                    <td>@batchInfo["BatchCost"]</td>
                </tr>
            }
        </table>
    }
    else
    {
        <p>No product batches available.</p>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

