@model CleanBrilliantCompany.Models.ViewModel.BatchDetailsViewModel

<h2>Product Batch Listings</h2>

@if (Model.ProductBatches != null && Model.ProductBatches.Any())
{
    <table border="1">
        <tr>
            <th>Batch Code</th>
            <th>Product ID</th>
            <th>Expiry Date</th>
            <th>Receive Date</th>
            <th>Manufacture Date</th>
            <th>Quantity</th>
            <th>Batch Cost</th>
        </tr>
        @foreach (var batch in Model.ProductBatches)
        {
            <tr>
                <td>@batch.BatchCode</td>
                <td>@batch.ProductId</td>
                <td>@batch.ExpiryDate.ToString("yyyy-MM-dd")</td>
                <td>@batch.ReceiveDate.ToString("yyyy-MM-dd")</td>
                <td>@batch.ManufactureDate.ToString("yyyy-MM-dd")</td>
                <td>@batch.Quantity</td>
                <td>$@batch.BatchCost</td>
            </tr>

            <!-- Display Stock History for this Batch -->
            @if (Model.StockHistory != null && Model.StockHistory.Any(s => s.BatchCode == batch.BatchCode))
            {
                <tr>
                    <td colspan="7">
                        <strong>Stock History:</strong>
                        <table border="1">
                            <tr>
                                <th>Stock ID</th>
                                <th>Stock Check Date</th>
                                <th>Quantity</th>
                                <th>Time Recorded</th>
                            </tr>
                            @foreach (var stock in Model.StockHistory.Where(s => s.BatchCode == batch.BatchCode))
                            {
                                <tr>
                                    <td>@stock.StockId</td>
                                    <td>@stock.StockCheckDate.ToString("yyyy-MM-dd")</td>
                                    <td>@stock.Quantity</td>
                                    <td>@stock.TimeRecorded.ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
            else
            {
                <p>No stock history available.</p>
            }
        }
    </table>
}
else
{
    <p>No product batches available.</p>
}
