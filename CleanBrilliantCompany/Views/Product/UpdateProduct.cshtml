@model CleanBrilliantCompany.Models.Entity.Product

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Update Product</title>
</head>
<body>
    <h2>Update Product</h2>

    <!-- Form to Update Product -->
    <form method="post" asp-action="UpdateProduct" asp-route-productId="@Model.ProductId">
        <h3>Update Product Details</h3>

        <label for="ProductName">Product Name:</label>
        <input type="text" id="ProductName" name="ProductName" value="@Model.ProductName" required /><br>

        <label for="ProductCategory">Category:</label>
        <input type="text" id="ProductCategory" name="ProductCategory" value="@Model.ProductCategory" required /><br>

        <label for="ProductCost">Cost Price:</label>
        <input type="number" id="ProductCost" name="ProductCost" value="@Model.ProductCost" step="0.01" required /><br>

        <label for="ManufacturerId">Manufacturer ID:</label>
        <input type="number" id="ManufacturerId" name="ManufacturerId" value="@Model.ManufacturerId" required /><br>

        <label for="ProductWeight">Weight (kg):</label>
        <input type="number" id="ProductWeight" name="ProductWeight" value="@Model.ProductWeight" step="0.01" required /><br>

        <label for="Quantity">Quantity:</label>
        <input type="number" id="Quantity" name="Quantity" value="@Model.Quantity" required /><br>

        <label for="Volume">Volume:</label>
        <input type="number" id="Volume" name="Volume" value="@Model.Volume" required /><br>

        <label for="ToxicityPercentage">Toxicity Percentage:</label>
        <input type="number" id="ToxicityPercentage" name="ToxicityPercentage" value="@Model.ToxicityPercentage" step="0.01" required /><br>

        <label for="CarbonFootprint">Carbon Footprint:</label>
        <input type="number" id="CarbonFootprint" name="CarbonFootprint" value="@Model.CarbonFootprint" required /><br>

        <label for="ProductState">Product State:</label>
        <input type="text" id="ProductState" name="ProductState" value="@Model.ProductState" required /><br>

        <button type="submit">Update Product</button>
    </form>

    <br />
    <a href="@Url.Action("Index", "Product")">Back to Product List</a>
</body>
</html>
