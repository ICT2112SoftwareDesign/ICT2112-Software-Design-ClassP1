@model List<Dictionary<string, object>>

<!DOCTYPE html>
<html>
<head>
    <title>Product List</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        .search-container {
            text-align: center;
            margin: 20px 0;
        }
        .search-container input, .search-container select {
            padding: 8px;
            margin-right: 10px;
            font-size: 16px;
        }
        .product-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            padding: 20px;
        }
        .product-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            transition: transform 0.3s;
        }
        .product-card:hover {
            transform: scale(1.02);
        }
        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 5px;
        }
        .product-title {
            font-size: 18px;
            font-weight: bold;
            margin: 10px 0;
        }
        .product-price {
            color: #28a745;
            font-size: 16px;
            margin-bottom: 10px;
        }
        .btn {
            display: inline-block;
            padding: 8px 12px;
            margin: 5px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            text-decoration: none;
            font-size: 14px;
        }
        .btn-cart {
            background: #007bff;
            color: white;
        }
        .btn-wishlist {
            background: #ff4757;
            color: white;
        }
        .product-details {
            display: none;
            margin-top: 10px;
            text-align: left;
        }
    </style>
</head>
<body>
    <h2 style="text-align:center;">Product List</h2>
    <div class="search-container">
        <form method="get" action="@Url.Action("GetAllProducts", "CustomerPage")">
            <input type="text" name="query" id="search-bar" placeholder="Search products by name...">
            <select name="filters" id="category-dropdown">
                <option value="All">All Categories</option>
                @foreach (var product in Model.Select(p => p["Category"]).Distinct())
                {
                    <option value="@product">@product</option>
                }
            </select>
            <select name="sortOrder" id="sort-dropdown">
                <option value="asc">Sort by Price: Low to High</option>
                <option value="desc">Sort by Price: High to Low</option>
            </select>
            <button type="submit">Search</button>
        </form>
    </div>
    <div class="product-container">
        @foreach (var product in Model)
        {
            <div class="product-card" data-category="@product["Category"]">
                <img src="~/img/placeholderimg.png" alt="Product Image">
                <div class="product-title">@product["ProductName"]</div>
                <div class="product-price">$@product["CostPrice"]</div>
                <form asp-controller="CustomerPage" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@product["ProductId"]" />
                    <input type="number" name="quantity" value="1" min="1" class="form-control mb-2" />
                    <button class="btn btn-cart">Add to Cart</button>
                </form>
                <form asp-controller="CustomerPage" asp-action="AddToWishlist" method="post" class="d-inline">
                    <input type="hidden" name="productId" value="@product["ProductId"]" />
                    <button type="submit" class="btn btn-wishlist">Add to Wishlist</button>
                </form>
                <a class="nav-link text-dark" asp-controller="CustomerPage" asp-action="ProductDetail" asp-route-productId="@product["ProductId"]">View Details</a>
                <form method="get" asp-action="ViewReviewsByProduct" asp-controller="CustomerPage">
                    <input type="hidden" name="productId" value="@product["ProductId"]" />
                    <button type="submit" class="btn btn-sm btn-info mt-2">View Reviews</button>
                </form>
                <div id="details-@product["ProductId"]" class="product-details">
                    <p><strong>Category:</strong> @product["Category"]</p>
                    <p><strong>Manufacturer ID:</strong> @product["ManufacturerId"]</p>
                    <p><strong>Package:</strong> @product["Package"]</p>
                    <p><strong>Weight:</strong> @product["Weight"]</p>
                    <p><strong>Toxicity %:</strong> @product["ToxicityPercentage"]</p>
                    <p><strong>Quantity:</strong> @product["Quantity"]</p>
                    <p><strong>Carbon Footprint:</strong> @product["CarbonFootprint"]</p>
                    <p><strong>Volume:</strong> @product["Volume"]</p>
                </div>
            </div>
        }
    </div>
</body>
</html>