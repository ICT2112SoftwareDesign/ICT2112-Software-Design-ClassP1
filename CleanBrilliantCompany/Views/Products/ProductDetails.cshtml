@model Dictionary<string, object>

<!DOCTYPE html>
<html>
<head>
    <title>Product Detail</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f8f9fa;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .product-image {
            width: 100%;
            max-height: 300px;
            object-fit: cover;
            border-radius: 10px;
        }
        .product-details {
            text-align: left;
            margin-top: 20px;
        }
        .review-section {
            margin-top: 40px;
            padding: 20px;
            background: #f1f1f1;
            border-radius: 10px;
        }
        .btn-cart {
            background: #007bff;
            color: white;
        }
        .btn-wishlist {
            background: #ff4757;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Product Details</h2>
        <img src="~/img/placeholderimg.png" alt="Product Image" class="product-image">
        <div class="product-details">
            <p><strong>Product ID:</strong> @Model["ProductId"]</p>
            <p><strong>Name:</strong> @Model["ProductName"]</p>
            <p><strong>Category:</strong> @Model["Category"]</p>
            <p><strong>Price:</strong> $@Model["CostPrice"]</p>
            <p><strong>Manufacturer ID:</strong> @Model["ManufacturerId"]</p>
            <p><strong>Package:</strong> @Model["Package"]</p>
            <p><strong>Weight:</strong> @Model["Weight"] kg</p>
            <p><strong>Toxicity:</strong> @Model["ToxicityPercentage"]%</p>
            <p><strong>Quantity Available:</strong> @Model["Quantity"]</p>
            <p><strong>Carbon Footprint:</strong> @Model["CarbonFootprint"]</p>
            <p><strong>Volume:</strong> @Model["Volume"] m³</p>
        </div>

        <div class="button-card">
            <form asp-controller="CustomerPage" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model["ProductId"]" />
                <button class="btn btn-cart">Add to Cart</button>
            </form>

            <form asp-controller="CustomerPage" asp-action="AddToWishlist" method="post">
                <input type="hidden" name="productId" value="@Model["ProductId"]" />
                <button type="submit" class="btn btn-wishlist">Add to Wishlist</button>
            </form>
        

           <form method="get" asp-action="ViewReviewsByProduct" asp-controller="CustomerPage">
                    <input type="hidden" name="productId" value="@Model["ProductId"]" />
                    <button type="submit" class="btn btn-sm btn-info mt-2">View Reviews</button>
            </form>
        </div>
        
    </div>
</body>
</html>
