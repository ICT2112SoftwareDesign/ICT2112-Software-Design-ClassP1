@model Dictionary<string, object>

<!DOCTYPE html>
<html>
<head>
    <title>Product Detail</title>
</head>
<body>
    <h2>Product Details</h2>
    <p><strong>ProductId:</strong> @Model["ProductId"]</p>
    <p><strong>ProductName:</strong> @Model["ProductName"]</p>
    <p><strong>Category:</strong> @Model["Category"]</p>
    <p><strong>CostPrice:</strong> @Model["CostPrice"]</p>
    <p><strong>ManufacturerId:</strong> @Model["ManufacturerId"]</p>
    <p><strong>Package:</strong> @Model["Package"]</p>
    <p><strong>Weight:</strong> @Model["Weight"]</p>
    <p><strong>ToxicityPercentage:</strong> @Model["ToxicityPercentage"]</p>
    <p><strong>Quantity:</strong> @Model["Quantity"]</p>
    <p><strong>CarbonFootprint:</strong> @Model["CarbonFootprint"]</p>
    <p><strong>Volume:</strong> @Model["Volume"]</p>
</body>
</html>