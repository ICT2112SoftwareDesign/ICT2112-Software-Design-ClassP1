@{
    ViewData["Title"] = "Manufacturer Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@model ManufacturerDashboardRdm
<div class="mb-4">
    <!-- <button class="btn btn-outline-primary me-2" id="showBatchView">Batch View</button>
                    <button class="btn btn-outline-secondary" id="showProductView">Product View</button> -->
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
        Generate Manufacturer Dashboard
    </button>
    <form asp-controller="Report" asp-action="PreviewReport" method="get" style="display: inline;">
        <input type="hidden" name="selectedDashboards" value="Manufacturer" />
        <button type="submit" class="btn btn-secondary">Generate Report</button>
    </form>

    <!-- Modal -->
    <div class="modal fade" id="generateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-controller="ManufacturerPage" asp-action="GenerateDashboard" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Generate New Manufacturer Dashboard</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="ValidityDuration" class="form-label">Validity (days)</label>
                            <input type="number" class="form-control" name="ValidityDuration" required />
                        </div>
                        <div class="mb-3">
                            <label for="RequestedStartDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="RequestedStartDate" name="RequestedStartDate"
                                max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <div class="invalid-feedback" id="startDateError">
                                Start Date must be before End Date and not be future dates
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="RequestedEndDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="RequestedEndDate" name="RequestedEndDate"
                                max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <div class="invalid-feedback" id="endDateError">
                                End Date must be after Start Date and not be future dates
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" id="generateDashboardBtn" class="btn btn-primary">Generate</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <h2>@Model.Name</h2>
    <p><strong>Requested Start Date:</strong> @(Model.RequestedStartDate.ToString("yyyy-MM-dd") ?? "N/A")</p>
    <p><strong>Requested End Date:</strong> @(Model.RequestedEndDate.ToString("yyyy-MM-dd") ?? "N/A")</p>
    <p><strong>Generated Date:</strong> @(Model.GeneratedDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
    <p><strong>Validity Duration:</strong> @Model.ValidityDuration</p>
</div>

@if (Model.MetricDetailsList != null && Model.MetricDetailsList.Any())
{
    <div style="display: flex; flex-wrap: wrap; gap: 40px;">
        <div style="width: 45%; height: 350px; margin-top: 40px; margin-bottom: 40px;">
            <h2>Delivery Rate by Manufacturer</h2>
            <canvas id="deliveryRateChart"></canvas>
        </div>

        <div style="width: 45%; height: 350px; margin-top: 40px; margin-bottom: 40px;">
            <h2>Defect Rate by Manufacturer</h2>
            <canvas id="defectChart"></canvas>
        </div>

        <div style="width: 45%; height: 350px; margin-bottom: 240px;">
            <h2>Dependency Rate Distribution</h2>
            <p>Dependency Rate = Manufacturer Quantity/Total Quantity</p>
            <p>Low : <0.05 &nbsp|&nbsp Med: 0.05 &lt 0.2 &nbsp|&nbsp High: >0.2</p>
            <canvas id="dependencyRatePieChart"></canvas>
        </div>

        <div style="width: 45%; height: 350px; margin-bottom: 240px;">
            <h2>Risk Flag Distribution</h2>
            <p>Risky = (Defect Rate * Dependency Rate) > 0.1</p>
            <p>&nbsp</p>
            <canvas id="riskPieChart"></canvas>
        </div>
    </div>
}
else
{
    <p>No metrics available.</p>
}

<!-- End Page Content -->
<!------------------------------------------------------------------------------------>
<!------------------------------------------------------------------------------------>
<!------------------------------------------------------------------------------------>

@section Scripts {
    @{
        <script>

            const metrics = @Html.Raw(Json.Serialize(Model.MetricDetailsList));

            //Metrics for Delivery Chart
            // Extract the manufacturer IDs and delivery rates from the metrics
            const del_manufacturerIds = metrics.map(m => m.manufacturerId);
            const del_deliveryRates = metrics.map(m => m.deliveryRate);

            // Metrics for Defect Chart
            // Filter metrics to only include manufacturers with a non-zero delivery rate
            const filteredMetrics = metrics.filter(m => m.deliveryRate !== 0);

            // Extract the manufacturer IDs and defect rates from the filtered metrics
            const def_manufacturerIds = filteredMetrics.map(m => m.manufacturerId);
            const def_defectRates = filteredMetrics.map(m => m.defectRate);

            //Metrics for Dependency Chart
            // Extract the dependency rates from the metrics
            const dependencyRates = metrics.map(m => m.dependencyRate);
            // const dep_manufacturers = metrics.map(m => m.manufacturerId);

            // Categorize the dependency rates into low, medium, and high
            const lowManufacturers = metrics.filter(m => m.dependencyRate <= 0.05).map(m => m.manufacturerId);
            const mediumManufacturers = metrics.filter(m => m.dependencyRate > 0.05 && m.dependencyRate <= 0.2).map(m => m.manufacturerId);
            const highManufacturers = metrics.filter(m => m.dependencyRate > 0.2).map(m => m.manufacturerId);

            // Data for the pie chart
            const dependencyLabels = ["Low", "Medium", "High"];
            const dependencyData = [lowManufacturers.length, mediumManufacturers.length, highManufacturers.length];

            // Metrics for Risk Chart
            // Filter manufacturers based on the riskFlag value
            const riskManufacturers = metrics.filter(m => m.riskFlag).map(m => m.manufacturerId);
            const noRiskManufacturers = metrics.filter(m => !m.riskFlag).map(m => m.manufacturerId);

            // Data for the pie chart
            const labels = ["Risk", "No Risk"];
            const data = [riskManufacturers.length, noRiskManufacturers.length];

            function generateDeliveryRateChart() {
                new Chart(document.getElementById("deliveryRateChart"), {
                    type: "bar",
                    data: {
                        labels: del_manufacturerIds,  // X-axis labels (manufacturer IDs)
                        datasets: [{
                            label: "Delivery Rate",  // The label that appears on hover
                            data: del_deliveryRates,     // Y-axis data (delivery rates)
                            backgroundColor: "#4bc0c0"  // Bar color
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: {
                                beginAtZero: true,  // Ensure Y-axis starts from zero
                                title: {
                                    display: true,
                                    text: "Delivery Rate"
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: "Manufacturer ID"
                                }
                            }
                        }
                    }
                });
            }


            function generateDefectChart() {
                // Create the bar chart using Chart.js
                new Chart(document.getElementById("defectChart"), {
                    type: "bar",
                    data: {
                        labels: def_manufacturerIds,  // X-axis labels (manufacturer IDs)
                        datasets: [{
                            label: "Defect Rate",  // The label that appears on hover
                            data: def_defectRates,     // Y-axis data (defect rates)
                            backgroundColor: "#007bff"  // Bar color
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: {
                                beginAtZero: true,  // Ensure Y-axis starts from zero
                                title: {
                                    display: true,
                                    text: "Defect Rate"
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: "Manufacturer ID"
                                }
                            }
                        }
                    }
                });
            }

            function generateDependencyRatePieChart() {
                new Chart(document.getElementById("dependencyRatePieChart"), {
                    type: "pie",
                    data: {
                        labels: dependencyLabels,
                        datasets: [{
                            data: dependencyData,
                            backgroundColor: ["#ff6384", "#36a2eb", "#4bc0c0"]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    // Customizing the tooltip label
                                    label: function (tooltipItem) {
                                        const index = tooltipItem.dataIndex;
                                        let manufacturerList = [];

                                        // Display the list of manufacturers based on the dependency rate
                                        if (index === 0) {
                                            manufacturerList = lowManufacturers.join(", ");
                                        } else if (index === 1) {
                                            manufacturerList = mediumManufacturers.join(", ");
                                        } else if (index === 2) {
                                            manufacturerList = highManufacturers.join(", ");
                                        }

                                        return `Manufacturers: ${manufacturerList}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            function generateRiskPieChart() {
                new Chart(document.getElementById("riskPieChart"), {
                    type: "pie",
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: ["#ff6384", "#36a2eb"]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    // Customizing the tooltip label
                                    label: function (tooltipItem) {
                                        const index = tooltipItem.dataIndex;
                                        let manufacturerList = [];

                                        // Display the list of manufacturers based on the riskFlag
                                        if (index === 0) {
                                            manufacturerList = riskManufacturers.join(", ");
                                        } else if (index === 1) {
                                            manufacturerList = noRiskManufacturers.join(", ");
                                        }

                                        return `Manufacturers: ${manufacturerList}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            window.onload = function () {
                generateDeliveryRateChart();
                generateDefectChart();
                generateDependencyRatePieChart();
                generateRiskPieChart();
            }

        </script>

    }
}