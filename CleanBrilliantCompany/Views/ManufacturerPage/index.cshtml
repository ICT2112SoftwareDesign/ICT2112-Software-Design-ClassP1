    <!-- Chart.js and Bootstrap 5 scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Your Custom JS Script Here -->
    <script>

        const metrics = @Html.Raw(Json.Serialize(Model.Metrics));

        //Metrics for Delivery Chart
        // Extract the manufacturer IDs and delivery rates from the metrics
        const del_manufacturerIds = metrics.map(m => m.manufacturerId);
        const del_deliveryRates = metrics.map(m => m.deliveryRate);

        // Metrics for Defect Chart
        // Filter metrics to only include manufacturers with a non-zero delivery rate
        const filteredMetrics = metrics.filter(m => m.deliveryRate !== 0);

        // Extract the manufacturer IDs and defect rates from the filtered metrics
        const manufacturerIds = filteredMetrics.map(m => m.manufacturerId);
        const defectRates = filteredMetrics.map(m => m.defectRate);

        //Metrics for Dependency Chart
        // Extract the dependency rates from the metrics
        const dependencyRates = metrics.map(m => m.dependencyRate);

        // Categorize the dependency rates into low, medium, and high
        const lowCount = dependencyRates.filter(rate => rate <= 0.05).length;
        const mediumCount = dependencyRates.filter(rate => rate > 0.05 && rate <= 0.2).length;
        const highCount = dependencyRates.filter(rate => rate > 0.2).length;

        // Data for the pie chart
        const dependencyLabels = ["Low", "Medium", "High"];
        const dependencyData = [lowCount, mediumCount, highCount];

        // Metrics for Risk Chart
        // Calculate the number of manufacturers with and without risk
        const riskCount = metrics.filter(m => m.riskFlag).length;
        const noRiskCount = metrics.length - riskCount;

        // Data for the pie chart
        const labels = ["Risk", "No Risk"];
        const data = [riskCount, noRiskCount];

        function generateDeliveryRateChart() {
            new Chart(document.getElementById("deliveryRateChart"), {
                type: "bar",
                data: {
                    labels: del_manufacturerIds,  // X-axis labels (manufacturer IDs)
                    datasets: [{
                        label: "Delivery Rate",  // The label that appears on hover
                        data: del_deliveryRates,     // Y-axis data (delivery rates)
                        backgroundColor: "#4bc0c0"  // Bar color
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,  // Ensure Y-axis starts from zero
                            title: {
                                display: true,
                                text: "Delivery Rate"
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: "Manufacturer ID"
                            }
                        }
                    }
                }
            });
        }


        function generateDefectChart() {
            // Create the bar chart using Chart.js
            new Chart(document.getElementById("defectChart"), {
                type: "bar",
                data: {
                    labels: manufacturerIds,  // X-axis labels (manufacturer IDs)
                    datasets: [{
                        label: "Defect Rate",  // The label that appears on hover
                        data: defectRates,     // Y-axis data (defect rates)
                        backgroundColor: "#007bff"  // Bar color
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,  // Ensure Y-axis starts from zero
                            title: {
                                display: true,
                                text: "Defect Rate"
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: "Manufacturer ID"
                            }
                        }
                    }
                }
            });
        }

        function generateDependencyRatePieChart() {
            new Chart(document.getElementById("dependencyRatePieChart"), {
                type: "pie",
                data: {
                    labels: dependencyLabels,
                    datasets: [{
                        data: dependencyData,
                        backgroundColor: ["#ff6384", "#36a2eb", "#4bc0c0"]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        }

        function generateRiskPieChart() {

            new Chart(document.getElementById("riskPieChart"), {
                type: "pie",
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ["#ff6384", "#36a2eb"]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        }

        window.onload = function() {
            generateDeliveryRateChart();
            generateDefectChart();
            generateDependencyRatePieChart();
            generateRiskPieChart();
        }

    </script>
</body>

