                    <!-- <div class="container-fluid">
                            You can choose to place your content here and keep the heading above BEAVER

                    </div> -->

                                                    <!-- You can add a chart or table here -->
                    @model ManufacturerDashboardRdm

                    <div class="mb-4">
                    <!-- <button class="btn btn-outline-primary me-2" id="showBatchView">Batch View</button>
                    <button class="btn btn-outline-secondary" id="showProductView">Product View</button> -->
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
                        Generate Manufacturer Dashboard
                    </button>

                    <!-- Modal -->
                    <div class="modal fade" id="generateModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <form asp-controller="ManufacturerPage" asp-action="GenerateDashboard" method="post">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Generate New Manufacturer Dashboard</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label for="ValidityDuration" class="form-label">Validity (days)</label>
                                            <input type="number" class="form-control" name="ValidityDuration" required />
                                        </div>
                                        <div class="mb-3">
                                            <label for="RequestedStartDate" class="form-label">Start Date</label>
                                            <input type="date" class="form-control" id="RequestedStartDate" name="RequestedStartDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                            <div class="invalid-feedback" id="startDateError">
                                                Start Date must be before End Date and not be future dates
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="RequestedEndDate" class="form-label">End Date</label>
                                            <input type="date" class="form-control" id="RequestedEndDate" name="RequestedEndDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                            <div class="invalid-feedback" id="endDateError">
                                                End Date must be after Start Date and not be future dates
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="submit" id="generateDashboardBtn" class="btn btn-primary">Generate</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>


                    <h2>Manufacturer Dashboard</h2>

                    <div>
                        <h3>@Model.Name</h3>
                        <p><strong>Requested Start Date:</strong> @(Model.RequestedStartDate.ToString("yyyy-MM-dd") ?? "N/A")</p>
                        <p><strong>Requested End Date:</strong> @(Model.RequestedEndDate.ToString("yyyy-MM-dd") ?? "N/A")</p>
                        <p><strong>Generated Date:</strong> @(Model.GeneratedDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                        <p><strong>Validity Duration:</strong> @Model.ValidityDuration</p>
                    </div>

                    @if (Model.Metrics != null && Model.Metrics.Any())
                    {
                        <h3>Metrics:</h3>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Manufacturer ID</th>
                                    <th>Delivery Rate</th>
                                    <th>Defect Rate</th>
                                    <th>Dependency Rate</th>
                                    <th>Risk Flag</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var metric in Model.Metrics)
                            {
                                <tr>
                                    <td>@metric.ManufacturerId</td>
                                    <td>@metric.DeliveryRate</td>
                                    <td>@metric.DefectRate</td>
                                    <td>@metric.DependencyRate</td>
                                    <td>@(metric.RiskFlag ? "Yes" : "No")</td>
                                </tr>
                            }
                            </tbody>
                         </table>

                        <div style="display: flex; flex-wrap: wrap; gap: 40px;">
                            <div style="width: 45%; height: 350px; margin-top: 40px; margin-bottom: 40px;">
                                <h2>Delivery Rate by Manufacturer</h2>
                                <canvas id="deliveryRateChart"></canvas>
                            </div>

                            <div style="width: 45%; height: 350px; margin-top: 40px; margin-bottom: 40px;">
                                <h2>Defect Rate by Manufacturer</h2>
                                <canvas id="defectChart"></canvas>
                            </div>

                            <div style="width: 45%; height: 350px; margin-bottom: 60px;">
                                <h2>Dependency Rate Distribution</h2>
                                <canvas id="dependencyRatePieChart"></canvas>
                            </div>

                            <div style="width: 45%; height: 350px; margin-bottom: 60px;">
                                <h2>Risk Flag Distribution</h2>
                                <canvas id="riskPieChart"></canvas>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p>No metrics available.</p>
                    }


                </div>
