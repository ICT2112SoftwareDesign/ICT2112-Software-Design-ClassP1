@model List<CleanBrilliantCompany.Models.Refund_RDM>
@{
    ViewData["Title"] = "Refund";
    Layout = null; // Using custom layout in this page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Refund</title>

    <!-- Custom fonts for this template-->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        /* Add some additional styling for debugging */
        .debug-info {
            padding: 10px;
            margin-top: 20px;
            background-color: #f8f9fc;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper">
        <!-- Sidebar -->
        @await Html.PartialAsync("~/Views/Staff/staff-sidebar.cshtml")

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">

                <!-- Page Content -->
                <div class="container-fluid mt-4">

                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Manage Refunds</h1>
                    </div>

                    <!-- Refunds Card -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Refund Records</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered text-center" width="100%" cellspacing="0">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>No.</th>
                                            <th>Refund ID</th>
                                            <th>Order ID</th>
                                            <th>Refund Amount</th>
                                            <th>Request Date</th>
                                            <th>Processed Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            int index = 1;
                                            foreach (var refund in Model)
                                            {
                                                <tr>
                                                    <td class="align-middle">@index</td>
                                                    <td class="align-middle">@refund.RefundId</td>
                                                    <td class="align-middle">@refund.OrderId</td>
                                                    <td class="align-middle">$@refund.RefundAmount</td>
                                                    <td class="align-middle">@refund.RefundRequestDate.ToShortDateString()</td>
                                                    <td class="align-middle">
                                                        @(refund.RefundProcessedDate?.ToShortDateString() ?? "Not Processed")
                                                    </td>
                                                    <td class="align-middle font-weight-bold 
                                                        @(refund.Status == "Approved" ? "text-success" : 
                                                        refund.Status == "Pending" ? "text-warning" : "text-danger")">
                                                        @refund.Status
                                                    </td>
                                                    <td class="align-middle">
                                                        <a href="@Url.Action("RefundDetails", "Refund", new { id = refund.RefundId })"
                                                        class="btn @(refund.Status == "Pending" ? "btn-primary" : "btn-secondary") btn-sm">
                                                            Manage
                                                        </a>
                                                    </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center">No refund records available.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- End of Page Content -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Your Website 2024</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap & JS -->
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
