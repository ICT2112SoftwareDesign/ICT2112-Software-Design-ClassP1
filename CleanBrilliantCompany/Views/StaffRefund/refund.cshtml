@model List<CleanBrilliantCompany.Models.Refund_RDM>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Manage Refunds</title>

    <!-- Custom styles -->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> 
</head>

<body id="page-top">
    <div id="wrapper">
        <!-- Sidebar -->
        @await Html.PartialAsync("~/Views/Staff/staff-sidebar.cshtml")

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <!-- Topbar -->
                @await Html.PartialAsync("~/Views/Staff/staff-topbar.cshtml")

                <!-- Page Content -->
                <div class="container-fluid">
                    <h1 class="h3 mb-4 text-gray-800">Manage Refunds</h1>

                    <table class="table table-bordered text-center">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Refund ID</th>
                                <th>Order ID</th>
                                <th>Refund Amount</th>
                                <th>Request Date</th>
                                <th>Processed Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int index = 1;
                                foreach (var refund in Model)
                                {
                                    <tr>
                                        <th class="align-middle" scope="row">@index</th>
                                        <td class="align-middle">@refund.RefundId</td>
                                        <td class="align-middle">@refund.OrderId</td>
                                        <td class="align-middle">$@refund.RefundAmount</td>
                                        <td class="align-middle">@refund.RefundRequestDate.ToShortDateString()</td>
                                        <td class="align-middle">
                                            @(refund.RefundProcessedDate?.ToShortDateString() ?? "Not Processed")
                                        </td>
                                        <td class="align-middle @(refund.Status == "Approved" ? "text-success" : refund.Status == "Pending" ? "text-warning" : "text-danger")">
                                            @refund.Status
                                        </td>
                                        <td class="align-middle">
                                            <a href="@Url.Action("RefundDetails", "Refund", new { id = refund.RefundId })" class="btn @(refund.Status == "Pending" ? "btn-primary" : "btn-secondary")">
                                                Manage
                                            </a>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center">No refund records available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr>

                    <!-- Insert Test Refund -->
                    @* <form method="post" action="@Url.Action("CreateRefund", "Refund")">                        
                        <button type="submit" class="btn btn-primary mt-3">Create Test Refund</button>
                    </form> *@
   
                </div>
                <!-- End of Page Content -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Your Website 2024</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap & JS -->
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
