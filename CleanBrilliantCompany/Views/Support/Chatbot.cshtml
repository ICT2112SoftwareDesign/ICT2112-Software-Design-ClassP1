<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>CHAT WITH US</title>

</head>
    <body class="bg-primary"> <!-- Set the background color to the primary color -->

    <section>
        <div class="container py-5">
            <div class="row d-flex justify-content-center">
                <div class="col-md-12 col-lg-10 col-xl-8">
                    <div class="card" id="chat2">
                        <div class="card-header d-flex justify-content-between align-items-center p-3">
                            <h5 class="mb-0">Support Bot</h5>
                        </div>
                        <div class="card-body" style="overflow-y: auto; height: 400px">

                            @if (ViewBag.ChatHistory != null)
                            {
                                <ul>
                                    @foreach (var message in ViewBag.ChatHistory)
                                    {
                                        @foreach (var kvp in message)
                                        {
                                            var key = @kvp.Key;
                                            var value = @kvp.Value;

                                            @if (key == "user")
                                            {
                                                <div class="d-flex flex-row justify-content-end mb-4 pt-1">
                                                    <div>
                                                        <p class="small p-2 me-3 mb-1 text-white rounded-3 bg-primary">@value</p>
                                                        <p class="small me-3 mb-3 rounded-3 text-muted d-flex justify-content-end">00:06</p>
                                                    </div>
                                                </div>
                                            } 
                                            else if (key == "bot") {
                                                <div class="d-flex flex-row justify-content-start">
                                                    <div>
                                                        <p class="small p-2 ms-3 mb-1 rounded-3 bg-body-tertiary border border-dark">@value</p>
                                                        <p class="small ms-3 mb-3 rounded-3 text-muted">23:58</p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }        
                                </ul>
                            }
                        </div>
                        <div class="card-footer text-muted d-flex justify-content-start align-items-center p-3">
                            <form method="post" asp-controller="CustomerPage" asp-action="redirectToProvideAutomatedResponse" class="w-100">
                                <div class="form-group d-flex align-items-center">
                                    <input type="text" id="query" name="query" class="form-control form-control-lg me-2" placeholder="Type message" />
                                    <button type="submit" class="btn btn-primary mb-2">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap core JavaScript-->
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="js/sb-admin-2.min.js"></script>

    <script>
    // Function to scroll the chat to the bottom
        function scrollChatToBottom() {
            var chatBody = document.querySelector('.card-body');
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        // Call the function when the page loads
        window.onload = scrollChatToBottom;
    </script>

</body>
</html>

