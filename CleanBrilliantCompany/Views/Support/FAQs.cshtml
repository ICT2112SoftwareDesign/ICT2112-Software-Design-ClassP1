<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>FREQUENTLY ASKED QUESTIONS</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom styles -->
    <style>
        .bg-custom-blue {
            background-color: #4e73df; /* This is the blue from SB Admin 2 theme */
        }

        .faq-question {
            cursor: pointer;
            font-weight: bold;
            color: grey;
            padding: 10px;
            background-color: #f8f9fa;
            border-radius: 5px;
            margin-bottom: 5px;
            position: relative;
        }
        
        .faq-question:after {
            content: '+';
            position: absolute;
            right: 15px;
        }
        
        .faq-question.active:after {
            content: '-';
        }
        
        .faq-answer {
            display: none;
            padding: 10px;
            margin-left: 15px;
            margin-bottom: 15px;
            border-left: 3px solid #4e73df;
        }
        
        .faq-item {
            margin-bottom: 10px;
        }
        
        .report-issue {
            margin-top: 30px;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 5px;
        }
    </style>

</head>
<body class="bg-custom-blue"> <!-- Set the background color to the primary color -->

    <div class="container mt-5">
        <!-- Header -->
        <div class="profile-header mb-4">
            <h3 class="font-weight-bold text-white">Frequently Asked Questions:</h3>
        </div>
        
        <!-- FAQ Card -->
        <div class="card p-4 mb-4">
            <div id="faq-container">
                @foreach (var faq in ViewBag.FAQs)
                {
                    <div class="faq-item">
                        <div class="faq-question">@faq.Key</div>
                        <div class="faq-answer">@faq.Value</div>
                    </div>
                }
            </div>
        </div>
        
        <!-- Report Issue Card -->
        <div class="card p-4">
            <div class="report-issue">
                <h5>Couldn't find what you're looking for?</h5>
                <p>If you have a question that's not covered above, please let us know.</p>
                <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#reportIssueModal">Report an Issue</a>
            </div>
        </div>
    </div>
    
    <!-- Report Issue Modal -->
    <div class="modal fade" id="reportIssueModal" tabindex="-1" aria-labelledby="reportIssueModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportIssueModalLabel">Report an Issue</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="issueForm">
                        <div class="mb-3">
                            <label for="orderID" class="form-label">Order ID</label>
                            <input type="number" class="form-control" id="orderID" placeholder="Brief description of your issue">
                        </div>
                        <div class="mb-3">
                            <label for="issueDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="issueDescription" rows="3" placeholder="Please provide details about your issue"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitIssue">Submit</button>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery and Bootstrap JS from CDNs -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> 

    <!-- Bootstrap core JavaScript-->
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Toggle FAQ answers
            $('.faq-question').click(function() {
                $(this).toggleClass('active');
                $(this).next('.faq-answer').slideToggle();
            });
            
            // Handle issue submission
            $('#submitIssue').click(function() {
                // Collect form data
                const formData = {
                    orderID: parseInt($('#orderID').val(), 10),
                    issueDescription: $('#issueDescription').val()
                };
                
                // Send data to server using AJAX
                $.ajax({
                    type: "POST",
                    url: "/CustomerPage/escalateIssue", 
                    data: formData,
                    success: function(response) {
                         // Close the modal
                        const bsModal = bootstrap.Modal.getInstance(document.getElementById('reportIssueModal'));
                        bsModal.hide();
                        
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                             // Display success message
                            alert('Thank you for submitting your issue. We will get back to you soon.');
                        }
                        
                        // Reset form
                        $('#issueForm')[0].reset();
                    },
                    error: function(error) {
                        // Handle errors
                        alert('There was an error submitting your issue. Please try again.');
                        console.log(error);
                    }
                });
            });
        });
    </script>

</body>
</html>

