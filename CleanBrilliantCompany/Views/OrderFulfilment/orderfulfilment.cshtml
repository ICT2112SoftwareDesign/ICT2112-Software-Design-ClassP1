@inject CleanBrilliantCompany.Models.OrderFulfilmentManagement OrderFulfilmentManagement

@{
    ViewData["Title"] = "Order Fufilment";

    // Fetch all orders using the OrderFulfilmentManagement class
    var orders = OrderFulfilmentManagement.getAllOrders();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>SB Admin 2 - Dashboard</title>

    <!-- Custom fonts for this template-->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="css/sb-admin-2.min.css" rel="stylesheet">

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        @await Html.PartialAsync("~/Views/Staff/staff-sidebar.cshtml")

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Search -->
                    <form
                        class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">
                        <div class="input-group">
                            <input type="text" class="form-control bg-light border-0 small" placeholder="Search for..."
                                aria-label="Search" aria-describedby="basic-addon2">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button">
                                    <i class="fas fa-search fa-sm"></i>
                                </button>
                            </div>
                        </div>
                    </form>

                </nav>
                <!-- End of Topbar -->
                

                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Order Fufilment Management</h1>
                    </div>

                    <!-- DataTables Example -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="shippingAgentsTable" width="100%"
                                    cellspacing="0">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Order ID</th>
                                            <th>Customer ID</th>
                                            <th>Order Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in orders)
                                        {
                                            <tr data-order-id="@order.RetrieveOrderID()">
                                                <td>@order.RetrieveOrderID()</td>
                                                <td>@order.RetrieveCustomerID()</td>
                                                <td>@order.RetrieveOrderDate().ToShortDateString()</td>
                                                <td>
                                                    <select class="form-control status-select"
                                                        data-order-id="@order.RetrieveOrderID()">
                                                        <option value="Pending"
                                                            selected="@(order.RetrieveStatus() == "Pending")">Pending</option>
                                                        <option value="Shipped"
                                                            selected="@(order.RetrieveStatus() == "Shipped")">Shipped</option>
                                                        <option value="Completed"
                                                            selected="@(order.RetrieveStatus() == "Completed")">Completed
                                                        </option>
                                                        <option value="RefundRequested"
                                                            selected="@(order.RetrieveStatus() == "RefundRequested")">Refund
                                                            Requested</option>
                                                        <option value="Cancelled"
                                                            selected="@(order.RetrieveStatus() == "Cancelled")">Cancelled
                                                        </option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <button id ="update-status-btn" class="btn btn-primary btn-sm update-status-btn"
                                                        data-order-id="@order.RetrieveOrderID()">
                                                        Update Status
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Include the footer -->
            @await Html.PartialAsync("staff-footer")

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>


    <!-- Bootstrap core JavaScript-->
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="js/demo/chart-area-demo.js"></script>
    <script src="js/demo/chart-pie-demo.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Update button click handler
            $('[id^=update-status-btn]').click(function () {
                const button = $(this);
                const orderId = button.data('order-id');
                const statusSelect = $(`select.status-select[data-order-id="${orderId}"]`);
                const newStatus = statusSelect.val();

                console.log('Attempting to update order:', orderId, 'to status:', newStatus);

                button.prop('disabled', true);
                button.html('<i class="fas fa-spinner fa-spin"></i> Updating...');

                $.ajax({
                    url: '/staff/OrderFulfilment/UpdateStatus',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        orderId: orderId,
                        status: newStatus
                    }),
                    success: function (response) {
                        console.log('Update response:', response);
                        if (response.success) {
                            // Update successful
                            showToast(`Order #${orderId} updated to ${newStatus}`, 'success');

                            // Update the select to show the new status is selected
                            statusSelect.find('option').removeAttr('selected');
                            statusSelect.find(`option[value="${newStatus}"]`).attr('selected', true);

                        } else {
                            showToast(response.message || 'Update failed', 'danger');
                        }
                        resetButton(button);
                    },
                    error: function (xhr) {
                        console.error('Update error:', xhr);
                        showToast(xhr.responseJSON?.error || 'Server error', 'danger');
                        resetButton(button);
                    }
                });
            });

            function resetButton(button) {
                setTimeout(function () {
                    button.html('Update Status').prop('disabled', false);
                }, 1500);
            }

            function showToast(message, type) {
                // Implement your toast notification here
                alert(type + ': ' + message); // Temporary - replace with proper toast
            }
        });
    </script>

</body>

</html>