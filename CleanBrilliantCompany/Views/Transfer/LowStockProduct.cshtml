@model List<Dictionary<string, object>>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


<h2>Low Stock Product List</h2>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#transferModal"
    id="openTransferModal">
    Create Transfer Request
</button>

<a class="btn btn-primary" id="redirectToTransfer" asp-controller="Transfer" asp-action="Transfer">
    View Transfer Request
</a>

<br /><br />

@if (Model == null || !Model.Any())
{
    <p>No Transfer Record Found.</p>
}
else
{
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Warehouse</th>
                <th>Total Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var productInfo in Model)
            {
                <tr>
                    <td>@productInfo["ProductName"]</td>
                    <td>@productInfo["WarehouseName"]</td>
                    <td>@productInfo["TotalQuantity"]</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="transferModalLabel">Create Transfer Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="transferForm" method="post" asp-action="addTransfer">
                        <div class="mb-3">
                            <label for="productId" class="form-label">Product</label>
                            @* <input type="number" class="form-control" name="productId" id="productId" required> *@

                            <select class="form-select" name="productId" id="productId" required>
                                <option value="">Select Product</option>
                                @foreach (var productInfo in Model)
                                {
                                    <option value="@productInfo["ProductId"]">@productInfo["ProductName"]</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" name="quantity" id="quantity" required>
                        </div>
                        <div class="mb-3">
                            <label for="sourceWarehouse" class="form-label">Source Warehouse</label>
                            @* <input type="number" class="form-control" name="sourceWarehouse" id="sourceWarehouse" required> *@
                            <select class="form-select" name="sourceWarehouse" id="sourceWarehouse" required>
                                <option value="">Select Warehouse</option>
                                @foreach (var warehouse in Model.Select(p => new
                                {
                                    Id = p["WarehouseId"],
                                    Name =
                                                            p["WarehouseName"]
                                }).Distinct())
                                {
                                    <option value="@warehouse.Id">@warehouse.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="destinationWarehouse" class="form-label">Destination Warehouse</label>
                            <select class="form-select" name="destinationWarehouse" id="destinationWarehouse" required>
                                <option value="">Select Destination Warehouse</option>
                                @foreach (var warehouse in Model.Select(p => new
                                {
                                    Id = p["WarehouseId"],
                                    Name =
                                                            p["WarehouseName"]
                                }).Distinct())
                                {
                                    <option value="@warehouse.Id">@warehouse.Name</option>
                                }
                            </select>
                            @* <div class="mb-3">
                            <label for="destinationWarehouse" class="form-label">Destination Warehouse</label>
                             <input type="number" class="form-control" name="destinationWarehouse" id="destinationWarehouse"
                                required> 
                            <select class="form-select" name="destinationWarehouse" id="destinationWarehouse" required>
                                <option value="">Select Warehouse</option>
                                @foreach (var productInfo in Model)
                                {
                                    <option value="@productInfo["WarehouseId"]">@productInfo["WarehouseName"]</option>
                                }*@
                        </div>
                        <button type="submit" class="btn btn-primary">Submit Request</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

}


