   <script>
    function populateSourceWarehouses(destinationWarehouseId) {
        const sourceSelect = document.getElementById('sourceWarehouse');

        // Clear previous options except the default one
        while (sourceSelect.options.length > 1) {
            sourceSelect.remove(1);
        }

        // Add all warehouses except the destination warehouse
        allWarehouses.forEach(warehouse => {
            if (warehouse.id !== destinationWarehouseId) {
                const option = document.createElement('option');
                option.value = warehouse.id;
                option.text = warehouse.name;
                sourceSelect.add(option);
            }
        });
    }

    async function fetchAvailableStock(productId, warehouseId) {
        try {
            document.getElementById('availableStock').value = "Loading...";
            let response = await
                fetch(`/inventory/management/stockflow/transfer/getStockForWarehouse?productId=${productId}&warehouseId=${warehouseId}`);
            let data = await response.json();
            if (response.ok) {
                document.getElementById('availableStock').value = data.quantity;
            } else {
                document.getElementById('availableStock').value = "Error: " + (data.message || "Could not fetch stock");
                console.error("API error:", data);
            }
        } catch (error) {
            console.error("Fetch error:", error);
            document.getElementById('availableStock').value = "Error fetching stock";
        }
    }

    // Set up event listeners once the DOM is fully loaded
    document.addEventListener('DOMContentLoaded', function () {
        // Button click event handlers
        document.querySelectorAll(".create-transfer-btn").forEach(button => {
            button.addEventListener("click", function () {
                const productId = this.getAttribute('data-product-id');
                const destinationWarehouseId = this.getAttribute('data-destination-warehouse-id');
                const destinationWarehouseName = this.getAttribute('data-destination-warehouse-name');

                // Set product ID in the form
                document.getElementById('productIdInput').value = productId;

                // Set destination warehouse details (Uneditable)
                document.getElementById('destinationWarehouse').value = destinationWarehouseId;
                document.getElementById('destinationWarehouseDisplay').value = destinationWarehouseName;

                // Populate source warehouse dropdown (excluding destination warehouse)
                populateSourceWarehouses(destinationWarehouseId);

                // Reset quantity field
                document.getElementById('quantity').value = '';

                // Reset available stock field
                document.getElementById('availableStock').value = '';
            });
        });

        // Set up the source warehouse change event listener only once
        document.getElementById('sourceWarehouse').addEventListener("change", function () {
            let selectedSourceWarehouse = this.value;
            let productId = document.getElementById('productIdInput').value;

            if (selectedSourceWarehouse && productId) {
                fetchAvailableStock(productId, selectedSourceWarehouse);
            } else {
                document.getElementById('availableStock').value = '';
            }
        });

        // Form submission handling
        document.getElementById("transferForm").addEventListener("submit", function (event) {
            event.preventDefault();

            let quantity = parseInt(document.getElementById("quantity").value, 10);
            let sourceWarehouse = document.getElementById("sourceWarehouse").value;
            let destinationWarehouse = document.getElementById("destinationWarehouse").value;
            let availableStock = parseInt(document.getElementById("availableStock").value, 10) || 0;

            // Client-side validation
            if (!sourceWarehouse) {
                alert("Please select a source warehouse.");
                return;
            }

            if (isNaN(quantity) || quantity <= 0) { 
                alert("Please enter a valid quantity."); 
                return; 
            } 
            
            // Uncomment if you want to validate against available stock
            /* if (quantity > availableStock) {
                alert("Quantity exceeds available stock!"); 
                return;
            } */

            let form = this; 
            let formData = new FormData(form); 
            
            fetch(form.action, { 
                method: "POST", 
                body: formData 
            }).then(response => {
                if (!response.ok) {
                    // If the server responds with an error status code
                    return Promise.reject('Server error occurred');
                }
                return response.json(); // Continue parsing the JSON if no error
            })
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.href = "transfer/ViewTransfer"; // Redirect to ViewTransfer
                } else {
                    console.log("Error:", data.message);
                    alert("Error: " + (data.message || "An unexpected error occurred.")); // Display message
                }
            })
            .catch(error => {
                // Handle unexpected fetch errors (e.g., network issues)
                console.error("Fetch error:", error);
                alert("An unexpected error occurred. Please try again.");
            });
        });
    });
</script>

