@model List<Dictionary<string, object>>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2>Low Stock Product List</h2>

<a class="btn btn-primary" id="redirectToTransfer" asp-controller="Transfer" asp-action="Transfer">
    View Transfer Request
</a>

<br /><br />

@if (Model == null || !Model.Any())
{
    <p>No Transfer Record Found.</p>
}
else
{
    <script>
        // Store all warehouse details for JavaScript
        const allWarehouses = [
                @foreach (var warehouse in Model.Select(p => new { Id = p["WarehouseId"].ToString(), Name = p["WarehouseName"].ToString() }).Distinct())
            {
                <text>{id: "@warehouse.Id", name: "@warehouse.Name" },</text>
                }
            ];
    </script>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Warehouse</th>
                <th>Total Quantity</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var productInfo in Model)
            {
                <tr>
                    <td>@productInfo["ProductName"]</td>
                    <td>@productInfo["WarehouseName"]</td>
                    <td>@productInfo["TotalQuantity"]</td>
                    <td>
                        <button type="button" class="btn btn-primary create-transfer-btn" data-bs-toggle="modal"
                            data-bs-target="#transferModal" data-product-id="@productInfo["ProductId"]"
                            data-warehouse-id="@productInfo["WarehouseId"]" data-warehouse-name="@productInfo["WarehouseName"]">
                            Create Transfer Request
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Modal for Transfer Request -->
    <div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="transferModalLabel">Create Transfer Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form id="transferForm" method="post" asp-controller="Transfer" asp-action="AddTransfer">
                        <input type="hidden" id="productIdInput" name="productId" value="" />

                        <div class="mb-3">
                            <label class="form-label">Source Warehouse</label>
                            <input type="text" class="form-control" id="warehouseNameDisplay" readonly>
                            <input type="hidden" name="sourceWarehouse" id="sourceWarehouse" required>
                        </div>

                        <!-- Display Available Stock -->
                        <div class="mb-3">
                            <label class="form-label">Available Stock</label>
                            <input type="text" class="form-control" id="availableStock" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="destinationWarehouse" class="form-label">Destination Warehouse</label>
                            <select class="form-select" name="destinationWarehouse" id="destinationWarehouse" required>
                                <option value="">Select Destination Warehouse</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" name="quantity" id="quantity" required>
                        </div>

                        <button type="submit" class="btn btn-primary">Submit Request</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function populateDestinationWarehouses(sourceWarehouseId) {
        const destinationSelect = document.getElementById('destinationWarehouse');

        // Clear previous options except the default one
        while (destinationSelect.options.length > 1) {
            destinationSelect.remove(1);
        }

        // Add all warehouses except the source warehouse
        allWarehouses.forEach(warehouse => {
            if (warehouse.id !== sourceWarehouseId) {
                const option = document.createElement('option');
                option.value = warehouse.id;
                option.text = warehouse.name;
                destinationSelect.add(option);
            }
        });
    }

    async function fetchAvailableStock(productId, warehouseId) {
        try {
            let response = await fetch(`/inventory/management/stockflow/transfer/getStockForWarehouse?productId=${productId}&warehouseId=${warehouseId}`);
            let data = await response.json();
            if (response.ok) {
                document.getElementById('availableStock').value = data.quantity;
            } else {
                document.getElementById('availableStock').value = "Error Fetching Stock";
            }
        } catch (error) {
            console.error("Fetch error:", error);
            document.getElementById('availableStock').value = "Error Fetching Stock";
        }
    }

    document.querySelectorAll(".create-transfer-btn").forEach(button => {
        button.addEventListener("click", function () {
            const productId = this.getAttribute('data-product-id');
            const warehouseId = this.getAttribute('data-warehouse-id');
            const warehouseName = this.getAttribute('data-warehouse-name');

            // Set source warehouse details
            document.getElementById('productIdInput').value = productId;
            document.getElementById('sourceWarehouse').value = warehouseId;
            document.getElementById('warehouseNameDisplay').value = warehouseName;

            // Populate destination warehouse dropdown (excluding source)
            populateDestinationWarehouses(warehouseId);

            // Fetch available stock for the selected warehouse
            fetchAvailableStock(productId, warehouseId);

            // Reset quantity field
            document.getElementById('quantity').value = '';
        });
    });

    document.getElementById("transferForm").addEventListener("submit", function (event) {
        event.preventDefault();
        let quantity = parseInt(document.getElementById("quantity").value, 10);
        let destinationWarehouse = document.getElementById("destinationWarehouse").value;
        let availableStock = parseInt(document.getElementById("availableStock").value, 10);

        if (quantity <= 0) {
            alert("Please enter a valid quantity.");
            return;
        }

        if (quantity > availableStock) {
            alert("Quantity exceeds available stock!");
            return;
        }

        if (!destinationWarehouse) {
            alert("Please select a destination warehouse.");
            return;
        }

        let form = this;
        let formData = new FormData(form);

        fetch(form.action, {
            method: "POST",
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert("Error: " + (data.message || "An unexpected error occurred."));
                }
            })
            .catch(error => {
                console.error("Fetch error:", error);
                alert("An unexpected error occurred. Please try again.");
            });
    });
</script>
