@model List<Dictionary<string, object>>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2>Transfer List</h2>

<a class="btn btn-primary" id="redirectToStockList" asp-controller="Transfer" asp-action="LowStockProduct">
    View Low Stock Products
</a>

<br /><br />

@if (Model == null || !Model.Any())
{
    <p>No Transfer Record Found.</p>
}
else
{
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Transfer ID</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Source Warehouse</th>
                <th>Destination Warehouse</th>
                <th>Staff ID</th>
                <th>Transfer Status</th>
                <th>Action</th>
                <th>Update</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transferInfo in Model)
            {
                bool isCompleted = transferInfo["Status"]?.ToString() == "Completed";

                <tr>
                    <td>@transferInfo["TransferId"]</td>
                    <td>@transferInfo["ProductName"]</td>
                    <td>@transferInfo["Quantity"]</td>
                    <td>@transferInfo["SourceWarehouseName"]</td>
                    <td>@transferInfo["DestinationWarehouseName"]</td>
                    <td>@transferInfo["StaffId"]</td>
                    <td>
                        <span class="badge @(
                              isCompleted ? "bg-success" :
                              transferInfo["Status"]?.ToString() == "Transit" ? "bg-primary" :
                              "bg-warning"
                        )">
                        @transferInfo["Status"]
                    </span>
                </td>

                    <td>
                        <form asp-action="deleteTransfer" method="post">
                            <input type="hidden" name="TransferId" value="@transferInfo["TransferId"]" />
                            <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this transfer?');">
                                Delete
                            </button>
                        </form>

                    </td>
                    <td>
                        <button type="button" class="btn btn-primary update-transfer-btn" data-bs-toggle="modal"
                            data-bs-target="#updateTransferModal" data-transfer-id="@transferInfo["TransferId"]"
                            data-destination-id="@transferInfo["DestinationWarehouse"]"
                            data-destination-name="@transferInfo["DestinationWarehouseName"]"
                            data-status="@transferInfo["Status"]" @(isCompleted ? "disabled" : "")>
                            Update Transfer Request
                        </button>
                    </td>
                </tr>
                }
        </tbody>
    </table>

    <div class="modal fade" id="updateTransferModal" tabindex="-1" aria-labelledby="updateTransferModalLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateTransferModalLabel">Update Transfer Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="updateTransferForm" asp-action="updateTransfer" method="post">
                        <input type="hidden" id="transferIdInput" name="TransferId" value="" />
                        <input type="hidden" id="originalStatusInput" name="OriginalStatus" value="" />

                        <div class="mb-3">
                            <label for="destinationWarehouseDisplay" class="form-label">Destination Warehouse</label>
                            <input type="text" class="form-control" id="destinationWarehouseDisplay" readonly>
                            <input type="hidden" name="DestinationWarehouse" id="destinationWarehouseInput" required>
                        </div>

                        <div class="mb-3">
                            <label for="transferStatus" class="form-label">Transfer Status</label>
                            <select class="form-select" id="transferStatus" name="Status">
                                <option value="Pending">Pending</option>
                                <option value="Transit">Transit</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        <div class="modal-footer p-0 pt-3 border-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary" id="saveChangesBtn">Save changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    // Handle update button clicks
    document.addEventListener('DOMContentLoaded', function () {
        // Use event delegation for dynamically created elements
        document.body.addEventListener('click', function (event) {
            if (event.target.classList.contains('update-transfer-btn')) {
                const transferId = event.target.getAttribute('data-transfer-id');
                const destinationId = event.target.getAttribute('data-destination-id');
                const destinationName = event.target.getAttribute('data-destination-name');
                const status = event.target.getAttribute('data-status');

                // Set values in the form
                document.getElementById('transferIdInput').value = transferId;
                document.getElementById('originalStatusInput').value = status; // Store original status
                document.getElementById('destinationWarehouseDisplay').value = destinationName;
                document.getElementById('destinationWarehouseInput').value = destinationId;

                // Set the current status in the dropdown
                const statusDropdown = document.getElementById('transferStatus');
                for (let i = 0; i < statusDropdown.options.length; i++) {
                    if (statusDropdown.options[i].value === status) {
                        statusDropdown.selectedIndex = i;
                        break;
                    }
                }

                // If status is already Completed, disable the form elements
                if (status === "Completed") {
                    statusDropdown.disabled = true;
                    document.getElementById('saveChangesBtn').disabled = true;
                } else {
                    statusDropdown.disabled = false;
                    document.getElementById('saveChangesBtn').disabled = false;
                }
            }
        });

        // Form validation
        document.getElementById('updateTransferForm').addEventListener('submit', function (event) {
            const currentStatus = document.getElementById('transferStatus').value;
            const originalStatus = document.getElementById('originalStatusInput').value;

            // If original status was Completed, prevent form submission
            if (originalStatus === "Completed") {
                alert("Cannot update a transfer that is already completed.");
                event.preventDefault();
                return false;
            }

            // You could add more validation rules here if needed
        });
    });
</script>