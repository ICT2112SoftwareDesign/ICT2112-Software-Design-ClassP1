@model CleanBrilliantCompany.Models.Entity.Transfer

@{
    ViewData["Title"] = "Transfer Form";
}

<h2>Transfer Form</h2>

<form asp-action="SaveTransfer" method="post">
    <div class="form-group">
        <label for="transferId">Transfer ID</label>
        <input type="number" id="transferId" name="TransferId" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="productId">Product ID</label>
        <input type="number" id="productId" name="ProductId" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="Status" class="form-control">
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="form-group">
        <label for="quantity">Quantity</label>
        <input type="number" id="quantity" name="Quantity" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="sourceWarehouse">Source Warehouse</label>
        <input type="number" id="sourceWarehouse" name="SourceWarehouse" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="destinationWarehouse">Destination Warehouse</label>
        <input type="number" id="destinationWarehouse" name="DestinationWarehouse" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Submit</button>
</form>
