@model CleanBrilliantCompany.Models.SupportTicket.SupportTicketSDM

@{
    ViewData["Title"] = "Support Ticket Details";
}

<h2>Support Ticket #@Model.TicketId</h2>

<table class="table">
    <tr>
        <th>Customer ID</th>
        <td>@Model.CustomerId</td>
    </tr>
    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>
    <tr>
        <th>Created At</th>
        <td>@Model.CreatedAt</td>
    </tr>
    <tr>
        <th>Ticket Details</th>
        <td>@Model.TicketDetails</td>
    </tr>
    <tr>
        <th>Resolution</th>
        <td>
            @if (Model.Status == "Reviewed")
            {
                @Model.ResolutionDetails
            }
            else
            {
                <form asp-action="updateSupportTicket" asp-route-ticketId="@Model.TicketId" method="post">
                    <textarea name="resolutionDetails" class="form-control" rows="3" required></textarea>
                    <br />
                    <button type="submit" class="btn btn-primary">Close Ticket</button>
                </form>
            }
        </td>
    </tr>
</table>
<a asp-action="SupportTicket" class="btn btn-secondary">Back to List</a>
