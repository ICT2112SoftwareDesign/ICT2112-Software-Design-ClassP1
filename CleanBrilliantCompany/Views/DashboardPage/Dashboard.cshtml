@{
    ViewData["Title"] = "Carbon Footprint Dashboard";
}

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Clean Brilliant Company</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<div class="container mt-5" style="max-width: 1000px;">
    <h2 class="text-center mb-4">Carbon Footprint Dashboard</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <button class="btn btn-primary mb-3" id="addRecordBtn" data-bs-toggle="modal" data-bs-target="#addCarbonFootprintModal">Add Carbon Footprint Record</button>

            <table class="table table-hover table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Entity ID</th>
                        <th>Entity Type</th>
                        <th>Carbon Emission (kg CO₂)</th>
                        <th>Eco Status</th>
                        <th>Date Created</th>
                    </tr>
                </thead>
                <tbody id="carbonFootprintTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Modal Form to add new Carbon Footprint Record-->
<div class="modal fade" id="addCarbonFootprintModal" tabindex="-1" aria-labelledby="addCarbonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCarbonModalLabel">Add Carbon Footprint Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addCarbonForm">
                    <div class="mb-3">
                        <label for="entityId" class="form-label">Entity ID</label>
                        <input type="number" class="form-control" id="entityId" required>
                    </div>
                    <div class="mb-3">
                        <label for="entityType" class="form-label">Entity Type</label>
                        <select class="form-select" id="entityType" required>
                            <option value="Product">Product</option>
                            <option value="Order">Order</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="carbonEmission" class="form-label">Carbon Emission</label>
                        <input type="number" step="0.01" class="form-control" id="carbonEmission" required>
                    </div>
                    <div class="mb-3">
                        <label for="ecoStatus" class="form-label">Eco Status</label>
                        <select class="form-select" id="ecoStatus" required>
                            <option value="Eco-Friendly">Eco-Friendly</option>
                            <option value="Not Eco-Friendly">Not Eco-Friendly</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="dateCreated" class="form-label">Date Created</label>
                        <input type="date" class="form-control" id="dateCreated" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" form="addCarbonForm">Add Record</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetch('/api/CarbonFootprintInput/all')
            .then(response => response.json())
            .then(data => {
                const tableBody = document.querySelector('#carbonFootprintTableBody');
                tableBody.innerHTML = '';

                data.forEach(item => {

                    const ecoBadge = item.ecoStatus === "Eco-Friendly" ? `<span class="badge bg-success">${item.ecoStatus}</span>` : `<span class="badge bg-danger">${item.ecoStatus}</span>`;
                    const row = `
                        <tr>
                            <td>${item.entityId}</td>
                            <td>${item.entityType}</td>
                            <td>${item.carbonEmission}</td>
                            <td>${ecoBadge}</td>
                            <td>${item.dateCreated}</td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            })
            .catch(error => console.error('Error loading carbon footprint data:', error));
    });

    document.getElementById('addCarbonForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const record = {
            entityId: parseInt(document.getElementById('entityId').value),
            entityType: document.getElementById('entityType').value,
            carbonEmission: parseFloat(document.getElementById('carbonEmission').value),
            ecoStatus: document.getElementById('ecoStatus').value,
            dateCreated: document.getElementById('dateCreated').value
        };

        fetch('/api/CarbonFootprintInput/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(record)
        })
        .then(response => {
            if (response.ok) {
                alert("Record added successfully!");
                var myModalEl = document.getElementById('addCarbonFootprintModal');
                var modal = bootstrap.Modal.getInstance(myModalEl);
                modal.hide(); 
                location.reload();
            } else {
                alert("Failed to add record.");
            }
        });
    });
</script>

