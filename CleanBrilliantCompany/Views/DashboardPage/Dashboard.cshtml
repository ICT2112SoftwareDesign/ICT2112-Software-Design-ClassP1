@{
    ViewData["Title"] = "Carbon Footprint Dashboard";
}

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Clean Brilliant Company</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<div class="container mt-5" style="max-width: 1000px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Carbon Footprint Dashboard</h2>
        <button class="btn btn-primary px-4 py-2 mb-2" id="addRecordBtn" data-bs-toggle="modal"
            data-bs-target="#addCarbonFootprintModal">Add Carbon Footprint Record</button>

        <!-- Feedback Button -->
        <button class="btn btn-primary px-4 py-2 mb-2 ms-2" onclick="location.href='@Url.Action("Index", "Feedback")'">
            Feedback
        </button>

        <!-- Manager View Feedback Button -->
        <button class="btn btn-primary px-4 py-2 mb-2 ms-2" onclick="location.href='@Url.Action("Index", "Manager")'">
            Manager View Feedback
        </button>

    </div>

    <table class="table table-hover table-striped table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>Entity ID</th>
                <th>Entity Type</th>
                <th>Carbon Emission (kg CO₂)</th>
                <th>Eco Status</th>
                <th>Date Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="carbonFootprintTableBody">
        </tbody>
    </table>
</div>

<!-- Edit Carbon Footprint Modal Form -->
<div class="modal fade" id="editCarbonFootprintModal" tabindex="-1" aria-labelledby="editCarbonModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCarbonModalLabel">Edit Carbon Footprint Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCarbonForm">
                    <input type="hidden" id="editCarbonFootprintId">

                    <div class="mb-3">
                        <label for="editEntityId" class="form-label">Entity ID</label>
                        <input type="text" class="form-control" id="editEntityId" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="editEntityType" class="form-label">Entity Type</label>
                        <input type="text" class="form-control" id="editEntityType" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="editCarbonEmission" class="form-label">Carbon Emission</label>
                        <input type="number" step="0.01" class="form-control" id="editCarbonEmission" required>
                    </div>
                    <div class="mb-3">
                        <label for="editEcoStatus" class="form-label">Eco Status</label>
                        <select class="form-select" id="editEcoStatus" required>
                            <option value="Eco-Friendly">Eco-Friendly</option>
                            <option value="Not Eco-Friendly">Not Eco-Friendly</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editDateCreated" class="form-label">Date Created</label>
                        <input type="date" class="form-control" id="editDateCreated" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" form="editCarbonForm">Update Record</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Form to add new Carbon Footprint Record-->
<div class="modal fade" id="addCarbonFootprintModal" tabindex="-1" aria-labelledby="addCarbonModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCarbonModalLabel">Add Carbon Footprint Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addCarbonForm">
                    <div class="mb-3">
                        <label for="entityId" class="form-label">Entity ID</label>
                        <input type="number" class="form-control" id="entityId" required>
                    </div>
                    <div class="mb-3">
                        <label for="entityType" class="form-label">Entity Type</label>
                        <select class="form-select" id="entityType" required>
                            <option value="Product">Product</option>
                            <option value="Order">Order</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="carbonEmission" class="form-label">Carbon Emission</label>
                        <input type="number" step="0.01" class="form-control" id="carbonEmission" required>
                    </div>
                    <div class="mb-3">
                        <label for="ecoStatus" class="form-label">Eco Status</label>
                        <select class="form-select" id="ecoStatus" required>
                            <option value="Eco-Friendly">Eco-Friendly</option>
                            <option value="Not Eco-Friendly">Not Eco-Friendly</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="dateCreated" class="form-label">Date Created</label>
                        <input type="date" class="form-control" id="dateCreated" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" form="addCarbonForm">Add Record</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetch('/api/CarbonFootprintInput/all')
            .then(response => response.json())
            .then(data => {
                const tableBody = document.querySelector('#carbonFootprintTableBody');
                tableBody.innerHTML = '';

                data.forEach(item => {

                    const ecoBadge = item.ecoStatus === "Eco-Friendly" ? `<span class="badge bg-success">${item.ecoStatus}</span>` : `<span class="badge bg-danger">${item.ecoStatus}</span>`;
                    const row = `
                        <tr data-id="${item.carbonFootprintId}" data-type="${item.entityType}">
                            <td>${item.entityId}</td>
                            <td>${item.entityType}</td>
                            <td>${item.carbonEmission}</td>
                            <td>${ecoBadge}</td>
                            <td>${item.dateCreated}</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-warning btn-sm px-3 py-1 edit-btn">Edit</button>
                                    <button class="btn btn-danger btn-sm px-3 py-1 delete-btn">Delete</button>
                                </div>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            })
            .catch(error => console.error('Error loading carbon footprint data:', error));
    });

    document.addEventListener('click', function (event) {
        if (event.target.classList.contains('edit-btn')) {
            const row = event.target.closest('tr');
            const carbonFootprintId = row.dataset.id;
            const entityId = row.cells[0].textContent;
            const entityType = row.dataset.type;
            const carbonEmission = row.cells[2].textContent;
            const ecoStatus = row.cells[3].textContent;
            const dateCreated = row.cells[4].textContent;

            console.log(`Editing ID: ${carbonFootprintId}, EntityId: ${entityId}, Type: ${entityType}`);

            document.getElementById('editCarbonFootprintId').value = carbonFootprintId;
            document.getElementById('editEntityId').value = entityId;
            document.getElementById('editEntityType').value = entityType;
            document.getElementById('editCarbonEmission').value = carbonEmission;
            document.getElementById('editEcoStatus').value = ecoStatus;
            document.getElementById('editDateCreated').value = dateCreated;

            var editModal = new bootstrap.Modal(document.getElementById('editCarbonFootprintModal'));
            editModal.show();
        }
    });

    document.getElementById('addCarbonForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const record = {
            entityId: parseInt(document.getElementById('entityId').value),
            entityType: document.getElementById('entityType').value,
            carbonEmission: parseFloat(document.getElementById('carbonEmission').value),
            ecoStatus: document.getElementById('ecoStatus').value,
            dateCreated: document.getElementById('dateCreated').value
        };

        fetch('/api/CarbonFootprintInput/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(record)
        })
            .then(response => {
                if (response.ok) {
                    alert("Record added successfully!");
                    var myModalEl = document.getElementById('addCarbonFootprintModal');
                    var modal = bootstrap.Modal.getInstance(myModalEl);
                    modal.hide();
                    location.reload();
                } else {
                    alert("Failed to add record.");
                }
            });
    });

    document.getElementById('editCarbonForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const record = {
            carbonFootprintId: parseInt(document.getElementById('editCarbonFootprintId').value),
            entityId: parseInt(document.getElementById('editEntityId').value),
            entityType: document.getElementById('editEntityType').value,
            carbonEmission: parseFloat(document.getElementById('editCarbonEmission').value),
            ecoStatus: document.getElementById('editEcoStatus').value,
            dateCreated: document.getElementById('editDateCreated').value
        };

        fetch(`/api/CarbonFootprintInput/update/${record.carbonFootprintId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(record)
        })
            .then(response => {
                if (response.ok) {
                    alert("Record updated successfully!");
                    var editModalEl = document.getElementById('editCarbonFootprintModal');
                    var editModal = bootstrap.Modal.getInstance(editModalEl);
                    editModal.hide();
                    location.reload();
                } else {
                    alert("Failed to update record.");
                }
            });
    });

    document.addEventListener('click', function (event) {
        if (event.target.classList.contains('delete-btn')) {
            const row = event.target.closest('tr');
            const carbonFootprintId = row.dataset.id;

            if (confirm("Are you sure you want to delete this record?")) {
                fetch(`/api/CarbonFootprintInput/delete/${carbonFootprintId}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            alert("Record deleted successfully!");
                            row.remove();
                        } else {
                            alert("Failed to delete record.");
                        }
                    });
            }
        }
    });
</script>
<style>
    .edit-btn,
    .delete-btn {
        border-radius: 5px;
        font-size: 14px;
        padding: 6px 12px;
    }

    .actions-column {
        text-align: center;
    }

    .table td,
    .table th {
        vertical-align: middle;
    }

    .table-dark th {
        background-color: #343a40 !important;
        color: white !important;
    }

    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    #addRecordBtn {
        background-color: #007bff;
        border-radius: 20px;
        transition: 0.3s;
    }

    #addRecordBtn:hover {
        background-color: #0056b3;
    }
</style>
