<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @* <!-- Custom fonts for this template-->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> *@

</head>

<body id="page-top">

    <!-- Page Heading -->
    @* <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Carbon Footprint Dashboard</h1>
        <a href="/EcoFriendlyReport" class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm">
            <i class="fas fa-download fa-sm text-white-50"></i> Generate Report
        </a>
    </div> *@
    <!-- Right-aligned Buttons -->
    <div class="d-flex flex-column align-items-end">
        <div>
            <a href="/feedback" class="btn btn-sm btn-primary shadow-sm mr-2">
                <i class="fas fa-comment-dots fa-sm text-white-50"></i> Feedback
            </a>
            <a href="/manager" class="btn btn-sm btn-info shadow-sm mr-2">
                <i class="fas fa-eye fa-sm text-white-50"></i> Manager View Feedback
            </a>
            <a href="/dashboardpage/ecofriendlyreport" class="btn btn-sm btn-success shadow-sm">
                <i class="fas fa-download fa-sm text-white-50"></i> Generate Report
            </a>
        </div>
        <button id="toggleButton" class="btn btn-sm btn-secondary shadow-sm mt-2">
            <i class="fas fa-cogs fa-sm text-white-50"></i> Show/Hide Backend Mockup Features
        </button>
    </div>

    <!-- Section to be toggled -->
    <div id="carbonCalculatorSection" style="display: none;">
        <div class="button-row">
            <button onclick="createNewProduct()">Create Product (Mockup)</button>
            <button type="button" onclick="calculateItemCarbonFootprint()">Calculate Item Carbon Footprint</button>
            <button onclick="updateItemsCFDaily()">Calculate All Items CF Daily</button>
            <button onclick="calculateShipmentCF()">Calculate Shipment CF</button>
        </div>

        <div>
            <form>
                <label for="ProductDropdown">Select Product</label>
                <select id="ProductDropdown">
                    @foreach (var product in Model.ProductList) // Assuming a list of products in the model
                    {
                        <option value="@product.ProductId">@product.ProductName with product ID of @product.ProductId and carbon emission value: @product.CarbonFootprint</option>
                    }
                </select>

                <label for="ItemDropdown">Select Item</label>
                <select id="ItemDropdown">
                    @foreach (var item in Model.ItemList) // Assuming a list of items in the model
                    {
                        <option value="@item.getItemId()">Item #@item.getItemId() with product ID of @item.getProductId()</option>
                    }
                </select>

                <label for="StubOrderDropdown">Select Stub Order</label>
                <select id="StubOrderDropdown">
                    @foreach (var order in Model.StubOrderList) // Assuming a list of items in the model
                    {
                        <option value="@order.GetOrderID()" data-address="@order.GetOrderAddress()">Order #@order.GetOrderID() with address of @order.GetOrderAddress()</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col">
            <h3 class="text-primary fw-bold text-dark">🧾 Carbon Emission Overview</h3>
            <hr />
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row">
        <!-- Total Product CF Card -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2 summary-card">
                <div class="card-body" onclick="toggleAllPanels()">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                        Total Product Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalProductCF kg CO₂</div>
                    <div class="text-xs text-muted">Past 1 Year</div>
                    <div id="productDetails" class="embedded-panel" style="display:none; margin-top:10px;">
                        <hr />
                        <p><strong>Past Week:</strong> @Model.ProductPastWeekCF kg CO₂</p>
                        <p><strong>Past Month:</strong> @Model.ProductPastMonthCF kg CO₂</p>
                    </div>
                </div>
            </div>
            </div>

        <!-- Total Item CF Card -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2 summary-card">
                <div class="card-body" onclick="toggleAllPanels()">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                        Total Item Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalItemCF kg CO₂</div>
                    <div class="text-xs text-muted">Past 1 Year</div>
                    <div id="itemDetails" class="embedded-panel" style="display:none; margin-top:10px;">
                        <hr />
                        <p><strong>Past Week:</strong> @Model.ItemPastWeekCF kg CO₂</p>
                        <p><strong>Past Month:</strong> @Model.ItemPastMonthCF kg CO₂</p>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Order CF Card -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2 summary-card">
                <div class="card-body" onclick="toggleAllPanels()">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                        Total Order Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalOrderCF kg CO₂</div>
                    <div class="text-xs text-muted">Past 1 Year</div>
                    <div id="orderDetails" class="embedded-panel" style="display:none; margin-top:10px;">
                        <hr />
                        <p><strong>Past Week:</strong> @Model.OrderPastWeekCF kg CO₂</p>
                        <p><strong>Past Month:</strong> @Model.OrderPastMonthCF kg CO₂</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Trend Line Chart -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Total Carbon Emission Trend</h6>
                </div>
                <div class="card-body">
                    <div class="btn-group mb-3" role="group" aria-label="Trend View Toggle">
                        <button class="btn btn-outline-primary active" id="toggle-monthly">Monthly</button>
                        <button class="btn btn-outline-primary" id="toggle-weekly">Weekly</button>
                        <button class="btn btn-outline-primary" id="toggle-daily">Daily</button>
                    </div>
                    <canvas id="carbonTrendChart" class="shared-chart-size"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Product Eco Breakdown Pie -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Product Eco Breakdown</h6>
                </div>
                <div class="card-body">
                    <canvas id="productEcoPieChart" class="shared-chart-size"></canvas>
                </div>
            </div>
        </div>

        <!-- Order Transport Mode Pie -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Order Transport Mode</h6>
                </div>
                <div class="card-body">
                    <canvas id="transportModePieChart" class="shared-chart-size"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Product Category Emissions</h6>
                </div>
                <div class="card-body">
                    <canvas id="categoryBreakdownChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col">
            <h3 class="text-primary fw-bold text-dark">🏆 Best & Worst Performing Products</h3>
            <hr />
        </div>
    </div>
    
    <div class="row">
        <div class="col-xl-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 5 Eco-Efficient Products</h6>
                </div>
                <div class="card-body">
                        <canvas id="ecoLeaderboardChart" style="height:300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
        <div class="card shadow mb-4">
            <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Top 5 Highest Emission Products</h6>
            </div>
            <div class="card-body">
                <canvas id="topEmittingProductsChart" style="height:300px;"></canvas>
            </div>
        </div>

    <div class="row mt-5">
        <div class="col">
            <h3 class="text-primary fw-bold text-dark">📈 Trends & Eco Adoption</h3>
            <hr />
        </div>
    </div>

    <!-- Eco Product Trend Chart -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Eco Product Trend (Adoption Over Time)</h6>
        </div>
        <div class="card-body">
            <canvas id="ecoProductTrendChart" class="shared-chart-size"></canvas>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Eco vs Non-Eco Item Count Over Time</h6>
        </div>
        <div class="card-body">
            <canvas id="ecoNonEcoItemChart"></canvas>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col">
            <h3 class="text-primary fw-bold text-dark">📦 Product-Item Analysis</h3>
            <hr />
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Items per Product Emission Breakdown</h6>
        </div>
        <div class="card-body">
            <canvas id="itemEmissionBreakdownChart"></canvas>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col">
            <h3 class="text-primary fw-bold text-dark">🚚 Transport & Logistics Insights</h3>
            <hr />
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Carbon Emission by Transport Mode</h6>
        </div>
        <div class="card-body">
            <canvas id="transportEmissionChart" class="shared-chart-size"></canvas>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Emission per km per Transport Mode</h6>
        </div>
        <div class="card-body">
            <canvas id="emissionPerKmChart" class="shared-chart-size"></canvas>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Emission vs Distance by Transport Mode</h6>
        </div>
        <div class="card-body">
            <canvas id="emissionDistanceScatterChart" class="shared-chart-size"></canvas>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Emission vs Order Weight</h6>
        </div>
        <div class="card-body">
            <canvas id="emissionWeightScatterChart" class="shared-chart-size"></canvas>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Emission Efficiency (kg CO₂ / kg shipped)</h6>
        </div>
        <div class="card-body">
            <canvas id="emissionEfficiencyChart" class="shared-chart-size"></canvas>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col">
            <h3 class="text-primary fw-bold text-dark">Carbon Footprint Comparison Tool</h3>
            <hr />
        </div>
    </div>

    <!-- Comparison Tool -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Carbon Footprint Comparison</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <!-- Date Range Filter -->
                        <div class="col-12 mb-4">
                            <h6 class="font-weight-bold">Date Range:</h6>
                            <div class="d-flex">
                                <input type="date" id="startDate" class="form-control mr-2" onchange="updateAllTables()">
                                <input type="date" id="endDate" class="form-control" onchange="updateAllTables()">
                            </div>
                        </div>

                        <!-- Product Comparison -->
                        <div class="col-md-6">
                            <h6 class="font-weight-bold">Product Comparison</h6>
                            <div class="form-group">
                                <label>Select Products to Compare:</label>
                                <div class="border p-3 rounded bg-light product-checkboxes" style="height: 200px; overflow-y: auto;">
                                    @foreach (var product in Model.Products)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input product-checkbox" 
                                                id="product_@product.ProductId" 
                                                value="@product.ProductId"
                                                data-name="@product.ProductName"
                                                data-emission="@product.CarbonEmission">
                                            <label class="custom-control-label" for="product_@product.ProductId">
                                                @product.ProductName - @product.CarbonEmission kg CO₂
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <button class="btn btn-outline-secondary" onclick="selectAllProducts()">Select All</button>
                                </div>
                                <div>
                                    <button class="btn btn-outline-secondary mr-2" onclick="clearProductSelection()">Clear Selection</button>
                                    <button class="btn btn-primary" onclick="compareProducts()">Compare Products</button>
                                </div>
                            </div>
                        </div>

                        <!-- Shipping Comparison -->
                        <div class="col-md-6">
                            <h6 class="font-weight-bold">Shipping Method Comparison</h6>
                            <div class="form-group">
                                <label>Select Shipping Methods to Compare:</label>
                                <div class="border p-3 rounded bg-light shipping-checkboxes" style="height: 200px; overflow-y: auto;">
                                    @foreach (var method in Model.ShippingMethods)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input shipping-checkbox" 
                                                id="shipping_@method.TransportMode" 
                                                value="@method.TransportMode"
                                                data-name="@method.TransportMode"
                                                data-emission="@method.AverageCarbonEmission">
                                            <label class="custom-control-label" for="shipping_@method.TransportMode">
                                                @method.TransportMode - @method.AverageCarbonEmission.ToString("F2") kg CO₂
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <button class="btn btn-outline-secondary" onclick="selectAllShipping()">Select All</button>
                                </div>
                                <div>
                                    <button class="btn btn-outline-secondary mr-2" onclick="clearShippingSelection()">Clear Selection</button>
                                    <button class="btn btn-primary" onclick="compareShippingMethods()">Compare Shipping</button>
                                </div>
                            </div>
                        </div>
                    </div> 

                    <!-- Comparison Charts Row -->
                    <div class="row">
                        <div class="col-md-6">
                            <canvas id="productComparisonChart" class="shared-chart-size"></canvas>
                            <div id="productInsights" class="mt-3"></div>
                        </div>
                        <div class="col-md-6">
                            <canvas id="shippingComparisonChart" class="shared-chart-size"></canvas>
                            <div id="shippingInsights" class="mt-3"></div>
                        </div>
                    </div> 
                </div> 
            </div> 
        </div> 
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get current date and first day of previous month
            const today = new Date();
            const firstDayOfPrevMonth = new Date(today.getFullYear(), today.getMonth() - 1, 2);
            
            // Format dates for input fields (YYYY-MM-DD)
            const todayStr = today.toISOString().split('T')[0];
            const firstDayOfPrevMonthStr = firstDayOfPrevMonth.toISOString().split('T')[0];

            // Set default values for date inputs
            document.getElementById('startDate').value = firstDayOfPrevMonthStr;
            document.getElementById('endDate').value = todayStr;

            // Trigger the initial updates
            updateAllTables();
        });

        document.getElementById("toggleButton").addEventListener("click", function () {
            var section = document.getElementById("carbonCalculatorSection");
            if (section.style.display === "none") {
                section.style.display = "block";
                this.textContent = "Hide Mockup Backend Calculator Features";
            } else {
                section.style.display = "none";
                this.textContent = "Show Mockup Backend Calculator Features";
            }
        });

        function createNewProduct() {
            $.ajax({
                url: '@Url.Action("CreateProduct", "DashboardPage")', // ASP.NET MVC URL helper
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        // Update the dropdown with the new product's name
                        $("#ProductDropdown").append(new Option(response.productName, response.productId, response.carbonFootprint));
                    } else {
                        alert("Failed to create product.");
                    }
                },
                error: function() {
                    alert("Error creating product.");
                }
            });
        }

        function calculateItemCarbonFootprint() {
            var itemId = parseInt(document.getElementById("ItemDropdown").value, 10);

            $.ajax({
                url: '@Url.Action("CalculateItem", "DashboardPage")',
                type: 'POST',
                data: { itemId: itemId }, // Send itemId as JSON
                success: function(response) {
                    if (response.success) {
                        alert("Item carbon footprint has been calculated and stored in Item CF DB.")
                    } else {
                        alert("Failed to calculate carbon footprint.");
                    }
                },
                error: function() {
                    alert("Error calculating carbon footprint.");
                }
            });
        }

        function updateItemsCFDaily(){
            $.ajax({
                url: '@Url.Action("UpdateItemsCFDaily", "DashboardPage")',
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        alert("Items' carbon footprint has been updated.");

                        // Update UI with new values
                        document.getElementById("TotalItemCF").innerText = response.updatedViewModel.totalItemCF;
                        document.getElementById("ItemPastWeekCF").innerText = response.updatedViewModel.itemPastWeekCF;
                        document.getElementById("ItemPastMonthCF").innerText = response.updatedViewModel.itemPastMonthCF;
                    } else {
                        alert("Failed to update item carbon footprints.");
                    }
                },
                error: function() {
                    alert("Error calculating carbon footprint.");
                }
            });
        }

        function calculateShipmentCF() {
            var dropdown = document.getElementById("StubOrderDropdown");
            var orderId = parseInt(dropdown.value, 10);
            var orderAddress = dropdown.options[dropdown.selectedIndex].getAttribute("data-address"); // Get address

            $.ajax({
                url: '@Url.Action("CalculateOrder", "DashboardPage")',
                type: 'POST',
                data: { orderId: orderId, orderAddress: orderAddress }, // Send itemId as JSON
                success: function(response) {
                    if (response.success) {
                        alert("Order carbon footprint = " + response.totalCarbon + "CO2e, and stored in Order CF DB.")
                    } else {
                        alert("Failed to calculate carbon footprint.");
                    }
                },
                error: function() {
                    alert("Error calculating carbon footprint.");
                }
            });
        }

        function updateAllTables() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                alert('Start date cannot be after end date');
                return;
            }

            // Update both tables
            updateProductTable(startDate, endDate);
            updateShippingTable(startDate, endDate);
        }

        function updateProductTable(startDate, endDate) {
            $.ajax({
                url: '@Url.Action("GetFilteredProducts", "DashboardPage")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    startDate: startDate,
                    endDate: endDate
                }),
                success: function(response) {
                    if (response.success) {
                        const productCheckboxes = document.querySelector('.product-checkboxes');
                        productCheckboxes.innerHTML = response.products.map(product => `
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input product-checkbox" 
                                    id="product_${product.productId}" 
                                    value="${product.productId}"
                                    data-name="${product.productName}"
                                    data-emission="${product.carbonEmission}">
                                <label class="custom-control-label" for="product_${product.productId}">
                                    ${product.productName} - ${product.carbonEmission.toFixed(2)} kg CO₂
                                </label>
                            </div>
                        `).join('');
                    } else {
                        alert('Failed to fetch filtered products: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error fetching filtered products: ' + error);
                }
            });
        }

        function updateShippingTable(startDate, endDate) {
            $.ajax({
                url: '@Url.Action("GetFilteredShippingMethods", "DashboardPage")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    startDate: startDate,
                    endDate: endDate
                }),
                success: function(response) {
                    if (response.success) {
                        const shippingCheckboxes = document.querySelector('.shipping-checkboxes');
                        shippingCheckboxes.innerHTML = response.shippingMethods.map(method => `
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input shipping-checkbox" 
                                    id="shipping_${method.transportMode}" 
                                    value="${method.transportMode}"
                                    data-name="${method.transportMode}"
                                    data-emission="${method.averageCarbonEmission}">
                                <label class="custom-control-label" for="shipping_${method.transportMode}">
                                    ${method.transportMode} - ${method.averageCarbonEmission.toFixed(2)} kg CO₂
                                </label>
                            </div>
                        `).join('');
                    } else {
                        alert('Failed to fetch filtered shipping methods: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error fetching filtered shipping methods: ' + error);
                }
            });
        }

        function compareProducts() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert('Please select both start and end dates');
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                alert('Start date cannot be after end date');
                return;
            }

            const selectedProducts = Array.from(document.querySelectorAll('.product-checkbox:checked'))
                .map(checkbox => ({
                    name: checkbox.dataset.name,
                    value: checkbox.value
                }));

            if (selectedProducts.length === 0) {
                alert('Please select at least one product to compare');
                return;
            }

            // Make AJAX call to get filtered data
            $.ajax({
                url: '@Url.Action("GetFilteredProductData", "DashboardPage")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    startDate: startDate,
                    endDate: endDate,
                    productIds: selectedProducts.map(p => p.value)
                }),
                success: function(response) {
                    if (response.success) {
                        updateProductComparisonChart(response.data);
                    } else {
                        alert('Failed to fetch filtered data: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error fetching filtered data: ' + error);
                }
            });
        }

        function compareShippingMethods() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert('Please select both start and end dates');
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                alert('Start date cannot be after end date');
                return;
            }

            const selectedMethods = Array.from(document.querySelectorAll('.shipping-checkbox:checked'))
                .map(checkbox => ({
                    name: checkbox.dataset.name,
                    value: checkbox.value
                }));

            if (selectedMethods.length === 0) {
                alert('Please select at least one shipping method to compare');
                return;
            }

            // Make AJAX call to get filtered data
            $.ajax({
                url: '@Url.Action("GetFilteredShippingData", "DashboardPage")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    startDate: startDate,
                    endDate: endDate,
                    shippingMethods: selectedMethods.map(m => m.value)
                }),
                success: function(response) {
                    if (response.success) {
                        updateShippingComparisonChart(response.data);
                    } else {
                        alert('Failed to fetch filtered data: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error fetching filtered data: ' + error);
                }
            });
        }

