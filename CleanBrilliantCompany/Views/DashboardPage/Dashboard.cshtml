<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    @* <!-- Custom fonts for this template-->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> *@

</head>

<body id="page-top">

    <!-- Page Heading -->
    @* <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Carbon Footprint Dashboard</h1>
        <a href="/EcoFriendlyReport" class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm">
            <i class="fas fa-download fa-sm text-white-50"></i> Generate Report
        </a>
    </div> *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Carbon Footprint Dashboard</h1>
        <div>
            <a href="/feedback" class="btn btn-sm btn-primary shadow-sm mr-2">
                <i class="fas fa-comment-dots fa-sm text-white-50"></i> Feedback
            </a>
            <a href="/manager" class="btn btn-sm btn-info shadow-sm mr-2">
                <i class="fas fa-eye fa-sm text-white-50"></i> Manager View Feedback
            </a>
            <a href="#" class="btn btn-sm btn-success shadow-sm">
                <i class="fas fa-download fa-sm text-white-50"></i> Generate Report
            </a>
        </div>
    </div>


    <!-- Summary Cards -->
    <div class="row">
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                        Total Product Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalProductCF kg CO₂</div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                        Total Item Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalItemCF kg CO₂</div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                        Total Order Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalOrderCF kg CO₂</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart Row -->
    <div class="row">
        <!-- Product Eco Breakdown Pie -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Product Eco Breakdown</h6>
                </div>
                <div class="card-body">
                    <canvas id="productEcoPieChart" class="shared-chart-size"></canvas>
                </div>
            </div>
        </div>

        <!-- Order Transport Mode Pie -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Order Transport Mode</h6>
                </div>
                <div class="card-body">
                    <canvas id="transportModePieChart" class="shared-chart-size"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Trend Line Chart -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Carbon Emission Trend</h6>
                </div>
                <div class="card-body">
                    <div class="btn-group mb-3" role="group" aria-label="Trend View Toggle">
                        <button class="btn btn-outline-primary active" id="toggle-monthly">Monthly</button>
                        <button class="btn btn-outline-primary" id="toggle-weekly">Weekly</button>
                        <button class="btn btn-outline-primary" id="toggle-daily">Daily</button>
                    </div>
                    <canvas id="carbonTrendChart" class="shared-chart-size"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Tool -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Carbon Footprint Comparison</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <!-- Product Comparison -->
                        <div class="col-md-6">
                            <h6 class="font-weight-bold">Product Comparison</h6>
                            <div class="form-group">
                                <label>Select Products to Compare:</label>
                                <div class="border p-3 rounded bg-light product-checkboxes" style="height: 200px; overflow-y: auto;">
                                    @foreach (var product in Model.Products)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input product-checkbox" 
                                                id="product_@product.ProductId" 
                                                value="@product.ProductId"
                                                data-name="@product.ProductName"
                                                data-emission="@product.CarbonEmission">
                                            <label class="custom-control-label" for="product_@product.ProductId">
                                                @product.ProductName - @product.CarbonEmission kg CO₂
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="text-right">
                                <button class="btn btn-outline-secondary mr-2" onclick="clearProductSelection()">Clear Selection</button>
                                <button class="btn btn-primary" onclick="compareProducts()">Compare Products</button>
                            </div>
                        </div>

                        <!-- Shipping Comparison -->
                        <div class="col-md-6">
                            <h6 class="font-weight-bold">Shipping Method Comparison</h6>
                            <div class="form-group">
                                <label>Select Shipping Methods to Compare:</label>
                                <div class="border p-3 rounded bg-light shipping-checkboxes" style="height: 200px; overflow-y: auto;">
                                    @foreach (var method in Model.ShippingMethods)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input shipping-checkbox" 
                                                id="shipping_@method.TransportMode" 
                                                value="@method.TransportMode"
                                                data-name="@method.TransportMode"
                                                data-emission="@method.AverageCarbonEmission">
                                            <label class="custom-control-label" for="shipping_@method.TransportMode">
                                                @method.TransportMode - @method.AverageCarbonEmission kg CO₂
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="text-right">
                                <button class="btn btn-outline-secondary mr-2" onclick="clearShippingSelection()">Clear Selection</button>
                                <button class="btn btn-primary" onclick="compareShippingMethods()">Compare Shipping</button>
                            </div>
                        </div>
                    </div> 

                    <!-- Comparison Charts Row -->
                    <div class="row">
                        <div class="col-md-6">
                            <canvas id="productComparisonChart" class="shared-chart-size"></canvas>
                            <div id="productInsights" class="mt-3"></div>
                        </div>
                        <div class="col-md-6">
                            <canvas id="shippingComparisonChart" class="shared-chart-size"></canvas>
                            <div id="shippingInsights" class="mt-3"></div>
                        </div>
                    </div> 
                </div> 
            </div> 
        </div> 
    </div> 

    <script>
        const ecoProductData = {
            labels: ["Eco-Friendly", "Not Eco-Friendly"],
            values: [@Model.EcoFriendlyProductCount, @Model.NonEcoFriendlyProductCount]
        };

        const transportModeData = {
            labels: @Html.Raw(Json.Serialize(Model.OrderTransportBreakdown.Keys)),
            values: @Html.Raw(Json.Serialize(Model.OrderTransportBreakdown.Values))
        };

        const trendDataDaily = {
            labels: @Html.Raw(Json.Serialize(Model.EmissionTrendDaily.Keys)),
            values: @Html.Raw(Json.Serialize(Model.EmissionTrendDaily.Values))
        };
        const trendDataWeekly = {
            labels: @Html.Raw(Json.Serialize(Model.EmissionTrendWeekly.Keys)),
            values: @Html.Raw(Json.Serialize(Model.EmissionTrendWeekly.Values))
        };
        const trendDataMonthly = {
            labels: @Html.Raw(Json.Serialize(Model.EmissionTrendMonthly.Keys)),
            values: @Html.Raw(Json.Serialize(Model.EmissionTrendMonthly.Values))
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctxProduct = document.getElementById("productEcoPieChart").getContext("2d");

        new Chart(ctxProduct, {
            type: 'pie',
            data: {
                labels: ecoProductData.labels,
                datasets: [{
                    label: "Product Eco Status",
                    data: ecoProductData.values,
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(255, 99, 132, 0.6)'
                    ],
                    borderColor: [
                        'rgba(75, 192, 192, 1)',
                        'rgba(255, 99, 132, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top' },
                    title: {
                        display: true,
                        text: 'Product Eco Breakdown'
                    }
                }
            }
        });

        const ctxTransport = document.getElementById("transportModePieChart").getContext("2d");

        new Chart(ctxTransport, {
            type: 'pie',
            data: {
                labels: transportModeData.labels,
                datasets: [{
                    label: "Transport Mode",
                    data: transportModeData.values,
                    backgroundColor: [
                        'rgba(255, 159, 64, 0.6)',
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(153, 102, 255, 0.6)'
                    ],
                    borderColor: [
                        'rgba(255, 159, 64, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(153, 102, 255, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top' },
                    title: {
                        display: true,
                        text: 'Order Transport Mode Breakdown'
                    }
                }
            }
        });

        let trendChart;

        function renderTrendChart(labels, values) {
            const ctx = document.getElementById("carbonTrendChart").getContext("2d");

            if (trendChart) {
                trendChart.destroy();
            }

            trendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Carbon Emission (kg CO₂)',
                        data: values,
                        backgroundColor: 'rgba(75, 192, 192, 0.3)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        renderTrendChart(trendDataMonthly.labels, trendDataMonthly.values);

        document.getElementById("toggle-daily").addEventListener("click", () => {
            setActiveButton("toggle-daily");
            renderTrendChart(trendDataDaily.labels, trendDataDaily.values);
        });
        document.getElementById("toggle-weekly").addEventListener("click", () => {
            setActiveButton("toggle-weekly");
            renderTrendChart(trendDataWeekly.labels, trendDataWeekly.values);
        });
        document.getElementById("toggle-monthly").addEventListener("click", () => {
            setActiveButton("toggle-monthly");
            renderTrendChart(trendDataMonthly.labels, trendDataMonthly.values);
        });

        function setActiveButton(activeId) {
            ["toggle-daily", "toggle-weekly", "toggle-monthly"].forEach(id => {
                document.getElementById(id).classList.remove("active");
            });
            document.getElementById(activeId).classList.add("active");
        }

        let productComparisonChart;
        let shippingComparisonChart;

        function compareProducts() {
            const selectedProducts = Array.from(document.querySelectorAll('.product-checkbox:checked'))
                .map(checkbox => ({
                    name: checkbox.dataset.name,
                    value: parseFloat(checkbox.dataset.emission)
                }));

            if (selectedProducts.length === 0) {
                alert('Please select at least one product to compare');
                return;
            }

            const ctx = document.getElementById('productComparisonChart').getContext('2d');

            if (productComparisonChart) {
                productComparisonChart.destroy();
            }

            productComparisonChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: selectedProducts.map(p => p.name),
                    datasets: [{
                        label: 'Carbon Emission (kg CO₂)',
                        data: selectedProducts.map(p => p.value),
                        backgroundColor: 'rgba(75, 192, 192, 0.6)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Carbon Emission (kg CO₂)'
                            }
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: 'Product Carbon Footprint Comparison'
                        }
                    }
                }
            });
        }

        function compareShippingMethods() {
            const selectedMethods = Array.from(document.querySelectorAll('.shipping-checkbox:checked'))
                .map(checkbox => ({
                    name: checkbox.dataset.name,
                    value: parseFloat(checkbox.dataset.emission)
                }));

            if (selectedMethods.length === 0) {
                alert('Please select at least one shipping method to compare');
                return;
            }

            const ctx = document.getElementById('shippingComparisonChart').getContext('2d');

            if (shippingComparisonChart) {
                shippingComparisonChart.destroy();
            }

            shippingComparisonChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: selectedMethods.map(m => m.name),
                    datasets: [{
                        label: 'Carbon Emission (kg CO₂)',
                        data: selectedMethods.map(m => m.value),
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Carbon Emission (kg CO₂)'
                            }
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: 'Shipping Method Carbon Footprint Comparison'
                        }
                    }
                }
            });
        }

        function clearProductSelection() {
            document.querySelectorAll('.product-checkbox').forEach(cb => {
                cb.checked = false;
            });

            // Clear chart
            if (productComparisonChart) {
                productComparisonChart.destroy();
            }
            const ctx = document.getElementById('productComparisonChart').getContext('2d');
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
        }

        function clearShippingSelection() {
            document.querySelectorAll('.shipping-checkbox').forEach(cb => {
                cb.checked = false;
            });

            // Clear chart
            if (shippingComparisonChart) {
                shippingComparisonChart.destroy();
            }
            const ctx = document.getElementById('shippingComparisonChart').getContext('2d');
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
        }
    </script>
</body>

</html>