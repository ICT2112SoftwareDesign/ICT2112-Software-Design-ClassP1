<body id="page-top">

    <!-- Page Heading -->
    @* <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Eco-friendly Report</h1>
        <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm">
            <i class="fas fa-download fa-sm text-white-50"></i> Generate Report
        </a>
    </div> *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Eco-friendly Report</h1>
        <div>
            <a href="/feedback" class="btn btn-sm btn-primary shadow-sm mr-2">
                <i class="fas fa-comment-dots fa-sm text-white-50"></i> Feedback
            </a>
            <a href="/manager" class="btn btn-sm btn-info shadow-sm mr-2">
                <i class="fas fa-eye fa-sm text-white-50"></i> Manager View Feedback
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row">
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                        Total Item Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalItemCF kg CO₂</div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                        Total Eco-friendly Item Carbon Footprint
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalEcoFriendlyItemCF kg CO₂</div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                        Proportion of all item emissions contributed by eco-friendly items
                    </div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.EcoFriendlyCFPercentage% </div>
                </div>
            </div>
        </div>
    </div>

<!-- Eco-Friendly Item Emissions Table -->
    <div class="card p-4 mt-4 shadow-sm">
        <h4>Eco-Friendly Item Emissions</h4>
        <div class="mx-4">
            <input class="form-check-input" id="include_checkbox" type="checkbox" id="includeNonEcoFriendly">
            <label class="form-check-label" for="include_checkbox">Include non-eco friendly products</label><br>
        </div>
        <table id="carbonTable" class="display" style="width:100%">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Product Base Emission (kg CO₂)</th>
                    <th>Eco-friendly Status</th>
                    <th>Item Count</th>
                    <th>Avg Per-Item Emission (kg CO₂)</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    <script>
        const data = @Html.Raw(Json.Serialize(Model.ItemCarbonFootprints));
        var table;
        var tableData = data.filter((data) => data.ecoStatus === "Eco-Friendly");
        function addData() {
            tableData.forEach(item => {
                        table.row.add([
                            item.name,
                            `${item.baseEmission} kg CO₂`,
                            `${item.ecoStatus}`,
                            `${item.numOfProductItems}`,
                            `${item.averagePerItemEmission} kg CO₂`
                        ]).draw(false);
                    });
        }
        function loadTable() {
            table = $('#carbonTable').DataTable({
                        columnDefs: [
                            { width: "30%", targets: 0 },
                            { width: "20%", targets: 1 },
                            { width: "17.5%", targets: 2 },
                            { width: "12.5%", className: 'dt-head-left dt-body-left', targets: 3 },
                            { width: "20%", targets: 4 }
                        ]
                    });
                    addData();
         }
         
        document.getElementById("include_checkbox").addEventListener("change", function() {
            table.clear();
            
            if(this.checked) {
                tableData = data;
            } else {
                tableData = data.filter((data) => data.ecoStatus === "Eco-Friendly");
            }
            addData();
            table.draw();
        });
        $(document).ready(function () {
            loadTable();
        });
    </script>
    <script>
 
    </script>
    @* <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> *@
    <script>

    </script>
</body>

</html>