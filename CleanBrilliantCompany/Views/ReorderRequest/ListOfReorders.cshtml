@model IEnumerable<CleanBrilliantCompany.Models.ReorderRequest>

<h1>List of Reorder Requests</h1>
<a asp-controller="ReorderRequest" asp-action="ReorderForm">Create New Reorder Request</a>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product ID</th>
            <th>Quantity</th>
            <th>Manufacturer ID</th>
            <th>Expected Delivery Date</th>
            <th>Status</th>
            <th>Defect Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.reorderId</td>
                <td>@order.ProductId</td>
                <td>@order.Quantity</td>
                <td>@order.ManufacturerId</td>
                <td>@order.ExpectedDeliveryDate.ToString("yyyy-MM-dd")</td>
                <td>@order.Status</td>
                <td>@order.DefectQuantity</td>
                <td>
                    <a asp-action="ReorderDetails" asp-route-id="@order.reorderId">View Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
