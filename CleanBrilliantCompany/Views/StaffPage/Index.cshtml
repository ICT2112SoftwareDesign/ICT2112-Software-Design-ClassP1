@{
    ViewData["Title"] = "Order Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml"; // Specify the layout if needed
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Order Dashboard</title>

    <!-- Custom styles -->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> 
</head>

<body id="page-top">
    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Include the sidebar -->
        @await Html.PartialAsync("~/Views/Staff/staff-sidebar.cshtml")

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Begin Page Content -->
                <div class="container-fluid mt-4">
                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">Order Dashboard</h1>
                        <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm"
                            onclick="location.reload();">
                            <i class="fas fa-sync fa-sm text-white-50"></i> Refresh Data
                        </a>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            <strong>Error:</strong> @ViewBag.ErrorMessage
                        </div>
                    }

                    <!-- Dashboard Cards Row -->
                    <div class="row">
                        <!-- Total Orders Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-primary shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                                Total Orders</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @(ViewBag.Metrics?.TotalOrders ?? 0)
                                            </div>
                                            @if (ViewBag.Metrics?.LatestOrderId != null)
                                            {
                                                <div class="mt-1">
                                                    <small class="text-muted">Latest:
                                                        #@ViewBag.Metrics?.LatestOrderId</small>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-shopping-cart fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total Refunds Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-danger shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                                Total Refunds</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @(ViewBag.Metrics?.TotalRefunds ?? 0)
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-undo fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Net Revenue Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-success shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                                Net Revenue</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @(ViewBag.Metrics?.NetRevenue ?? "$0.00")
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pending Refunds Card -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-warning shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                                Pending Refunds</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @(ViewBag.Metrics?.PendingRefunds ?? 0)
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.container-fluid -->
                <!-- Add this right below the Page Heading div -->
                <!-- Month Filter -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <form id="monthFilterForm" method="get" class="form-inline">
                            <div class="form-group mr-2">
                                <label for="monthSelect" class="mr-2">Filter by Month:</label>
                                <select id="monthSelect" name="month" class="form-control mr-2">
                                    @foreach (var month in ViewBag.AvailableMonths)
                                    {
                                        var isSelected = month.Year == ViewBag.ChartData?.SelectedYear &&
                                        month.Month == ViewBag.ChartData?.SelectedMonth;
                                        <option value="@month.Month" data-year="@month.Year" selected="@isSelected">
                                            @month.DisplayName
                                        </option>
                                    }
                                </select>
                                <input type="hidden" id="yearSelect" name="year"
                                    value="@ViewBag.ChartData?.SelectedYear" />
                            </div>
                            <button type="submit" class="btn btn-primary">Apply Filter</button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Charts Row -->
            <div class="row mt-4">
                <!-- Daily Orders Line Chart -->
                <div class="col-xl-6 col-lg-6">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                            <h6 class="m-0 font-weight-bold text-primary">Daily Orders -
                                @ViewBag.ChartData?.CurrentMonth</h6>
                        </div>
                        <div class="card-body">
                            <div class="chart-area">
                                <canvas id="dailyOrdersChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Profit Pie Chart -->
                <div class="col-xl-6 col-lg-6">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                            <h6 class="m-0 font-weight-bold text-primary">Profit Breakdown -
                                @ViewBag.ChartData?.CurrentMonth</h6>
                        </div>
                        <div class="card-body">
                            <div class="chart-pie pt-4 pb-2">
                                <canvas id="profitPieChart"></canvas>
                            </div>
                            <div class="mt-4 text-center small">
                                <span class="mr-2">
                                    <i class="fas fa-circle text-success"></i> Gross Profit
                                </span>
                                <span class="mr-2">
                                    <i class="fas fa-circle text-danger"></i> Refunds
                                </span>
                                <span class="mr-2">
                                    <i class="fas fa-circle text-primary"></i> Net Profit
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Clean Brilliant Company 2023</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Main Content -->
    </div>
    <!-- End of Content Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="~/vendor/chart.js/Chart.min.js"></script>

    <script>
        // Debug ViewBag values
        console.log('Data Available:', '@ViewBag.DataAvailable');
        console.log('Total Orders:', '@(ViewBag.Metrics?.TotalOrders ?? 0)');
        console.log('Total Refunds:', '@(ViewBag.Metrics?.TotalRefunds ?? 0)');
        console.log('Net Revenue:', '@(ViewBag.Metrics?.NetRevenue ?? "$0.00")');
        console.log('Pending Refunds:', '@(ViewBag.Metrics?.PendingRefunds ?? 0)');

        // Display alert if no data
        $(document).ready(function () {
            var totalOrders = @(ViewBag.Metrics?.TotalOrders ?? 0);
            var totalRefunds = @(ViewBag.Metrics?.TotalRefunds ?? 0);

            if (totalOrders === 0 && totalRefunds === 0) {
                alert('Warning: No order or refund data was found. This might indicate a connection issue.');
            }
        });
        // Month selector functionality
        document.getElementById('monthSelect').addEventListener('change', function () {
            var selectedOption = this.options[this.selectedIndex];
            document.getElementById('yearSelect').value = selectedOption.dataset.year;
        });

        // Daily Orders Line Chart
        var dailyOrdersCtx = document.getElementById('dailyOrdersChart');
        var dailyOrdersChart;

        // Profit Pie Chart
        var profitPieCtx = document.getElementById('profitPieChart');
        var profitPieChart;

        function renderCharts() {
            // Destroy existing chart if it exists
            if (dailyOrdersChart) dailyOrdersChart.destroy();

            // Get data from ViewBag
            var dailyOrderCounts = @Html.Raw(Json.Serialize(ViewBag.ChartData?.DailyOrderCounts)) || {};
            var dailyRefundCounts = @Html.Raw(Json.Serialize(ViewBag.ChartData?.DailyRefundCounts)) || {};
            var currentMonth = '@ViewBag.ChartData?.CurrentMonth' || 'Current Month';

            // Render Daily Orders and Refunds Chart
            if (dailyOrdersCtx) {
                // 1. Combine and prepare the data
                var dateMap = {};

                // Process orders data
                Object.entries(dailyOrderCounts).forEach(([dateStr, count]) => {
                    var date = new Date(dateStr);
                    var key = date.toISOString().split('T')[0];
                    dateMap[key] = dateMap[key] || { date: date, orderCount: 0, refundCount: 0 };
                    dateMap[key].orderCount = count;
                });

                // Process refunds data
                Object.entries(dailyRefundCounts).forEach(([dateStr, count]) => {
                    var date = new Date(dateStr);
                    var key = date.toISOString().split('T')[0];
                    dateMap[key] = dateMap[key] || { date: date, orderCount: 0, refundCount: 0 };
                    dateMap[key].refundCount = count;
                });

                // Sort by date
                var sortedEntries = Object.values(dateMap).sort((a, b) => a.date - b.date);

                // Prepare chart data
                var labels = sortedEntries.map(entry => entry.date.getDate());
                var ordersData = sortedEntries.map(entry => entry.orderCount);
                var refundsData = sortedEntries.map(entry => entry.refundCount);

                // 2. Create the chart
                dailyOrdersChart = new Chart(dailyOrdersCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: "Orders",
                                data: ordersData,
                                borderColor: '#4e73df',
                                backgroundColor: 'rgba(78, 115, 223, 0.1)',
                                tension: 0.3,
                                borderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                fill: true
                            },
                            {
                                label: "Refunds",
                                data: refundsData,
                                borderColor: '#dc3545',
                                backgroundColor: 'rgba(220, 53, 69, 0.1)',
                                tension: 0.3,
                                borderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                fill: true
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    title: function (context) {
                                        return currentMonth + ' ' + context[0].label + getDaySuffix(context[0].label);
                                    },
                                    label: function (context) {
                                        return context.dataset.label + ': ' + context.raw;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Day of Month',
                                    padding: { top: 10 }
                                },
                                grid: {
                                    display: false
                                }
                            },
                            y: {
                                title: {
                                    display: true,
                                    text: 'Number of Transactions',
                                    padding: { bottom: 10 }
                                },
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });

                // Helper function for day suffixes (1st, 2nd, 3rd, etc.)
                function getDaySuffix(day) {
                    day = parseInt(day);
                    if (day > 3 && day < 21) return 'th';
                    switch (day % 10) {
                        case 1: return 'st';
                        case 2: return 'nd';
                        case 3: return 'rd';
                        default: return 'th';
                    }
                }
            }
        }

        // Initialize chart when page loads
        document.addEventListener('DOMContentLoaded', renderCharts);

        // Optional: Re-render when window resizes for better responsiveness
        window.addEventListener('resize', function () {
            if (dailyOrdersChart) {
                renderCharts();
            }
        });
        // Profit Pie Chart
        function renderProfitPieChart() {
            var ctx = document.getElementById('profitPieChart');
            if (!ctx) return;

            // Destroy previous chart if exists
            if (window.profitPieChart) {
                window.profitPieChart.destroy();
            }

            // Get data from ViewBag
            var profitData = @Html.Raw(Json.Serialize(ViewBag.ChartData?.ProfitMetrics)) || {};
            var gross = @ViewBag.ChartData?.ProfitMetrics.GrossProfit || 0;
            var refunds = @ViewBag.ChartData?.ProfitMetrics.RefundAmount || 0;
            var net = @ViewBag.ChartData?.ProfitMetrics.NetProfit || 0;

            // Create chart
            window.profitPieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Gross Profit', 'Refunds', 'Net Profit'],
                    datasets: [{
                        data: [gross, refunds, net],
                        backgroundColor: [
                            'rgba(28, 200, 138, 0.8)',  // Green
                            'rgba(231, 74, 59, 0.8)',   // Red
                            'rgba(78, 115, 223, 0.8)'   // Blue
                        ],
                        borderColor: [
                            'rgba(28, 200, 138, 1)',
                            'rgba(231, 74, 59, 1)',
                            'rgba(78, 115, 223, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.label + ': $' + context.raw.toFixed(2);
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function () {
            renderProfitPieChart();

            // Your existing line chart initialization
            if (typeof dailyOrdersChart !== 'undefined') {
                // Initialize line chart if needed
            }
        });
    </script>
</body>

</html>