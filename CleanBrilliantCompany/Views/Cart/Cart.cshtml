@model Dictionary<int, int>

<div class="container mt-5">
    <h2 class="text-center mb-4">Your Shopping Cart</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Your cart is empty. <a asp-controller="CustomerPage" asp-action="GetAllProducts" class="alert-link">Continue shopping</a>.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var product = ViewBag.Products[item.Key]; <!-- Retrieve product details from ViewBag -->
                            <tr>
                                <td>@product["ProductName"]</td>
                                <td>@Convert.ToDecimal(product["CostPrice"]).ToString("C")</td> <!-- Explicitly cast to decimal -->
                                <td>
                                    <form asp-asp-controller="CartInput" asp-action="updateQuantity" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.Key" />
                                        <input type="number" name="quantity" value="@item.Value" min="1" class="form-control d-inline" style="width: 80px;" />
                                        <button type="submit" class="btn btn-sm btn-primary mt-1">Update</button>
                                    </form>
                                </td>
                                <td>$@(Convert.ToDecimal(product["CostPrice"]) * item.Value)</td> <!-- Explicitly cast to decimal -->
                                <td>
                                    <form asp-asp-controller="CartInput" asp-action="removeFromCart" method="post">
                                        <input type="hidden" name="productId" value="@item.Key" />
                                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-right mt-4">
                    <h4><strong>Total Product Price:</strong> @ViewBag.Total.ToString("C")</h4>
                    <a asp-controller="CustomerPage" asp-action="redirectToCheckout" class="btn btn-success btn-lg mt-3">Proceed to Checkout</a>
                </div>
            </div>
        </div>
    }
</div>
