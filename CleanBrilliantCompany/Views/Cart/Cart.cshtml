@model Dictionary<int, int>

<div class="container mt-5">
    <h2 class="text-center">Your Cart</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Your cart is empty. <a asp-controller="CustomerPage" asp-action="GetAllProducts">Continue shopping</a>.
        </div>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var product = ViewBag.Products[item.Key]; <!-- Retrieve product details from ViewBag -->
                    <tr>
                        <td>@product["ProductName"]</td>
                        <td>@Convert.ToDecimal(product["CostPrice"]).ToString("C")</td> <!-- Explicitly cast to decimal -->
                        <td>
                            <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.Key" />
                                <input type="number" name="quantity" value="@item.Value" min="1" class="form-control d-inline" style="width: 80px;" />
                                <button type="submit" class="btn btn-primary btn-sm">Update</button>
                            </form>
                        </td>
                        <td>$@(Convert.ToDecimal(product["CostPrice"]) * item.Value)</td> <!-- Explicitly cast to decimal -->
                        <td>
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="productId" value="@item.Key" />
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-right">
            <h4>Total Product Price: @ViewBag.Total.ToString("C")</h4>
            <a asp-controller="CustomerPage" asp-action="Checkout" class="btn btn-success">Proceed to Checkout</a>
        </div>
    }
</div>