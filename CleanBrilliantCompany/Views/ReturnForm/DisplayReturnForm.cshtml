    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	ViewData["Title"] = "View Return Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CleanBrilliantCompany.Models.Entity;
@model ReturnForm

<button class="btn btn-secondary" onclick="history.back()">Go Back</button>
@if (Model == null)
{
    <p>Return form not found.</p>
}

else
{
    <h1 class="h1 text-center py-2 fw-bold">Clean Brilliant Company</h1>
    <h2 class="text-muted text-center py-2 ">Return form</h2>

    <h2 class="h2 py-2">Return ID: @Model.GetReturnId()</h2>
    <br />
    <p>
        Manufacturer ID: @Model.GetManufacturerId() <br />
        Manufacturer Name: @Model.GetManufacturerName() <br />
        Manufacturer Email: @Model.GetManufacturerEmail() <br />
    </p>
    <hr />
    <p>Item ID: @Model.GetItemId()</p>
    <p>Product ID: @Model.GetProductId()</p>
    <p>Product Name: @Model.GetProductName()</p>
    <hr />
    <p>
        <span class="fw-bold">Return Reason: <br /></span>
        @Model.GetReturnReason()
    </p>
    <p>
        <span class="fw-bold">Sent by Staff ID: <br /></span>
        @Model.GetStaffId()
    </p>
}