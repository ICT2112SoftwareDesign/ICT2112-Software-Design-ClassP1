@{
    ViewData["Title"] = "Manage Return Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using CleanBrilliantCompany.Models.Entity;
@model List<ReturnForm>

<div class="px-5">
<div class="text-center">
    <h1 class="display-4 p-3">Manage Return Forms</h1>
    <p>The following return forms are for items that have already had a return form logged with their respective manufacturers.</p>
    <p>To return items, click on the button below:</p>
    <a asp-controller="ReturnForm" asp-action="ShowAllToReturn" class="btn btn-secondary">Items to be Returned</a>
</div>


<table class="table mt-5">
    <thead>
        <tr>
            <th>Return ID</th>
            <th>Manufacturer ID</th>
            <th>Item ID</th>
            <th>Product ID</th>
            <th>Return Reason</th>
            <th>Staff ID</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null || Model?.Count <= 0)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.GetReturnId()</td>
                    <td>@item.GetManufacturerId()</td>
                    <td>@item.GetItemId()</td>
                    <td>@item.GetProductId()</td>
                    <td class="text-truncate" style="max-width: 100px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @item.GetReturnReason()
                    </td>
                    <td>@item.GetStaffId()</td>

                    <td><a asp-controller="ReturnForm" asp-action="DisplayReturnForm" asp-route-itemId="@item.GetItemId()" class="btn btn-primary">View</a></td>

                    <td>
                        <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#deleteConfirmationModal-@item.GetReturnId()">
                            Delete
                        </button>
                    </td>
                </tr>
                <!-- Delete Confirmation Modal -->

                <div class="modal fade" id="deleteConfirmationModal-@item.GetReturnId()" tabindex="-1" role="dialog" aria-labelledby="deleteConfirmationLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteConfirmationLabel">Delete Confirmation</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete this return form? <br /><br />
                                NOTE: Deleting a return form sets the item back to ToReturn status, it doesn't recall any Email sent to manufacturers. <br />
                                Creating a new return form will send another email to the manufacturer. <br />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                <a asp-controller="ReturnForm" asp-action="DeleteReturnForm" asp-route-productId="@item.GetProductId()" asp-route-itemId="@item.GetItemId()" class="btn btn-danger delete-btn">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </tbody>
</table>


</div>
<body>
    </div>
    </div>
    </div>
</body>
</html>


@if (Model == null || Model?.Count <= 0)
{
    <p class="text-center">No return forms.</p>
}