                <!-- Begin Page Content -->
                <div class="container-fluid">
                    <button class="btn btn-secondary" onclick="history.back()">Go Back</button>
                    <div class="text-center">
                        <h1 class="display-4">Create Return Form</h1>
                        <p>Input return reason and click submit to send return form email to item's manufacturer</p>
                    </div>

                    <form action="@Url.Action("ConfirmReturnForm", "ReturnForm")" method="post">
                        <label class="mt-4">Manufacturer ID:</label>
                        <input readonly class="form-control" type="number" name="manufacturerId" value="@Model.GetManufacturerId()" />

                        <label class="mt-4">Manufacturer Name:</label>
                        <input readonly class="form-control" type="text" name="manufacturerName" value="@Model.GetManufacturerName()" />

                        <label class="mt-4">Manufacturer Email:</label>
                        <input readonly class="form-control" type="text" name="manufacturerEmail" value="@Model.GetManufacturerEmail()" />

                        <label class="mt-4">Product ID:</label>
                        <input readonly class="form-control" type="number" name="productId" value="@Model.GetProductId()" />

                        <label class="mt-4">Product Name:</label>
                        <input readonly class="form-control" type="text" name="productName" value="@Model.GetProductName()" />

                        <label class="mt-4">Item ID:</label>
                        <input readonly class="form-control" type="number" name="itemId" value="@Model.GetItemId()" />

                        <label class="mt-4">Staff ID:</label>
                        <input readonly class="form-control" type="number" name="staffId" value="@Model.GetStaffId()" />

                        <label class="mt-4">Return Reason:</label>
                        <input required pattern="\S(.*\S)?" class=" form-control" type="text" placeholder="Add a return reason" name="returnReason" />

                        <button class="btn btn-primary mt-4 sumbit-btn" type="submit">Submit</button>
                    </form>
                </div>
