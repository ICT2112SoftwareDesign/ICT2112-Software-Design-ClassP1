@model SupportTicketDTO

<h2>Ticket Details</h2>

<div>
    <strong>Ticket ID:</strong> @Model.TicketId
    <br />
    <strong>Customer ID:</strong> @Model.CustomerId
    <br />
    <strong>Order ID:</strong> @Model.OrderId
    <br />
    <strong>Status:</strong> @Model.Status
    <br />
    <strong>Created At:</strong> @Model.CreatedAt
    <br />
    <strong>Ticket Details:</strong> @Model.TicketDetails
    <br />
    <strong>Resolution Details:</strong> @Model.ResolutionDetails
    <br />

    <!-- Form to add resolution details and resolve the ticket -->
    <form method="post" action="@Url.Action("UpdateSupportTicket", "SupportTicket", new { ticketId = Model.TicketId })">
        <label for="resolutionDetails">Resolution Details:</label>
        <textarea id="resolutionDetails" name="resolutionDetails" required></textarea>
        <button type="submit">Resolve Ticket</button>
    </form>

    <!-- Button to go back to the list -->
    <a href="@Url.Action("Index", "SupportTicket")">Back to List</a>
</div>
