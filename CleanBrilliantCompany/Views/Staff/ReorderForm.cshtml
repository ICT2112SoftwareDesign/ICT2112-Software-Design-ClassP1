@model CleanBrilliantCompany.Models.ReorderRequest_RDM

<h2>Create New Reorder</h2>

<form asp-action="SubmitReorderForm" method="post">
    <div class="form-group">
        <label>Product ID</label>
        <input asp-for="ProductId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <div class="form-group">
        <label>Manufacturer ID</label>
        <input asp-for="ManufacturerId" class="form-control" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create Reorder</button>
        <a href="/staff/reorder-requests" class="btn btn-secondary">Back</a>
    </div>

</form>
