@{
    ViewData["Title"] = "Goal Emissions Graph";
}

<h2>Goal Emissions vs Date</h2>

<canvas id="goalEmissionChart" width="400" height="200"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/json2/20200211/json2.min.js"></script>

<script type="text/javascript">
    var dates = @Html.Raw(ViewData["Dates"]);
    var emissions = @Html.Raw(ViewData["Emissions"]);

    console.log("Dates:", dates);
    console.log("Emissions:", emissions);

    var ctx = document.getElementById("goalEmissionChart").getContext("2d");
    var goalEmissionChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: dates, // X-axis (Date)
            datasets: [{
                label: 'Target Emission',
                data: emissions, // Y-axis (Target Emission)
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                fill: true
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: {
                    type: 'category', // 'category' type for string-based dates
                    title: {
                        display: true,
                        text: 'Date'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Target Emission'
                    }
                }
            }
        }
    });
</script>

<!-- Canvas for Chart.js -->
<canvas id="goalEmissionChart" width="400" height="200"></canvas>