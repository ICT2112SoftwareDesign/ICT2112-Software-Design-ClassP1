@using Newtonsoft.Json
@using CleanBrilliantCompany.DTO;
@model List<EmissionPredDTO>
@{
    ViewData["Title"] = "Goal Emissions Graph";

    var graphJson = ViewData["graph"] as string;
    var graph = string.IsNullOrEmpty(graphJson) 
                      ? new List<EmissionPredDTO>() 
                      : Newtonsoft.Json.JsonConvert.DeserializeObject<List<EmissionPredDTO>>(graphJson);
    var graphEmission = (graph != null && graph.Any())
                          ? graph.Select(g => g.emisission).ToList()
                          : new List<double>();
    var graphDate = (graph != null && graph.Any())
                          ? graph.Select(g => g.day).ToList()
                          : new List<DateTime>();

    var predictionsJson = ViewData["predictions"] as string;
    var predictions = string.IsNullOrEmpty(predictionsJson)
                      ? new List<EmissionPredDTO>() 
                      : Newtonsoft.Json.JsonConvert.DeserializeObject<List<EmissionPredDTO>>(predictionsJson);
    var predictionsEmission = (predictions != null && predictions.Any())
                          ? predictions.Select(p => p.emisission).ToList() 
                          : new List<double>();
    var predictionsDate = (predictions != null && predictions.Any())
                          ? predictions.Select(p => p.day).ToList() 
                          : new List<DateTime>();

    
}
<body id="page-top">
    <div id="wrapper" class="d-flex flex-nowrap min-vh-100">
            @await Html.PartialAsync("_Sidebar") 
            <div class="dashboard-content px-4">
                <div id="content" class="dashboard-container">
                <h2>Goal Emissions vs Date</h2>

<!-- Date Range Picker -->
<div>
    <label for="startDate">Start Date:</label>
    <input type="month" id="startDate" />
    <label for="endDate">End Date:</label>
    <input type="month" id="endDate" />
    <button id="applyDateRange">Apply</button>
</div>

<canvas id="goalEmissionChart" width="400" height="200"></canvas>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/json2/20200211/json2.min.js"></script>

<script type="text/javascript">
    var goalDates = @Html.Raw(ViewData["goalDates"]);
    var goalEmissions = @Html.Raw(ViewData["goalEmissions"]);
    var graphEmission = @Html.Raw(JsonConvert.SerializeObject(graphEmission));
    var graphDate = @Html.Raw(JsonConvert.SerializeObject(graphDate));
    var predictionsEmission = @Html.Raw(JsonConvert.SerializeObject(predictionsEmission));
    var predictionsDate = @Html.Raw(JsonConvert.SerializeObject(predictionsDate));

    goalDates = goalDates.map(date => new Date(date));
    graphDate = graphDate.map(date => new Date(date));
    predictionsDate = predictionsDate.map(date => new Date(date));
    
    var goalData = goalDates.map((date, index) => ({
        x: date,
        y: goalEmissions[index]
    }));

    var graphData = graphDate.map((date, index) => ({
        x: date,
        y: graphEmission[index]
    }));

    var predictionData = predictionsDate.map((date, index) => ({
        x: date,
        y: predictionsEmission[index]
    }));

    console.log("goalDates:", goalDates);
    console.log("goalEmissions:", goalEmissions);
    console.log("current emission:", graphEmission);
    console.log("predicted missions:", predictionsEmission);

    

    var ctx = document.getElementById("goalEmissionChart").getContext("2d");

    var goalEmissionChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: goalDates, // X-axis (Date)
            datasets: [{
                label: 'Target Emission',
                data: goalData,
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                fill: true
            },{
                label: 'Predicted Carbon Emission',
                data: predictionData,
                borderColor: 'rgba(255, 159, 64, 1)',
                backgroundColor: 'rgba(255, 159, 64, 0.2)',
                fill: true
            },{
                label: 'Current Carbon Emission',
                data: graphData,
                borderColor: 'rgba(153, 102, 255, 1)',
                backgroundColor: 'rgba(153, 102, 255, 0.2)',
                fill: true
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: {
                    type: 'time', // 'category' type for string-based dates
                    time: {
                        unit: 'month', // You can set the unit to 'day', 'month', etc.
                        tooltipFormat: 'MMM, yyyy', // Format for tooltips
                        displayFormats: {
                            'month': 'MMM yyyy', // Format displayed on the x-axis
                            'day': 'MM/DD/YYYY'
                        }
                    },
                    title: {
                        display: true,
                        text: 'Date'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Carbon Emission'
                    }
                }
            }
        }
    });

    // Apply the date range filter
    document.getElementById("applyDateRange").addEventListener("click", function() {
        var startDate = document.getElementById("startDate").value + "-1";
        var endDate = document.getElementById("endDate").value + "-1";

        // Filter the dates and emissions based on the selected range
        var filteredDates = [];
        var filteredEmissions = [];
        var filteredGraphDate = [];
        var filteredGraphEmission = [];
        var filteredPredictDate = [];
        var filteredPredictEmission = [];

        for (var i = 0; i < goalData.length; i++) {
            if (goalData[i].x >= new Date(startDate) && goalData[i].x <= new Date(endDate)) {
                filteredDates.push(goalData[i].x);
                filteredEmissions.push(goalData[i].y);
            }
        }
        for (var i = 0; i < graphData.length; i++) {
            if (graphData[i].x >= new Date(startDate) && graphData[i].x <= new Date(endDate)) {
                filteredGraphDate.push(graphData[i].x);
                filteredGraphEmission.push(graphData[i].y);
            }
        }
        for (var i = 0; i < predictionData.length; i++) {
            if (predictionData[i].x >= new Date(startDate) && predictionData[i].x <= new Date(endDate)) {
                filteredPredictDate.push(predictionData[i].x);
                filteredPredictEmission.push(predictionData[i].y);
            }
        }
        // Update the chart with the filtered data
        var newGoalData = filteredDates.map((date, index) => ({
            x: date,
            y: filteredEmissions[index]
        }));
        var newGraphData = filteredGraphDate.map((date, index) => ({
            x: date,
            y: filteredGraphEmission[index]
        }));
        var newPredictionData = filteredPredictDate.map((date, index) => ({
            x: date,
            y: filteredPredictEmission[index]
        }));

        goalEmissionChart.data.labels = filteredDates;
        goalEmissionChart.data.datasets[0].data = newGoalData;
        goalEmissionChart.data.datasets[1].data = newPredictionData;
        goalEmissionChart.data.datasets[2].data = newGraphData;
        goalEmissionChart.update();
    });
</script>


                <!-- Canvas for Chart.js -->
                <canvas id="goalEmissionChart" width="400" height="200"></canvas>
           </div>
        </div>  
    </div>
</body>>
<!-- Notification -->
<div id="notification" class="alert alert-danger" style="display:none;"></div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#goalForm").submit(function (event) {
            event.preventDefault(); // Prevent form from reloading the page

            var formData = {
                TargetEmission: $("#TargetEmission").val(),
                goalDate: $("#goalDate").val()
            };

            $.ajax({
                url: "/GoalsInput/Create",
                type: "POST",
                data: formData,
                success: function (response) {
                    if (response.success) {
                        alert(response.message); // Show success message
                        location.reload(); // Reload the page to reflect new data
                    } else {
                        $("#notification").text(response.message).show(); // Show error notification
                    }
                },
                error: function () {
                    $("#notification").text("An unexpected error occurred.").show();
                }
            });
        });
    });
</script>