@model CleanBrilliantCompany.Models.Alert

@{
    ViewData["Title"] = "Edit Alert";
}

<h1>Edit Alert</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AlertID" />
            <div class="form-group">
                <label asp-for="AlertDate" class="control-label"></label>
                <input asp-for="AlertDate" class="form-control" />
                <span asp-validation-for="AlertDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AlertMessage" class="control-label"></label>
                <textarea asp-for="AlertMessage" class="form-control" rows="3"></textarea>
                <span asp-validation-for="AlertMessage" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
