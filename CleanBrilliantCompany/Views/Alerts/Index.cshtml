@model IEnumerable<CleanBrilliantCompany.Models.Alert>

@{
    ViewData["Title"] = "Alerts";
}

<h1>Alerts</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AlertID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertMessage)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.AlertID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AlertDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AlertMessage)
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.AlertID" class="btn btn-sm btn-primary">Details</a>
                    </td>
                </tr>
        }
    </tbody>
</table>
