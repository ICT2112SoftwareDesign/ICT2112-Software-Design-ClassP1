@model IEnumerable<CleanBrilliantCompany.Models.Alert>
@using System.Globalization

@{
    ViewData["Title"] = "Monthly Goal Alerts";
    int currentYear = DateTime.UtcNow.Year;
    int currentMonth = DateTime.UtcNow.Month;
}

@* wrap content in a container-fluid for wider content with padding *@
<div class="container-fluid pt-4">

    <h1>@ViewData["Title"]</h1>

    @* display status messages from tempdata *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info" role="alert">@TempData["InfoMessage"]</div>
    }

    <div class="mb-4 p-3 border rounded bg-light">
        <h5>Manually check past month</h5>
        <form asp-action="CheckPastMonth" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row align-items-end">
                <div class="col-md-4 mb-2">
                    <label for="year">Year</label>
                    <select id="year" name="year" class="form-control">
                        @for (int y = currentYear; y >= currentYear - 5 && y >= 2020; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mb-2">
                    <label for="month">Month</label>
                    <select id="month" name="month" class="form-control">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mb-2">
                    <button type="submit" class="btn btn-primary btn-block">Check & generate alert</button>
                </div>
            </div>
            <small class="form-text text-muted">Select a month prior to the current one to generate its goal alert if it
                doesn't exist.</small>
        </form>
    </div>

    <p>This page shows the results of the automatic and manual monthly carbon emission goal checks.</p>

    <table class="table table-striped table-hover">
        <thead class="thead-light">
            <tr>
                <th>Timestamp (UTC)</th>
                <th>Goal Period</th>
                <th>Target (g CO2e)</th>
                <th>Actual (g CO2e)</th>
                <th>Status</th>
                <th>Details</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center">no alerts generated yet. the check runs automatically at the start
                        of
                        each month.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    // determine row color based on status
                    string rowClass = item.Status.Equals("met", StringComparison.OrdinalIgnoreCase) ? "table-success" :
                    item.Status.Equals("missed", StringComparison.OrdinalIgnoreCase) ? "table-danger" :
                    "table-secondary";

                    <tr class="@rowClass">
                        <td>
                            @item.AlertTimestamp.ToString("yyyy-MM-dd hh:mm tt")
                        </td>
                        <td>
                            @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.GoalMonth) @item.GoalYear
                        </td>
                        <td>
                            @(item.TargetEmission.HasValue? item.TargetEmission.Value.ToString("N2") : "n/a")
                        </td>
                        <td>
                            @item.ActualTotalEmission.ToString("N2")
                        </td>
                        <td>
                            <span
                                class="badge @(item.Status.Equals("met", StringComparison.OrdinalIgnoreCase) ? "badge-success" : item.Status.Equals("missed", StringComparison.OrdinalIgnoreCase) ? "badge-danger" : "badge-secondary")">
                                @Html.DisplayFor(modelItem => item.Status)
                            </span>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Message)
                        </td>
                        <td>
                            <form asp-action="DeleteAlert" method="post"
                                onsubmit="return confirm('are you sure you want to delete the alert for @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.GoalMonth) @item.GoalYear?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="year" value="@item.GoalYear" />
                                <input type="hidden" name="month" value="@item.GoalMonth" />
                                <button type="submit" class="btn btn-danger btn-sm">delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div> @* closing tag for container *@

@* toast container for notifications *@
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
    @* toasts will be appended here by javascript *@
</div>

@section Scripts {
    @* use bootstrap 5 css to match the js version and toast component structure *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    @* load bootstrap js specifically for this page - placed before the script that uses it *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>

    @* 1. add signalr client library via cdn *@
    <script src="
                        https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js
                        "></script>


    @* 2. your custom script block goes after the library *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- reusable toast function --- (must be defined before use)
            function showToast(goalPeriod, targetEmission, actualEmission, status) {
                const toastContainer = document.querySelector('.toast-container');
                if (!toastContainer) {
                    console.error("toast container not found.");
                    return;
                }

                // determine toast style based on status
                let toastBgClass = 'bg-secondary'; // default/other status
                if (status && status.toLowerCase() === 'met') {
                    toastBgClass = 'bg-success';
                } else if (status && status.toLowerCase() === 'missed') {
                    toastBgClass = 'bg-danger';
                }
                const toastStatusText = status ? status.toUpperCase() : 'UNKNOWN';

                // create toast html dynamically
                const toastHtml = `
                                            <div class="toast align-items-center text-white ${toastBgClass} border-0 position-relative" role="alert" aria-live="assertive" aria-atomic="true">
                                                <div class="toast-body">
                                                    <strong>${goalPeriod || 'n/a'}: ${toastStatusText}</strong><br>
                                                    target: ${targetEmission || 'n/a'} g co2e<br>
                                                    actual: ${actualEmission || 'n/a'} g co2e
                                                </div>
                                                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 mt-1 me-1" data-bs-dismiss="toast" aria-label="Close"></button>
                                            </div>`;

                // append toast to container
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                const newToastEl = toastContainer.lastElementChild;
                if (newToastEl && typeof bootstrap !== 'undefined' && bootstrap.Toast) { // ensure bootstrap is loaded
                    // initialize and show the bootstrap toast
                    const toast = new bootstrap.Toast(newToastEl, {
                        delay: 7000, // slightly longer display for real-time alerts
                        autohide: true
                    });
                    toast.show();

                    newToastEl.addEventListener('hidden.bs.toast', function () {
                        newToastEl.remove();
                    });
                } else {
                    console.error("failed to find newly added toast element or bootstrap toast component.");
                }
            } // end showToast function

            // --- handle initial toast from tempdata --- (using the new function)
            const initialToastStatus = @Html.Raw(TempData["Toast_Status"] != null ? Json.Serialize(TempData["Toast_Status"]) : "null");
            if (initialToastStatus) {
                const initialGoalPeriod = @Html.Raw(TempData["Toast_GoalPeriod"] != null ? Json.Serialize(TempData["Toast_GoalPeriod"]) : "null");
                const initialTargetEmission = @Html.Raw(TempData["Toast_TargetEmission"] != null ? Json.Serialize(TempData["Toast_TargetEmission"]) : "null");
                const initialActualEmission = @Html.Raw(TempData["Toast_ActualEmission"] != null ? Json.Serialize(TempData["Toast_ActualEmission"]) : "null");
                showToast(initialGoalPeriod, initialTargetEmission, initialActualEmission, initialToastStatus);
            }

            // --- signalr connection setup --- (ensure signalr is loaded)
            if (typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/alertHub") // use the same url mapped in program.cs
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // --- define function to call when server sends a message ---
                connection.on("ReceiveMonthlyAlert", function (goalPeriod, targetEmission, actualEmission, status) {
                    console.log("signalr message received:", { goalPeriod, targetEmission, actualEmission, status }); // for debugging
                    showToast(goalPeriod, targetEmission, actualEmission, status);
                });

                // --- start the connection --- (function definition)
                async function startSignalR() {
                    try {
                        await connection.start();
                        console.log("signalr connected.");
                    } catch (err) {
                        console.error("signalr connection error: ", err);
                        setTimeout(startSignalR, 5000);
                    }
                }

                connection.onclose(async () => {
                    console.log("signalr connection closed. attempting to restart...");
                    await startSignalR(); // attempt to restart if connection closes unexpectedly
                });

                // --- start the initial connection attempt ---
                startSignalR();
            } else {
                console.error("signalr client library not loaded.");
            }

        });
    </script>
}
