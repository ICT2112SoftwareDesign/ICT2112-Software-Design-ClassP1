@model CleanBrilliantCompany.Models.Alert

@{
    ViewData["Title"] = "Create Alert";
}

<h1>Create Alert</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="AlertMessage" class="control-label"></label>
                <textarea asp-for="AlertMessage" class="form-control" rows="3"></textarea>
                <span asp-validation-for="AlertMessage" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
