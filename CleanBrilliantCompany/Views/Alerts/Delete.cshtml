@model CleanBrilliantCompany.Models.Alert

@{
    ViewData["Title"] = "Delete Alert";
}

<h1>Delete Alert</h1>

<h3>Are you sure you want to delete this alert?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AlertID)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AlertID)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AlertDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AlertDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AlertMessage)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AlertMessage)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="AlertID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
