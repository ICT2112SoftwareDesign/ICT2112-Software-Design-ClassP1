@model CleanBrilliantCompany.Models.FeedbackRDM

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @* <!-- Custom fonts for this template-->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> *@

    <!-- Font Awesome -->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,400,600,700,800,900" rel="stylesheet">

    <!-- SB Admin CSS -->
    <link href="css/sb-admin-2.min.css" rel="stylesheet">
</head>


<body id="page-top">
    <div id="wrapper" class="d-flex flex-nowrap min-vh-100">
        @await Html.PartialAsync("_Sidebar")
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column flex-grow-1">

            <!-- Main Content -->
            <div class="dashboard-content px-4 flex-grow-1">
                <!-- ... your form / content ... -->
                <h2 class="h2 mb-0 text-gray-800">Edit Feedback</h2>

                    <form method="post" asp-action="EditFeedback">
                        <!-- Hidden field to store Feedback ID -->
                        <input type="hidden" asp-for="FeedbackId" />

                        <div class="mb-3">
                            <label class="form-label" for="feedback">Feedback</label>
                            <textarea class="form-control" asp-for="Feedback" rows="4" required></textarea>
                            <span class="text-danger" asp-validation-for="Feedback"></span>
                        </div>

                        @* <div class="mb-3">
                        <label class="form-label" for="managerComments">Manager Comments</label>
                        <textarea class="form-control" asp-for="ManagerComments" rows="3"></textarea>
                        <span class="text-danger" asp-validation-for="ManagerComments"></span>
                        </div> *@

                        <div style="display: flex;">
                            <button type="submit" class="btn btn-primary px-4" style="margin-right: 12px;">Save</button>
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                        </div>



                    </form>
            </div>
        </div>
    </div>
</body>


<style>
    html,
    body {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: "Nunito", sans-serif;
    }

    #wrapper {
        display: flex;
        min-height: 100%;
        width: 100%;
    }

    .sidebar {
        position: relative;
        width: 250px;
        background-color: #4e73df;
        color: white;
        min-height: 100%;
        margin-top: 1rem;
    }

    #content-wrapper {
        margin-left: 0;
        width: 100%;
        padding: 0 !important;
        box-sizing: border-box;
        margin-top: 1rem;
    }

    .dashboard-content {
        padding-left: 20px;
        padding-right: 20px;
    }

    .dashboard-container {
        max-width: 100%;
    }

    .container,
    .container-fluid {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 20px;
    }

    .chart-container {
        position: relative;
        width: 100%;
        max-width: 900px;
        height: 300px;
        margin: 0 auto;
    }

    canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    .topbar {
        box-shadow: 0 0.15rem 1rem 0 rgba(58, 59, 69, .15);
    }
</style>

<!-- Client-Side Validation Support -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}