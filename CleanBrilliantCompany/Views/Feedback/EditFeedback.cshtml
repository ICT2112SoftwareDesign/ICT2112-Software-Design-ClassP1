@model CleanBrilliantCompany.Models.FeedbackRDM

<h2 class="mb-4">Edit Feedback</h2>

<form method="post" asp-action="EditFeedback">
    <!-- Hidden field to store Feedback ID -->
    <input type="hidden" asp-for="FeedbackId" />

    <div class="mb-3">
        <label class="form-label" for="feedback">Feedback</label>
        <textarea class="form-control" asp-for="Feedback" rows="4" required></textarea>
        <span class="text-danger" asp-validation-for="Feedback"></span>
    </div>

    @* <div class="mb-3">
        <label class="form-label" for="managerComments">Manager Comments</label>
        <textarea class="form-control" asp-for="ManagerComments" rows="3"></textarea>
        <span class="text-danger" asp-validation-for="ManagerComments"></span>
    </div> *@

    <div class="d-flex">
        <button type="submit" class="btn btn-primary px-4 me-3">Save</button>
        <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
    </div>

</form>

<!-- Client-Side Validation Support -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
