@*here  *@
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @* <!-- Custom fonts for this template-->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> *@

    <!-- Font Awesome -->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,400,600,700,800,900" rel="stylesheet">

    <!-- SB Admin CSS -->
    <link href="css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body id="page-top">
    <div id="wrapper">
        @await Html.PartialAsync("_Sidebar")
        <div id="content-wrapper" style="padding-top: 0;">

            <div class="dashboard-content px-4">
                <div id="content" class="dashboard-container">

                    <h2 class="h2 mb-0 text-gray-800">Feedback System</h2>

                    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
                            @ViewBag.SuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
                            @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Feedback Form -->
                    <div class="card p-4 shadow-sm mb-4">
                        <h4>Submit Your Feedback</h4>
                        <form method="post" asp-action="SubmitFeedback" asp-controller="Feedback">
                            <input type="hidden" name="staffId" value="1" />
                            <div class="form-group">
                                <label for="feedback">Your Feedback</label>
                                <textarea class="form-control" id="feedback" name="feedback" rows="4"
                                    required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-2">Submit</button>
                        </form>
                    </div>

                    <!-- Feedback List -->
                    <div class="card p-4 shadow-sm">
                        <h4>Previous Feedback</h4>
                        @if (Model != null && Model.Count > 0)
                        {
                            <ul class="list-group">
                                @foreach (var feedback in Model)
                                {
                                    var collapseId = "collapse-" + feedback.FeedbackId;
                                    <li class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@feedback.Feedback</strong><br />
                                                <small class="text-muted">
                                                    By: <strong>@feedback.StaffName</strong> |
                                                    Status:
                                                    @if (feedback.Status == "Resolved")
                                                    {
                                                        <span class="badge bg-success">Resolved</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info">@feedback.Status</span>
                                                    }
                                                </small>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(feedback.ManagerComments))
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                                        aria-expanded="false" aria-controls="@collapseId">
                                                        <span>&#9660;</span>
                                                    </button>
                                                }

                                                @if (feedback.Status != "Resolved")
                                                {
                                                    <a href="@Url.Action("EditFeedback", "Feedback", new { feedbackId = feedback.FeedbackId })"
                                                        class="btn btn-sm btn-warning text-black">Edit</a>
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(feedback.ManagerComments))
                                        {
                                            <div class="collapse mt-2" id="@collapseId">
                                                <div class="card card-body bg-light">
                                                    <strong>Manager's Comment:</strong><br />
                                                    @feedback.ManagerComments
                                                </div>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No feedback submitted yet.</p>
                        }
                    </div>




                </div>

            </div>
        </div>
    </div>
</body>




<!-- jQuery for Alert Dismiss -->
<script>
    $(document).ready(function () {
        console.log("Document loaded. Checking for alerts...");

        // Function to fade out and remove alerts after 3 seconds
        function dismissAlert(alertId) {
            if ($(alertId).length) {
                console.log(alertId + " found. Setting fade out.");
                setTimeout(function () {
                    $(alertId).fadeOut("slow", function () {
                        $(this).remove(); // Removes from the DOM
                        console.log(alertId + " removed.");
                    });
                }, 3000);
            }
        }

        // Auto-hide alerts after 3 seconds
        dismissAlert("#successAlert");
        dismissAlert("#errorAlert");

        // Ensure Bootstrap dismiss works correctly on close button click
        $(".alert").on("close.bs.alert", function () {
            console.log("Close button clicked. Removing alert.");
            $(this).fadeOut("slow", function () {
                $(this).remove();
            });
        });
    });
</script>
