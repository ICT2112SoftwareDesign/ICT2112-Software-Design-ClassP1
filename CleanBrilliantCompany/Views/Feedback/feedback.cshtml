
@using CleanBrilliantCompany.Models
@using CleanBrilliantCompany.Interfaces

@model List<string>
@inject IFeedbackSubmission FeedbackService


@{
    ViewData["Title"] = "Feedback System";
}

<div class="container mt-4">
    <h2 class="text-center">Feedback System</h2>
    
    <div class="card p-4 shadow-sm">
        <h4>Submit Your Feedback</h4>
        <form method="post" asp-action="SubmitFeedback">
            <div class="form-group">
                <label for="feedback">Your Feedback</label>
                <textarea class="form-control" id="feedback" name="feedback" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Submit</button>
        </form>
    </div>

    <hr>

    <div class="card p-4 mt-4 shadow-sm">
        <h4>Previous Feedback</h4>
        @if (Model != null && Model.Count > 0)
        {
            <ul class="list-group">
                @foreach (var feedback in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @feedback
                        <form method="post" asp-action="EditFeedback" class="d-inline">
                            <input type="hidden" name="feedback" value="@feedback" />
                            <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                        </form>
                        <form method="post" asp-action="DeleteFeedback" class="d-inline">
                            <input type="hidden" name="feedback" value="@feedback" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No feedback submitted yet.</p>
        }
    </div>
</div>