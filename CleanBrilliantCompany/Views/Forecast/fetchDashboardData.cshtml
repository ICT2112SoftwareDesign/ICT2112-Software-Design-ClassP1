@model CleanBrilliantCompany.Models.Forecast.ForecastDashboard

@{
    ViewData["Title"] = "Forecast Dashboard";
}

<h1>📊 Forecast Dashboard</h1>

<div class="dashboard-container">
    <h3>🆔 Dashboard Details</h3>
    <p><strong>Dashboard ID:</strong> @Model.GetDashBoardID()</p>
    <p><strong>Generated Date:</strong> @Model.GetGeneratedDate().ToString("yyyy-MM-dd HH:mm")</p>
    <p><strong>Validity Duration:</strong> @Model.GetValidityDuration() days</p>

    <h3>🗓 Date Range</h3>
    <p><strong>Start Date:</strong> @Model.GetStartDate().ToString("yyyy-MM-dd")</p>
    <p><strong>End Date:</strong> @Model.GetEndDate().ToString("yyyy-MM-dd")</p>

    <h3>📈 Forecast Metrics</h3>
    <p><strong>Metrics Count:</strong> @Model.GetMetrics().Count</p>

    <table class="forecast-table">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Product Name</th>
                <th>Forecasted Demand</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var metric in Model.GetMetrics())
            {
                <tr>
                    <td>@metric.getProductId()</td>
                    <td class="product-name">@metric.getProductName()</td>
                    <td>@metric.getForecastedStock()</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<hr>

@{
    // Calculate the allowed minimum forecast month (one month after today's date)
    var minAllowed = DateTime.Today.AddMonths(1);
    var minValue = minAllowed.ToString("yyyy-MM"); // Format as "yyyy-MM"
}

<hr>
<h3>🔄 Generate New Forecast</h3>

<form method="post" action="/forecast/generateForecast">
    <label>Forecast Type:</label>
    <select name="type">
        <option value="price">Price Forecast</option>
        <option value="stock">Stock Forecast</option>
    </select>

    <label>Select Forecast Month:</label>
    <input type="month" name="month" min="@minValue" required />

    <button type="submit">Generate Forecast</button>
</form>

<style>
    .forecast-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .forecast-table th, .forecast-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .forecast-table thead {
            background-color: #f8f9fa;
            font-weight: bold;
        }

    .product-name {
        text-align: left; /* Align product name to the left */
        padding-left: 20px;
    }
</style>
