                <!-- Begin Page Content -->
                <!-- Page Heading -->
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">Forecast Dashboard</h1>
                    @* <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm"> *@
                    @*     <i class="fas fa-download fa-sm text-white-50"></i> Generate Report *@
                    @* </a> *@
                </div>


                

                <div class="container-fluid p-4">
                    @* <h4 class="mb-3">🔄 Generate New Forecast</h4> *@

                    <div class="p-4 bg-white rounded shadow-sm mb-4">
                        <h4 class="mb-3"><i class="fas fa-sync-alt"></i> Generate New Forecast</h4>

                        <!-- Quick Select Chips -->
                        <div class="d-flex flex-column align-items-center mb-3">
                            <strong class="mb-2">Quick Select:</strong>
                            <div class="d-flex flex-wrap justify-content-center">
                                @foreach (var chip in quickChips)
                                {
                                    <form method="post" action="/Forecast/GenerateForecast" class="d-inline">
                                        <input type="hidden" name="type" value="stock" />
                                        <input type="hidden" name="month" value="@chip" />
                                        <button type="submit" class="quick-select-chip btn btn-light border rounded-pill px-3 mx-2 my-1">
                                            @chip
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        <!-- OR Divider -->
                        <div class="or-divider-container text-center my-4">
                            <span class="or-divider">— or —</span>
                        </div>

                        <!-- Manual Month Selection Form -->
                        <form method="post" action="/Forecast/GenerateForecast" class="d-flex flex-column align-items-center">
                            <input type="hidden" name="type" value="stock" />

                            <label for="monthInput" class="mb-2"><strong>Select Forecast Month:</strong></label>

                            <div class="d-flex">
                                <input type="month" id="monthInput" name="month" min="@minValue" required class="form-control me-2" style="width: 200px;" />
                                <button class="btn btn-primary" type="submit">Generate Forecast</button>
                            </div>
                        </form>
                    </div>

                    <hr />


                    <div class="p-4 bg-white rounded shadow-sm mb-4">


                        <h4 class="mb-3">Dashboard Info</h4>
                        <div class="dashboard-info">
                            <p><strong>Dashboard ID:</strong> @Model.GetDashBoardID()</p>
                            <p><strong>Generated Date:</strong> @Model.GetGeneratedDate()</p>
                        <p><strong>Start Date:</strong> @Model.GetStartDate().ToString("dd MMM yyyy")</p>
                            <p><strong>End Date:</strong> @Model.GetEndDate().ToString("dd MMM yyyy")</p>
                        </div>
                    @* <h4>💲 Apply Price Adjustment</h4> *@
               

                    <!-- Metrics container wrapped in a div for partial updates -->
                    <div id="metrics-container">
                        @Html.Partial("_MetricsPartial", Model)
                    </div>
                    </div>
                    <hr />


                    
                </div>
                <!-- End Page Content -->
