<div class="container-fluid p-4">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 px-4">Forecast Dashboard</h1>
    </div>

    <div class="p-4 bg-white rounded shadow-sm mb-4">
        <h4 class="mb-3 d-flex align-items-center">
            <i class="fas fa-chart-line me-2"></i> Forecast Trend (Next 12 Months)
        </h4>

        <div class="mb-3">
            <label for="productSelect" class="form-label">Select Product:</label>
            <select id="productSelect" class="form-select">
                @* <option value="0">All Products</option> *@
            </select>
        </div>

        <canvas id="forecastTrendChart" width="800" height="400" class="mb-4"></canvas>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <script>
            const trendData = @Html.Raw(JsonSerializer.Serialize(ViewBag.TrendData));

            // Compute aggregated data for "All Products" on the frontend
            const aggregatedLabels = [];
            const aggregatedValues = [];
            for (const month in trendData) {
                aggregatedLabels.push(month);
                let total = 0;
                for (const prodId in trendData[month]) {
                    total += trendData[month][prodId].ForecastedStock;
                }
                aggregatedValues.push(total);
            }

            // Initialize the Chart.js line chart with the aggregated data
            const ctx = document.getElementById('forecastTrendChart').getContext('2d');
            let trendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: aggregatedLabels,
                    datasets: [{
                        label: 'Forecast Value (All Products)',
                        data: aggregatedValues,
                        fill: false,
                        borderColor: 'rgba(75, 192, 192, 1)',
                        tension: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Build a mapping of product IDs to product names from trendData
            const productNames = {};
            for (const month in trendData) {
                for (const prodId in trendData[month]) {
                    if (!productNames[prodId]) {
                        productNames[prodId] = trendData[month][prodId].ProductName;
                    }
                }
            }

            // Populate the dropdown with product names (with an "All Products" option first)
            const dropdown = document.getElementById('productSelect');
            const allOption = document.createElement('option');
            allOption.value = "0";
            allOption.text = "All Products";
            dropdown.appendChild(allOption);

            const productList = Object.keys(productNames).sort();
            productList.forEach(prodId => {
                const option = document.createElement('option');
                option.value = prodId;
                option.text = productNames[prodId];
                dropdown.appendChild(option);
            });

            // Function to update the chart based on the selected product
            function updateChartForProduct(productId) {
                if (parseInt(productId) === 0) {
                    // "All Products": use aggregated data
                    trendChart.data.labels = aggregatedLabels;
                    trendChart.data.datasets[0].data = aggregatedValues;
                    trendChart.data.datasets[0].label = "Forecast Value (All Products)";
                } else {
                    const newLabels = [];
                    const newValues = [];
                    // For each month, pick the forecast for the selected product (or 0 if missing)
                    for (const month in trendData) {
                        newLabels.push(month);
                        const productMap = trendData[month];
                        newValues.push(productMap[productId] ? productMap[productId].ForecastedStock : 0);
                    }
                    trendChart.data.labels = newLabels;
                    trendChart.data.datasets[0].data = newValues;
                    trendChart.data.datasets[0].label = "Forecast Value (" + productNames[productId] + ")";
                }
                trendChart.update();
            }

            // Listen for changes in the dropdown to update the chart
            document.getElementById('productSelect').addEventListener('change', function() {
                updateChartForProduct(this.value);
            });
        </script>

    </div>

    <div class="p-4 bg-white rounded shadow-sm mb-4">
        <h4 class="mb-3 d-flex align-items-center">
            <i class="fas fa-sync-alt me-2"></i> Generate New Forecast
        </h4>

        <div class="mb-4 text-center">
            <div class="fw-bold mb-2">Quick Select:</div>
            <div class="d-flex flex-wrap justify-content-center">
                @foreach (var chip in quickChips)
                {
                    <form method="post" action="/Forecast/GenerateForecast" class="d-inline">
                        <input type="hidden" name="type" value="stock" />
                        <input type="hidden" name="month" value="@chip" />
                        <button type="submit" class="quick-select-chip btn btn-light border rounded-pill px-3 mx-1 my-1">
                            @chip
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1" />
            <span class="mx-2 text-muted fw-bold">or</span>
            <hr class="flex-grow-1" />
        </div>

        <div class="text-center">
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">
                <form method="post" action="/Forecast/GenerateForecast" class="d-flex justify-content-center align-items-center gap-2">
                    <input type="hidden" name="type" value="stock" />

                    <label for="monthInput" class="fw-bold me-2">Select Forecast Month:</label>
                    <input type="month" id="monthInput" name="month" min="@minValue" required class="form-control w-auto" />

                    <button class="btn btn-primary ms-2" type="submit">Generate Forecast</button>
                </form>
                <form asp-controller="Report" asp-action="PreviewReport" method="get" style="display: inline;">
                    <input type="hidden" name="selectedDashboards" value="Forecast" />
                    <button type="submit" class="btn btn-secondary">Generate Report</button>
                </form>
            </div>
        </div>
    </div>

    <hr />

    <div class="p-4 bg-white rounded shadow-sm mb-4">
        <div class="row">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="dashboard-info">
                            <h4 class="mb-0 d-flex align-items-center pb-2">
                                <i class="fas fa-chart-line me-2"></i> Dashboard Info
                            </h4>
                            <p><strong>Dashboard ID:</strong> @Model.GetDashBoardID()</p>
                            <p><strong>Generated Date:</strong> @Model.GetGeneratedDate()</p>
                            <p><strong>Start Date:</strong> @Model.GetStartDate().ToString("dd MMM yyyy")</p>
                            <p><strong>End Date:</strong> @Model.GetEndDate().ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        <canvas id="forecastGraph" width="800" height="400"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div id="metrics-wrapper">
            <div id="metrics-container">
                @Html.Partial("_MetricsPartial", Model)
            </div>
        </div>

        <hr />
    </div>
</div>



