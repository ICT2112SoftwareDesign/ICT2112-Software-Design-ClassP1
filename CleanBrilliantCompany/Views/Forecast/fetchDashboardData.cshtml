@model CleanBrilliantCompany.Models.Forecast.ForecastDashboard

@{
    ViewData["Title"] = "Forecast Dashboard";
    var minAllowed = DateTime.Today.AddMonths(1);
    var minValue = minAllowed.ToString("yyyy-MM"); // Format as "yyyy-MM"
    var quickChips = new List<string> //for quick select
    {
        minAllowed.ToString("yyyy-MM"),
        minAllowed.AddMonths(1).ToString("yyyy-MM"),
        minAllowed.AddMonths(2).ToString("yyyy-MM"),
                minAllowed.AddMonths(3).ToString("yyyy-MM"),
                        minAllowed.AddMonths(4).ToString("yyyy-MM")


    };
}

