@using CleanBrilliantCompany.Models
@model List<FeedbackRDM>

@{
    ViewData["Title"] = "Manager Feedback Management";
}

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @* <!-- Custom fonts for this template-->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="css/sb-admin-2.min.css" rel="stylesheet"> *@

    <!-- Font Awesome -->
    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,400,600,700,800,900" rel="stylesheet">

    <!-- SB Admin CSS -->
    <link href="css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body id="page-top">
    <div id="wrapper">

        @await Html.PartialAsync("_Sidebar")

        <div id="content-wrapper" style="padding-top: 0;">
            <div class="dashboard-content px-4">
                <div id="content" class="dashboard-container">
                    <h2 class="h2 mb-0 text-gray-800">Manager Feedback Management</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card p-4 mt-4 shadow-sm">
        <h4>All Feedback</h4>
        @if (Model != null && Model.Count > 0)
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Feedback</th>
                        <th>Staff Name</th>
                        <th>Status</th>
                        <th>Manager Comments</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feedback in Model)
                    {
                        <tr>
                            <td>@feedback.Feedback</td>
                            <td>@feedback.StaffName</td>
                            <td>
                                @if (feedback.Status == "Resolved")
                                {
                                    <span class="badge bg-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@feedback.Status</span>
                                }
                            </td>
                            <td>
                                <textarea class="form-control manager-comment" data-feedback-id="@feedback.FeedbackId" placeholder="Add comment">@feedback.ManagerComments</textarea>
                                <button class="btn btn-primary btn-sm mt-2 save-comment" data-feedback-id="@feedback.FeedbackId">Save Comment</button>
                            </td>
                            <td>
                                <button class="btn btn-success btn-sm resolve-feedback" data-feedback-id="@feedback.FeedbackId">Resolve</button>
                                <button class="btn btn-danger btn-sm delete-feedback" data-feedback-id="@feedback.FeedbackId">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No feedback available.</p>
        }
    </div>
                    
                </div>

            </div>
        </div>
    </div>
</body>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        setTimeout(function () {
            let successAlert = document.querySelector(".alert-success");
            if (successAlert) {
                successAlert.classList.add("fade");
                setTimeout(() => successAlert.remove(), 500);
            }
        }, 3000);

        document.querySelectorAll(".save-comment").forEach(button => {
            button.addEventListener("click", function () {
                var feedbackId = this.getAttribute("data-feedback-id");
                var commentField = document.querySelector(".manager-comment[data-feedback-id='" + feedbackId + "']");
                var comment = commentField.value;

                if (comment.trim() === "") {
                    alert("Comment cannot be empty!");
                    return;
                }

                fetch("@Url.Action("SaveComment", "ManagerFeedback")", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "feedbackId=" + feedbackId + "&managerComment=" + encodeURIComponent(comment)
                }).then(() => location.reload());
            });
        });

        document.querySelectorAll(".resolve-feedback").forEach(button => {
            button.addEventListener("click", function () {
                var feedbackId = this.getAttribute("data-feedback-id");
                fetch("@Url.Action("ResolveFeedback", "ManagerFeedback")", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "feedbackId=" + feedbackId
                }).then(() => location.reload());
            });
        });

        document.querySelectorAll(".delete-feedback").forEach(button => {
            button.addEventListener("click", function () {
                var feedbackId = this.getAttribute("data-feedback-id");
                fetch("@Url.Action("DeleteFeedback", "ManagerFeedback")", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "feedbackId=" + feedbackId
                }).then(() => location.reload());
            });
        });
    });
</script>

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: "Nunito", sans-serif;
    }

    #wrapper {
        display: flex;
        min-height: 100%;
        width: 100%;
    }

    .sidebar {
        position: relative;
        width: 250px;
        background-color: #4e73df;
        color: white;
        min-height: 100%;
        margin-top: 1rem;
    }

    #content-wrapper {
        margin-left: 0;
        width: 100%;
        padding: 0 !important;
        box-sizing: border-box;
        margin-top: 1rem;
    }

    .dashboard-content {
        padding-left: 20px;
        padding-right: 20px;
    }

    .dashboard-container {
        max-width: 100%;
    }

    .container,
    .container-fluid {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 20px;
    }

    .chart-container {
        position: relative;
        width: 100%;
        max-width: 900px;
        height: 300px;
        margin: 0 auto;
    }

    canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    .topbar {
        box-shadow: 0 0.15rem 1rem 0 rgba(58, 59, 69, .15);
    }
</style>

