@{
    ViewData["Title"] = "Preview Report";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="loading">Generating PDF, please wait...</div>

<h2>Generated Report</h2>

<iframe id="pdfFrame" src="@Url.Action("GetReportPdf", "Report")" width="100%" height="800px"
    style="border: 1px solid #ccc; display:none;"></iframe>

<div style="margin-top: 20px;">
    <a href="@Url.Action("GetReportPdf", "Report")" class="btn btn-primary" download>
        Download Report
    </a>
</div>

<h2>Select Dashboards</h2>

<form asp-action="GenerateSelectedReport" method="post">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Aging" id="agingCheck">
        <label class="form-check-label" for="agingCheck">Aging Dashboard</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Manufacturer"
            id="manufacturerCheck">
        <label class="form-check-label" for="manufacturerCheck">Manufacturer Dashboard</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Cost" id="costCheck">
        <label class="form-check-label" for="costCheck">Cost Dashboard</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Inventory" id="inventoryCheck">
        <label class="form-check-label" for="inventoryCheck">Inventory Dashboard</label>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Generate Report</button>
</form>

<script>
    const frame = document.getElementById('pdfFrame');
    const loading = document.getElementById('loading');
    frame.onload = function () {
        loading.style.display = "none";
        frame.style.display = "block";
    };
</script>
