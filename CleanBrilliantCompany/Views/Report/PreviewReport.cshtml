@using Azure.Core
@{
    ViewData["Title"] = "Preview Report";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var selectedDashboards = Context.Request.Query["selectedDashboards"].ToString().Split(",").ToList();
}

<div class="container py-5">
    <h1 class="mb-3">📝 Generate Custom Report</h1>
    <p class="text-muted">Select which dashboards you want to include in the consolidated AI-generated report.</p>

    <form asp-controller="Report" asp-action="GenerateSelectedReport" method="post" id="dashboardForm">
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Aging"
                        id="agingCheck" @(selectedDashboards.Contains("Aging") ? "checked" : "") />
                    <label class="form-check-label" for="agingCheck">
                        <i class="fas fa-hourglass-half me-1"></i> Aging Dashboard
                    </label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Manufacturer"
                        id="manufacturerCheck" @(selectedDashboards.Contains("Manufacturer") ? "checked" : "") />
                    <label class="form-check-label" for="manufacturerCheck">
                        <i class="fas fa-industry me-1"></i> Manufacturer Dashboard
                    </label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Cost"
                        id="costCheck" @(selectedDashboards.Contains("Cost") ? "checked" : "") />
                    <label class="form-check-label" for="costCheck">
                        <i class="fas fa-dollar-sign me-1"></i> Cost Dashboard
                    </label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Inventory"
                        id="inventoryCheck" @(selectedDashboards.Contains("Inventory") ? "checked" : "") />
                    <label class="form-check-label" for="inventoryCheck">
                        <i class="fas fa-boxes me-1"></i> Inventory Dashboard
                    </label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedDashboards" value="Forecast"
                        id="forecastCheck" @(selectedDashboards.Contains("Forecast") ? "checked" : "") />
                    <label class="form-check-label" for="forecastCheck">
                        <i class="fas fa-chart-line me-1"></i> Forecast Dashboard
                    </label>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-lg" id="generateBtn">
                <i class="fas fa-file-alt me-2"></i> Generate Report
            </button>
        </div>
    </form>
    <div class="mt-5">
        <h5><i class="fas fa-file-pdf"></i> This is what your PDF will look like</h5>
        <p class="text-muted">Once generated, your customized report will be displayed in this frame.</p>

        <div class="border rounded shadow-sm mt-3" style="height: 600px; overflow: hidden;">
            <iframe src="@Url.Action("GetReportPdf", "Report")" id="pdfPreviewFrame" width="100%" height="100%"
                style="border: none; pointer-events: none; opacity: 0.6;">
            </iframe>
        </div>
    </div>

    <div id="loadingMessage" class="mt-5 text-center" style="display:none;">
        <div class="spinner-border text-primary mb-2" role="status">
            <span class="visually-hidden">Generating...</span>
        </div>
        <p>Generating your report. Please wait...</p>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('dashboardForm');
        const loading = document.getElementById('loadingMessage');
        const generateBtn = document.getElementById('generateBtn');

        form.addEventListener('submit', () => {
            form.style.display = 'none';
            loading.style.display = 'block';
        });
    </script>
}
