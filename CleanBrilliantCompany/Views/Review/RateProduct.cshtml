@{
    ViewBag.Title = "Rate Product";
}

<h2>@ViewBag.ProductName</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (ViewBag.ReviewId != null)
{
    <!-- Edit Review Form -->
    <form asp-controller="CustomerPage" asp-action="redirectToSubmitEditedReview" method="post">
        <input type="hidden" name="reviewId" value="@ViewBag.ReviewId" />
        <input type="hidden" name="productId" value="@ViewBag.ProductId" />

        <div class="form-group">
            <label for="reviewText">Edit Review:</label>
            <textarea class="form-control" name="reviewText" required>@ViewBag.ReviewText</textarea>
        </div>

        <div class="form-group">
            <label for="rating">Rating (1 to 5):</label>
            <input type="number" class="form-control" name="rating" min="1" max="5" value="@ViewBag.Rating" required />
        </div>

        <button type="submit" class="btn btn-warning">Update Review</button>
    </form>

    <br />

    <!-- Delete Review Button -->
    <form asp-controller="CustomerPage" asp-action="redirectToDeleteReview" method="post">
        <input type="hidden" name="reviewId" value="@ViewBag.ReviewId" />
        <button type="submit" class="btn btn-danger">Delete Review</button>
    </form>
}
else
{
    <!-- Submit New Review Form -->
    <form asp-controller="CustomerPage" asp-action="redirectToSubmitReview" method="post">
        <input type="hidden" name="productId" value="@ViewBag.ProductId" />

        <div class="form-group">
            <label for="reviewText">Write a Review:</label>
            <textarea class="form-control" name="reviewText" required></textarea>
        </div>

        <div class="form-group">
            <label for="rating">Rating (1 to 5):</label>
            <input type="number" class="form-control" name="rating" min="1" max="5" required />
        </div>

        <button type="submit" class="btn btn-primary">Submit Review</button>
    </form>
}
