<!DOCTYPE html>
<html lang="en">

@model List<CleanBrilliantCompany.Models.Entity.Transaction>

@{
    ViewData["Title"] = "Transaction List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>SB Admin 2 - Dashboard</title>

</head>

<body id="page-top">

<!-- Begin Page Content -->
<div class="container-fluid">
    <h2>Transaction Log Overview</h2>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 15px; margin-bottom: 20px;">

    <!-- Form: Search by Date -->
    <form method="get" style="display: flex; align-items: center; gap: 10px;">
        <label for="searchDate" style="white-space: nowrap;">Search by Date:</label>
        <input type="date" name="searchDate" id="searchDate" class="form-control"
               placeholder="Search by date: mm/dd/yyyy"
               style="margin-right: 10px; padding: 6px 10px;" />
        <button type="submit" class="btn btn-primary" style="margin-right: 20px;">Search</button>
    </form>

    <!-- Form: Filter by Adjustment Type -->
    <form method="get" style="display: flex; align-items: center;">
        <label for="adjustmentType" style="margin-right: 10px;">Select Adjustment Type:</label>
        <select name="adjustmentType" id="adjustmentType" class="form-select"
                style="margin-right: 10px; padding: 6px 10px;">
            <option value="All">All</option>
            <option value="Sold">Sold</option>
            <option value="Reserved">Reserved</option>
            <option value="Transferred">Transferred</option>
            <option value="Refunded">Refunded</option>
            <option value="Returned">Returned</option>
        </select>
        <button type="submit" class="btn btn-secondary">Filter</button>
    </form>

    <form method="get" asp-controller="Transaction" asp-action="Index">
        <input type="number" name="itemId" placeholder="Enter Item ID" class="form-control" style="width: 200px; display: inline-block;" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

</div>

<h2>All Transactions Counts</h2>


<!-- Display Counts for Each Adjustment Type -->
<div class="row">
    <div class="col-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Sold</h5>
                <p class="card-text">@ViewData["TotalSoldCount"]</p>
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Reserved</h5>
                <p class="card-text">@ViewData["TotalReservedCount"]</p>
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Transferred</h5>
                <p class="card-text">@ViewData["TotalTransferredCount"]</p>
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Refunded</h5>
                <p class="card-text">@ViewData["TotalRefundedCount"]</p>
            </div>
        </div>
    </div>
</div>

@if (ViewData["TransactionsByDate"] != null)
{
    <h2>Transactions for @ViewData["SearchDate"]</h2>

        <!-- Button to switch between views -->
    <div>
        <button type="button" onclick="toggleView('tableView')" class="btn btn-primary">Table View</button>
        <button type="button" onclick="toggleView('fullView')" class="btn btn-primary">Full View</button>
    </div>

    <!-- Table View (hidden by default) -->
    <div id="tableView" style="display: block;">
        <table class="table">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>Transaction Date Time</th>
                    <th>Adjustment Type</th>
                    <th>Product ID</th>
                    <th>Item ID</th>
                    <th>Staff ID</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var TransactionInfo in ViewData["TransactionsByDate"] as List<Dictionary<string, object>>)
            {
                <tr>
                    <td>@TransactionInfo["TransactionId"]</td>
                    <td>@Convert.ToDateTime(TransactionInfo["TransactionDateTime"]).ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@TransactionInfo["AdjustmentType"]</td>
                    <td>@TransactionInfo["ProductId"]</td>
                    <td>@TransactionInfo["ItemId"]</td>
                    <td>@TransactionInfo["StaffId"]</td>
                </tr>
            }
            </tbody>
        </table>

        <!-- Show message if no transactions found for the selected date -->
        @if ((ViewData["TransactionsByDate"] as List<Dictionary<string, object>>).Count == 0)
        {
            <p>No transactions found for the selected date.</p>
        }
    </div>

    <!-- Full View (hidden by default) -->
    <div id="fullView" style="display: none;">
        @foreach (var TransactionInfo in ViewData["TransactionsByDate"] as List<Dictionary<string, object>>)
        {
            <p>
                @string.Format("{0} [Item Id {1}] was returned to Manufacturer {2} by staff {3} at {4}",
                    TransactionInfo["ProductName"],
                    TransactionInfo["ItemId"],
                    "Manufacturer 1",  
                    TransactionInfo["StaffId"],
                    Convert.ToDateTime(TransactionInfo["TransactionDateTime"]).ToString("yyyy-MM-dd HH:mm")
                )
            </p>
        }

        <!-- Show message if no transactions found for the selected date -->
        @if ((ViewData["TransactionsByDate"] as List<Dictionary<string, object>>).Count == 0)
        {
            <p>No transactions found for the selected date.</p>
        }
    </div>
}
<!-- Only show this block if no search date is provided -->
@if (ViewData["TransactionsByDate"] == null)
{
    <h2>All Transactions</h2>

    <!-- Button to switch between views -->
    <div>
        <button type="button" onclick="toggleView('tableView')" class="btn btn-primary">Table View</button>
        <button type="button" onclick="toggleView('fullView')" class="btn btn-primary">Full View</button>
    </div>

    <!-- Table View for All Transactions (hidden by default) -->
    <div id="tableView" style="display: block; margin-top: 20px;">
        <table class="table">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>Transaction Date Time</th>
                    <th>Adjustment Type</th>
                    <th>Product ID</th>
                    <th>Item ID</th>
                    <th>Staff ID</th>
                    <th>Product Name</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var TransactionInfo in ViewData["AllTransactions"] as List<Dictionary<string, object>>)
            {
                <tr>
                    <td>@TransactionInfo["TransactionId"]</td>
                    <td>@Convert.ToDateTime(TransactionInfo["TransactionDateTime"]).ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@TransactionInfo["AdjustmentType"]</td>
                    <td>@TransactionInfo["ProductId"]</td>
                    <td>@TransactionInfo["ItemId"]</td>
                    <td>@TransactionInfo["StaffId"]</td>
                    <td>@TransactionInfo["ProductName"]</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Full View for All Transactions -->
<div id="fullView" style="display: none; padding-top:20px;">
    @foreach (var TransactionInfo in ViewData["AllTransactions"] as List<Dictionary<string, object>>)
    {
        
            var adjustmentType = TransactionInfo["AdjustmentType"].ToString();
            var badgeColor = adjustmentType switch
            {
                "Sold" => "green",
                "Reserved" => "orange",
                "Transferred" => "dodgerblue",
                "Refunded" => "red",
                "Returned" => "gray",
                _ => "black"
            };

            var readableMessage = adjustmentType switch
            {
                "Sold" => $"{TransactionInfo["ProductName"]} [Item ID {TransactionInfo["ItemId"]}] was sold by staff {TransactionInfo["StaffId"]}",
                "Reserved" => $"{TransactionInfo["ProductName"]} [Item ID {TransactionInfo["ItemId"]}] was reserved by staff {TransactionInfo["StaffId"]}",
                "Transferred" => $"{TransactionInfo["ProductName"]} [Item ID {TransactionInfo["ItemId"]}] was transferred by staff {TransactionInfo["StaffId"]}",
                "Refunded" => $"{TransactionInfo["ProductName"]} [Item ID {TransactionInfo["ItemId"]}] was refunded by staff {TransactionInfo["StaffId"]}",
                "Returned" => $"{TransactionInfo["ProductName"]} [Item ID {TransactionInfo["ItemId"]}] was returned to Manufacturer 1 by staff {TransactionInfo["StaffId"]}",
                _ => $"Unknown transaction for Item ID {TransactionInfo["ItemId"]}"
            };

            var date = Convert.ToDateTime(TransactionInfo["TransactionDateTime"]).ToString("yyyy-MM-dd HH:mm");
        

        <div style="border: 1px solid #ccc; padding: 12px; margin-bottom: 12px; border-radius: 6px; background-color: #f9f9f9;">
            <div style="margin-bottom: 4px;">
                <span style="font-weight: bold;">@readableMessage</span>
            </div>
            <div style="font-size: 0.9em; color: #555;">
                <span style="margin-right: 10px;"><strong>Type:</strong> <span style="color:@badgeColor">@adjustmentType</span></span>
                <span><strong>Time:</strong> @date</span>
            </div>
        </div>
    }
</div>


    <div style="justify-self: center;">
    <a>Page</a>
    @for (int i = 1; i <= ViewBag.TotalPages; i++)
    {
        <a href="@Url.Action("Index", new { page = i, pageSize = ViewBag.PageSize })">@i</a>
        @if (i < ViewBag.TotalPages)
        {
            <span> | </span>
        }
    }
    </div>
}




                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <script type="text/javascript">
        function toggleView(view) {
            // Hide both views
            document.getElementById('tableView').style.display = 'none';
            document.getElementById('fullView').style.display = 'none';

            // Show the selected view
            document.getElementById(view).style.display = 'block';
        }
    </script>
</body>

</html> 