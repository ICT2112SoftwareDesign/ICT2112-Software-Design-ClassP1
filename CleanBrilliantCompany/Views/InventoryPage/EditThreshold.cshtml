@model CleanBrilliantCompany.DTO.InventoryDTO

@{
    // Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Threshold";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Edit Product Threshold</h1>
</div>


<div class="card shadow mb-4">
    <div class="card-body">
        <form asp-action="EditThreshold" method="post">
            <input type="hidden" asp-for="ProductId" />

            <div class="form-group">
                <label asp-for="ProductName">Product Name</label>
                <input asp-for="ProductName" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="ProductCategory">Category</label>
                <input asp-for="ProductCategory" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="Threshold">Threshold</label>
                <input asp-for="Threshold" class="form-control" type="number" min="1" />
                <span asp-validation-for="Threshold" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary" id="saveButton" disabled>Save</button>
            <a asp-action="ViewThresholds" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

        <script>
            $(document).ready(function () {
                const form = $('#thresholdForm');
                const saveButton = $('#saveButton');

                // Serialize initial form state
                const initialData = form.serialize();

                // Monitor form changes
                form.on('input change', function () {
                    const currentData = form.serialize();
                    if (currentData !== initialData) {
                        saveButton.prop('disabled', false);
                    } else {
                        saveButton.prop('disabled', true);
                    }
                });
            });
        </script>
    }
}