<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CleanBrilliantCompany</title>
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CleanBrilliantCompany.styles.css" asp-append-version="true" /> *@

    <!-- Custom fonts for this template-->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

</head>

<body>
    @if (!(ViewContext.RouteData.Values["Controller"]?.ToString() == "BeforeLoginPage" &&
       (ViewContext.RouteData.Values["Action"]?.ToString() == "Login" || 
        ViewContext.RouteData.Values["Action"]?.ToString() == "RegisterCustomer")))
    {
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="ProductInput" asp-action="viewProducts">CleanBrilliantCompany</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="ProductInput" 
                            asp-action="viewProducts">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="WishlistInput"
                                asp-action="viewWishlist">Wishlist</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="CustomerPage"
                                asp-action="redirectToCart">Cart</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="supportDropdown" 
                            role="button" data-toggle="dropdown" data-bs-toggle="dropdown" 
                            aria-haspopup="true" aria-expanded="false">
                                Support
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="supportDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="CustomerPage" 
                                    asp-action="redirectToViewFAQs">FAQs</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="CustomerPage" 
                                    asp-action="redirectToStartChatSession">Chat with us</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="CustomerPage" 
                                    asp-action="redirectToViewSupportTickets">View Support Tickets</a></li>
                            </ul>
                        </li>

                    </ul>

                     <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="CustomerInput" asp-action="CustomerDetails">
                                <i class="fa fa-user-circle" aria-hidden="true"></i> Profile
                            </a>
                        </li>
                        <li class="nav-item">
                        <form asp-controller="CustomerInput" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="nav-link text-dark border-0 bg-transparent">
                                <i class="fa fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }
    <div class="container">
<!-- Feedback Modal (Bootstrap 5 version) You can use this for your own usage -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="feedbackModalLabel">Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="feedbackMessage">
                <!-- Message will be inserted here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CleanBrilliantCompany - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

    <script>
        $(document).ready(function() {
            // Check if there's a success or error message in TempData
            @if (TempData["Success"] != null)
            {
                <text>
                    $('#feedbackModalLabel').text('Success');
                    $('#feedbackMessage').html('@TempData["Success"]');
                    $('.modal-header').addClass('bg-success text-white');
                    $('#feedbackModal').modal('show');
                </text>
            }
            else if (TempData["Info"] != null)
            {
                <text>
                    $('#feedbackModalLabel').text('Information:');
                    $('#feedbackMessage').html('@TempData["Info"]');
                    $('.modal-header').addClass('bg-info text-white');
                    $('#feedbackModal').modal('show');
                </text>
            }
            else if (TempData["Error"] != null)
            {
                <text>
                    $('#feedbackModalLabel').text('Error!');
                    $('#feedbackMessage').html('@TempData["Error"]');
                    $('.modal-header').addClass('bg-danger text-white');
                    $('#feedbackModal').modal('show');
                </text>
            }
            
            // Reset modal styling when closed
            $('#feedbackModal').on('hidden.bs.modal', function () {
                $('.modal-header').removeClass('bg-success bg-danger text-white');
            });
        });
    </script>

</html>
