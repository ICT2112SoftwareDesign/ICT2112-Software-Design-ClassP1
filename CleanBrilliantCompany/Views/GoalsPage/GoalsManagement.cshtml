@{
    ViewData["Title"] = "Goal Management";
}

<body id="page-top">
    <div id="wrapper" class="d-flex flex-nowrap min-vh-100">
           @await Html.PartialAsync("_Sidebar")

            <div class="text-center my-4">
                <h1>Goal Management</h1>
                <p>Choose an action:</p>
            </div>

            <div class="d-flex justify-content-center mt-4 gap-3">
                
                <form asp-controller="Goals" asp-action="GoalsCreation" method="get">
                    <button type="submit" class="btn btn-primary px-4 py-2">Create a New Goal</button>
                </form>

                <form asp-controller="Goals" asp-action="GoalsModification" method="get">
                    <button type="submit" class="btn btn-danger px-4 py-2">Modify an Existing Goal</button>
                </form>
            </div>

        </div>  
    </div>
</body>>