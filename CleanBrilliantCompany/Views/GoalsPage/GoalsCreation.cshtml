@model CleanBrilliantCompany.Models.Entity.GoalsSDM;

@{
    ViewData["Title"] = "Create Goal";
}

<h2>Create a Goal</h2>

<form asp-action="Create" asp-controller="GoalsInput" method="post">
    <div class="form-group">
        <label for="TargetEmission">Target Emission (kg CO2):</label>
        <input type="number" id="TargetEmission" name="TargetEmission" class="form-control" required />
    </div>

    <div>
        <label for="goalDate">Goal Date:</label>
        <input type="month" id="goalDate" name="goalDate" required />
    </div>

    <button type="submit" class="btn btn-primary">Create Goal</button>
</form>