@model CleanBrilliantCompany.Models.Entity.GoalsSDM;

@{
    ViewData["Title"] = "Create Goal";
}

<body id="page-top">
    <div id="wrapper" class="d-flex flex-nowrap min-vh-100">
           @await Html.PartialAsync("_Sidebar")

            <div class="text-center my-4">
                <h1>Create a Goal</h1>
            </div>
            <div class="d-flex justify-content-center mt-4 gap-3">
                <form id="goalForm" asp-action="Create" asp-controller="GoalsInput" method="post">
                    <div class="form-group">
                        <label for="targetEmission">Target Emission (kg CO2):</label>
                        <input type="number" id="targetEmission" name="targetEmission" class="form-control" required />
                    </div>

                    <div>
                        <label for="goalDate">Goal Date:</label>
                        <input type="month" id="goalDate" name="goalDate" required />
                    </div>

                    <button type="submit" class="btn btn-primary">Create Goal</button>
                </form>
           </div>
            <!-- Notification -->
            <div id="notification" class="alert alert-danger" style="display:none;"></div>
        </div>  
    </div>
</body>>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#goalForm").submit(function (event) {
            event.preventDefault(); // Prevent form from reloading the page

            var formData = {
                goalDate: $("#goalDate").val(),
                targetEmission: $("#targetEmission").val()
            };

            $.ajax({
                url: "/GoalsInput/Create",
                type: "POST",
                data: formData,
                success: function (response) {
                    var notification = $("#notification");
                    if (response.success) {
                        notification.removeClass("alert-danger").addClass("alert-success")
                            .text(response.message).fadeIn();

                        setTimeout(function () {
                            location.reload(); // Reload after success
                        }, 5500);
                    } else {
                        notification.removeClass("alert-success").addClass("alert-danger")
                            .text(response.message).fadeIn();
                    }
                },
                error: function () {
                    $("#notification").removeClass("alert-success").addClass("alert-danger")
                        .text("An unexpected error occurred.").fadeIn();
                }
            });
        });
    });
</script>