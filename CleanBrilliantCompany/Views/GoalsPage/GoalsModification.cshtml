@model CleanBrilliantCompany.Models.Entity.GoalsSDM;

@{
    ViewData["Title"] = "Modify Goal";
}


<h1>Modify Goal</h1>

<form asp-controller="GoalsInput" asp-action="ModifyGoal" method="post">
    <div>
        <label for="goalDate">Goal Date:</label>
        <input type="month" id="goalDate" name="goalDate" required />
    </div>

    <div>
        <label for="targetEmission">Target Emission:</label>
        <input type="number" id="targetEmission" name="targetEmission" required />
    </div>

    <button type="submit">Update Goal</button>
</form>