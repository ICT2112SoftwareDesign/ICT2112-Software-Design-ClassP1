@model List<CleanBrilliantCompany.Models.OrderRDM>

@{
    var shippingDetails = ViewBag.ShippingDetails as Dictionary<int, Dictionary<string, string>>;
}
<div class="container mt-5">
    <h3 class="font-weight-bold mb-4">Order Status</h3>

    <!-- First Row: Navigation for To Pay, To Ship, To Receive -->
    <div class="row mb-4">
        <!-- To Pay -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ViewCart" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-wallet" style="margin-right: 5px;"></i>To Pay</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- To Ship -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ToShip" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-box" style="margin-right: 5px;"></i>To Ship</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- To Receive -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ToReceive" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-truck" style="margin-right: 5px;"></i>To Receive</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Second Row: Navigation for Completed, Refund, Cancelled -->
    <div class="row mb-4">
        <!-- Completed -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="Completed" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-check-circle" style="margin-right: 5px; color: green;"></i>Completed</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Refund -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="Refund" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-undo" style="margin-right: 5px; color: orange;"></i>Refund</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Cancelled -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="Cancelled" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-times-circle" style="margin-right: 5px; color: red;"></i>Cancelled</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Completed Orders Section -->
    <h3 class="font-weight-bold mb-4">Completed Orders</h3>
    @foreach (var order in Model)
    {
        var details = (shippingDetails != null && shippingDetails.ContainsKey(order.OrderID)) ? shippingDetails[order.OrderID] : null;
        // Dynamically set the header color based on the order status
        var headerClass = order.Status == "Cancelled" ? "bg-danger text-white" : "bg-success text-white";
        <div class="card mb-4 shadow-sm">
            <div class="card-header @headerClass">
                <h5 class="mb-0">Order ID: @order.OrderID</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Order Details -->
                    <div class="col-md-6">
                        <h6 class="font-weight-bold">Order Details</h6>
                        <p><strong>Status:</strong> @order.Status</p>
                        <p><strong>Total Price:</strong> $@order.OrderTotal</p>
                    </div>

                    <!-- Shipping Details -->
                    @if (details != null)
                    {
                        <div class="col-md-6">
                            <h6 class="font-weight-bold">Shipping Details</h6>
                            <p><strong>Service Type:</strong> @details["ServiceType"]</p>
                            <p><strong>Shipping Method:</strong> @details["ShippingMethod"]</p>
                            <p><strong>Shipping Agent:</strong> @details["ShippingAgent"]</p>
                            <p><strong>Shipping Fee:</strong> $@(details.ContainsKey("ShippingFee") ? details["ShippingFee"] : "0.00")</p>
                        </div>
                    }
                </div>

                <!-- Product Details -->
                <div class="mt-4">
                    <h6 class="font-weight-bold">Products</h6>
                    <ul class="list-group">
                        @foreach (var product in order.OrderProductsDetails)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Product Name:</strong> @product.Value["ProductName"] <br />
                                        <strong>Quantity:</strong> @order.OrderProducts[product.Key] <br />
                                        <strong>Price:</strong> $@product.Value["CostPrice"]
                                    </div>
                                    @{
                                        var reviewedProducts = ViewBag.ReviewedProductIds as HashSet<int>;
                                        bool isReviewed = reviewedProducts != null && reviewedProducts.Contains(product.Key);
                                    }
                                   @if (!isReviewed)
                                    {
                                        <form method="get" asp-action="RateProduct" asp-controller="CustomerPage">
                                            <input type="hidden" name="productId" value="@product.Key" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm">Rate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-success">✔️ Already Reviewed</span>
                                          <form method="get" asp-action="EditReview" asp-controller="CustomerPage">
                                            <input type="hidden" name="productId" value="@product.Key" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm">Edit Review</button>
                                        </form>
                                    }
                                </li>
                            }
                    </ul>
                </div>

                <!-- Request Refund Button -->
                <!-- <div class="mt-3">
                    <form>
                        <input type="hidden" name="orderId" value="@order.OrderID" />
                        <button type="submit" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#refundModal-@order.OrderID">Request Refund</button>
                    </form>
                </div> -->

                <div class="mt-3">
            
                    <input type="hidden" name="orderId" value="@order.OrderID" />
                    <button type="submit" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#refundModal-@order.OrderID">Request Refund</button>

                </div>

                <!-- Refund Modal -->
                <div class="modal fade" id="refundModal-@order.OrderID" tabindex="-1" aria-labelledby="refundModalLabel-@order.OrderID" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                        <!-- asp-action="RequestRefund" method="post" -->
                            <form asp-action="RequestRefund" method="post" enctype="multipart/form-data">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="refundModalLabel-@order.OrderID">Request Refund for Order ID: @order.OrderID</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                <div class="modal-body">
                                    <input type="hidden" name="orderId" value="@order.OrderID" />

                                    <!-- Refund Reason -->
                                    <div class="mb-3">
                                        <label for="refundReason-@order.OrderID" class="form-label">Reason for Refund:</label>
                                        <textarea class="form-control" id="refundReason-@order.OrderID" name="refundReason" rows="3" required></textarea>
                                    </div>

                                    <!-- Upload Image -->
                                    <div class="mb-3">
                                        <label for="refundImage-@order.OrderID" class="form-label">Upload Image (optional):</label>
                                        <input type="file" class="form-control" id="refundImage-@order.OrderID" name="refundImage" accept="image/*">
                                    </div>

                                    <!-- Upload Video -->
                                    <div class="mb-3">
                                        <label for="refundVideo-@order.OrderID" class="form-label">Upload Video (optional):</label>
                                        <input type="file" class="form-control" id="refundVideo-@order.OrderID" name="refundVideo" accept="video/*">
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-warning">Submit Refund Request</button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    }
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>


