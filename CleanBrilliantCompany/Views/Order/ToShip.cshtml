@model List<CleanBrilliantCompany.Models.OrderRDM>
@{
    var shippingDetails = ViewBag.ShippingDetails as Dictionary<int, Dictionary<string, string>>;
}

<div class="container mt-5">
    <h3 class="font-weight-bold mb-4">To Ship Orders</h3>

    <!-- Four smaller cards in a row -->
    <div class="row mb-4">
        <!-- To Pay -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ViewCart" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-wallet" style="margin-right: 5px;"></i>To Pay</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- To Ship -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ToShip" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-box" style="margin-right: 5px;"></i>To Ship</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- To Receive -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="ToReceive" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-truck" style="margin-right: 5px;"></i>To Receive</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Completed -->
        <div class="col-sm-3 mb-3">
            <a asp-controller="CustomerPage" asp-action="Completed" class="text-decoration-none">
                <div class="card text-center" style="cursor: pointer;">
                    <div class="card-body">
                        <p class="card-text"><i class="fas fa-check" style="margin-right: 5px;"></i>Completed</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
    
    @foreach (var order in Model)
    {
        var details = (shippingDetails != null && shippingDetails.ContainsKey(order.GetOrderID())) ? shippingDetails[order.GetOrderID()] : null;
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Order ID: @order.GetOrderID()</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Order Details -->
                    <div class="col-md-6">
                        <h6 class="font-weight-bold">Order Details</h6>
                        <p><strong>Status:</strong> @order.GetStatus()</p>
                        <p><strong>Total Price:</strong> $@order.GetOrderTotal()</p>
                    </div>

                    <!-- Shipping Details -->
                    @if (details != null)
                    {
                        <div class="col-md-6">
                            <h6 class="font-weight-bold">Shipping Details</h6>
                            <p><strong>Service Type:</strong> @details["ServiceType"]</p>
                            <p><strong>Shipping Method:</strong> @details["ShippingMethod"]</p>
                            <p><strong>Shipping Agent:</strong> @details["ShippingAgent"]</p>
                            <p><strong>Shipping Fee:</strong> $@(details.ContainsKey("ShippingFee") ? details["ShippingFee"] : "0.00")</p>
                        </div>
                    }
                </div>

                <!-- Product Details -->
                <div class="mt-4">
                    <h6 class="font-weight-bold">Products</h6>
                    <ul class="list-group">
                        @foreach (var product in order.GetOrderProductsDetails())
                        {
                            <li class="list-group-item">
                                <strong>Product Name:</strong> @product.Value["ProductName"] <br />
                                <strong>Quantity:</strong> @order.GetOrderProducts()[product.Key] <br />
                                <strong>Price:</strong> $@product.Value["CostPrice"]
                            </li>
                        }
                    </ul>
                </div>

                <!-- Cancel Button -->
                <div class="mt-3">
                    <form asp-action="CancelOrder" method="post">
                        <input type="hidden" name="orderId" value="@order.GetOrderID()" />
                        <button type="submit" class="btn btn-danger">Cancel Order</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>