@{
    ViewBag.Title = "Payment";
    var cartTotal = ViewBag.CartTotal ?? 0m;
    var shippingFee = ViewBag.ShippingFee ?? 0m;
    var finalTotal = ViewBag.FinalTotal ?? 0m;
    var orderDetails = ViewBag.OrderDetails as Dictionary<string, string>;
}

<div class="container mt-5">
    <h2 class="text-center">Payment</h2>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h4>Order Summary</h4>
                </div>
                <div class="card-body">
                    <p><strong>Delivery Address:</strong> @orderDetails["DeliveryAddress"]</p>
                    <p><strong>Service Type:</strong> @orderDetails["ServiceType"]</p>
                    <p><strong>Shipping Type:</strong> @orderDetails["ShippingType"]</p>
                    <p><strong>Shipping Agent:</strong> @orderDetails["ShippingAgent"]</p>
                    <hr>
                    <p><strong>Products Total:</strong> @cartTotal.ToString("C")</p>
                    <p><strong>Shipping Fee:</strong> @shippingFee.ToString("C")</p>
                    <h4 class="text-right"><strong>Total Amount:</strong> @finalTotal.ToString("C")</h4>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Payment Details</h4>
                </div>
                <div class="card-body">
                    <form asp-action="processPayment" method="post">
                        <!-- Hidden fields to pass order details -->
                        <input type="hidden" name="deliveryAddress" value="@orderDetails["DeliveryAddress"]" />
                        <input type="hidden" name="serviceType" value="@orderDetails["ServiceType"]" />
                        <input type="hidden" name="shippingType" value="@orderDetails["ShippingType"]" />
                        <input type="hidden" name="shippingAgent" value="@orderDetails["ShippingAgent"]" />
                        
                        <div class="form-group">
                            <label for="cardName">Cardholder Name</label>
                            <input type="text" id="cardName" name="cardName" class="form-control" required />
                        </div>
                        
                        <div class="form-group">
                            <label for="cardNumber">Card Number</label>
                            <input type="text" id="cardNumber" name="cardNumber" class="form-control" 
                                   placeholder="XXXX XXXX XXXX XXXX" required />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="expiryDate">Expiry Date</label>
                                    <input type="text" id="expiryDate" name="expiryDate" class="form-control" 
                                           placeholder="MM/YY" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="cvv">CVV</label>
                                    <input type="text" id="cvv" name="cvv" class="form-control" 
                                           placeholder="XXX" required />
                                </div>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-block mt-4">Confirm Payment</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>