@{
    ViewBag.Title = "Checkout";
    var products = ViewBag.Products as Dictionary<int, Dictionary<string, object>>;
    var cart = ViewBag.Cart as Dictionary<int, int>;
    var cartTotal = ViewBag.CartTotal ?? 0m;
    var customerAddress = ViewBag.CustomerAddress as string ?? string.Empty;
    var shippingFee = ViewBag.ShippingFee ?? 0m;
    var finalTotal = ViewBag.FinalTotal ?? (cartTotal + shippingFee);
    var shippingAgents = ViewBag.ShippingAgents as List<string> ?? new List<string>();
    var serviceTypes = ViewBag.ServiceTypes as List<string> ?? new List<string>();
    var shippingMethods = ViewBag.ShippingMethods as List<string> ?? new List<string>();
    var selectedServiceType = ViewBag.SelectedServiceType as string ?? string.Empty;
    var selectedShippingType = ViewBag.SelectedShippingType as string ?? string.Empty;
    var selectedShippingAgent = ViewBag.SelectedShippingAgent as string ?? string.Empty;
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Checkout</h2>

    @if (cart == null || !cart.Any())
    {
        <div class="alert alert-info text-center">
                Your cart is empty. <a asp-controller="CustomerPage" asp-action="GetAllProducts">Continue shopping</a>.
        </div>
    }
    else
    {
        <div class="row">
            <!-- Shipping Details -->
            <div class="col-md-6">
                <h4 class="mb-3">Shipping Details</h4>
                <form id="checkoutForm" asp-action="Checkout" method="post">
                    <div class="form-group">
                        <label for="deliveryAddress">Shipping Address (Postal Code, Street Name & Building Unit)</label>
                        <textarea id="deliveryAddress" name="deliveryAddress" class="form-control" rows="3" placeholder="Enter your delivery address" required>@ViewBag.CustomerAddress</textarea>
                    </div>
                    <div class="form-group">
                        <label for="serviceType">Delivery Time</label>
                        <select id="serviceType" name="serviceType" class="form-control">
                            @foreach (var serviceOption in serviceTypes)
                            {
                                if (serviceOption == selectedServiceType)
                                {
                                    <option value="@serviceOption" selected>@serviceOption</option>
                                }
                                else
                                {
                                    <option value="@serviceOption">@serviceOption</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="shippingType">Shipping Type</label>
                        <select id="shippingType" name="shippingType" class="form-control">
                            @foreach (var shippingOption in shippingMethods)
                            {
                                if (shippingOption == selectedShippingType)
                                {
                                    <option value="@shippingOption" selected>@shippingOption</option>
                                }
                                else
                                {
                                    <option value="@shippingOption">@shippingOption</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="shippingAgent">Shipping Agent</label>
                        <select id="shippingAgent" name="shippingAgent" class="form-control">
                            @foreach (var agent in shippingAgents)
                            {
                                if (agent == selectedShippingAgent)
                                {
                                    <option value="@agent" selected>@agent</option>
                                }
                                else
                                {
                                    <option value="@agent">@agent</option>
                                }
                            }
                        </select>
                    </div>
                </form>
            </div>

            <!-- Order Summary -->
            <div class="col-md-6">
                <h4 class="mb-3">Order Summary</h4>
                <table class="table table-hover table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>Product Name</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in cart)
                        {
                            var product = products[item.Key];
                            <tr>
                                <td>@product["ProductName"]</td>
                                <td>@item.Value</td>
                                <td>$@(Convert.ToDecimal(product["CostPrice"]) * item.Value)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="text-right mt-3">
                    <h5>Total Product Price: @cartTotal.ToString("C")</h5>
                    <h5>Total Shipping Fee: @shippingFee.ToString("C")</h5>
                    <h4><strong>Total: @finalTotal.ToString("C")</strong></h4>
                </div>
            </div>
        </div>

        <!-- Place Order Button -->
        <div class="text-center mt-4">
            <form asp-action="PlaceOrder" method="post">
                <input type="hidden" id="hiddenDeliveryAddress" name="deliveryAddress" value="@customerAddress" />
                <input type="hidden" name="serviceType" value="@selectedServiceType" />
                <input type="hidden" name="shippingType" value="@selectedShippingType" />
                <input type="hidden" name="shippingAgent" value="@selectedShippingAgent" />
                <button type="submit" class="btn btn-primary btn-block" id="placeOrderButton">Place Order</button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Validate the deliveryAddress field before submitting the form
        document.getElementById('placeOrderButton').addEventListener('click', function (event) {
            const deliveryAddress = document.getElementById('deliveryAddress').value.trim();
            if (!deliveryAddress) {
                alert('Delivery address is required. Please enter your delivery address.');
                event.preventDefault(); // Prevent form submission
            }
        });

        // Update the hidden deliveryAddress field in the PlaceOrder form
        document.getElementById('deliveryAddress').addEventListener('input', function () {
            document.getElementById('hiddenDeliveryAddress').value = this.value;
        });
        document.getElementById('serviceType').addEventListener('change', function () {
            document.getElementById('checkoutForm').submit();
        });
        document.getElementById('shippingType').addEventListener('change', function () {
            document.getElementById('checkoutForm').submit();
        });
        document.getElementById('shippingAgent').addEventListener('change', function () {
            document.getElementById('checkoutForm').submit();
        });
    </script>
}