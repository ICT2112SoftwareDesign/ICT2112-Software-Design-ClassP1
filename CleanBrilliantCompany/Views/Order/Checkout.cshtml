@{
    ViewBag.Title = "Checkout";
    var products = ViewBag.Products as Dictionary<int, Dictionary<string, object>>;
    var cart = ViewBag.Cart as Dictionary<int, int>;
    var cartTotal = ViewBag.CartTotal;
    var customerAddress = ViewBag.CustomerAddress as string; // Retrieve the customer's saved address
    var shippingFee = ViewBag.ShippingFee ?? 0; // Retrieve the shipping fee (default to 0 if not set)
    var finalTotal = cartTotal + Convert.ToDecimal(shippingFee); // Calculate the final total
}

<div class="container mt-5">
    <h2 class="text-center">Checkout</h2>

    @if (cart == null || !cart.Any())
    {
        <div class="alert alert-info text-center">
            Your cart is empty. <a asp-controller="CustomerPage" asp-action="GetAllProducts">Continue shopping</a>.
        </div>
    }
    else
    {
        <!-- Cart Table -->
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cart)
                {
                    var product = products[item.Key];
                    <tr>
                        <td>@product["ProductName"]</td>
                        <td>@item.Value</td>
                        <td>$@(Convert.ToDecimal(product["CostPrice"]) * item.Value)</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Address Form -->
        <form asp-action="Checkout" method="post">
            <div class="form-group">
                <label for="deliveryAddress">Delivery Address</label>
                <textarea id="deliveryAddress" name="deliveryAddress" class="form-control" rows="3" placeholder="Enter your delivery address">@customerAddress</textarea>
            </div>

            <div class="form-group">
                <label for="deliveryType">Delivery Type</label>
                <select id="deliveryType" name="deliveryType" class="form-control">
                    <option value="Next Day Delivery">Next Day Delivery ($10.00)</option>
                    <option value="Three Day Delivery">Three Day Delivery ($5.00)</option>
                    <option value="One Week Delivery">One Week Delivery (Free)</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary mb-3">Update Shipping and Total</button>
        </form>

         <!-- Total Breakdown -->


        <div class="text-right mt-4">
            <h5>Total Product Price: @cartTotal.ToString("C")</h5>
            <h5>Total Shipping Fee: @Convert.ToDecimal(shippingFee).ToString("C")</h5>
            <h4><strong>Total: @finalTotal.ToString("C")</strong></h4>
            <button type="submit" class="btn btn-primary mb-3">Place Order</button>
        </div>
    }
</div>

