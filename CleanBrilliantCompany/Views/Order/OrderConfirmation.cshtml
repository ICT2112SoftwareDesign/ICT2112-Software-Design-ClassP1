@{
    ViewBag.Title = "Order Confirmation";
    var orderId = ViewBag.OrderId;
}

<div class="container mt-5">
    <div class="jumbotron text-center">
        <h2><i class="fa fa-check-circle text-success"></i> Order Confirmed!</h2>
        <p class="lead">Thank you for your purchase. Your order has been successfully placed.</p>
        <hr class="my-4">
        <h4>Order #@orderId</h4>
        <p>We've sent a confirmation email with your order details.</p>
        <a class="btn btn-primary btn-lg mt-3" href="@Url.Action("getAllProducts", "CustomerPage")" role="button">Continue Shopping</a>
    </div>
</div>