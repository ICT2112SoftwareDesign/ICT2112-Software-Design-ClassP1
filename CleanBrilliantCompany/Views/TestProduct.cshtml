@model List<Dictionary<string, object>>

<!DOCTYPE html>
<html>
<head>
    <title>Test Product</title>
</head>
<body>
    <!-- First way  -->
    @foreach (var product in Model)
    {
        <div class="product">
            <h2>Product Details</h2>
            <p><strong>ProductId:</strong> @product["ProductId"]</p>
            <p><strong>ProductName:</strong> @product["ProductName"]</p>
            <p><strong>Category:</strong> @product["Category"]</p>
            <p><strong>CostPrice:</strong> @product["CostPrice"]</p>
            <p><strong>ManufacturerId:</strong> @product["ManufacturerId"]</p>
            <p><strong>Package:</strong> @product["Package"]</p>
            <p><strong>Weight:</strong> @product["Weight"]</p>
            <p><strong>ToxicityPercentage:</strong> @product["ToxicityPercentage"]</p>
            <p><strong>Quantity:</strong> @product["Quantity"]</p>
            <p><strong>CarbonFootprint:</strong> @product["CarbonFootprint"]</p>
            <p><strong>Volume:</strong> @product["Volume"]</p>
        </div>
        <hr />
    }
 <!-- Second way  -->
    <h1>Product List</h1>
    <ul>
        @foreach (var product in Model)
        {
            <li>
                @foreach (var detail in product)
                {
                    <strong>@detail.Key:</strong> @detail.Value <br />
                }
            </li>
        }
    </ul>
</body>
</html>