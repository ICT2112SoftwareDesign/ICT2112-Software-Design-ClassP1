@model CleanBrilliantCompany.DTO.ToxicityReport

@{
    ViewData["Title"] = "Ingredient Toxicity Analysis";
}

<div class="container">
    <h2 class="my-4">Detailed Toxicity Analysis</h2>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Analyze Ingredient</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index", "ToxicityPage")">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="ingredientId">Select Ingredient:</label>
                                    <select id="ingredientId" name="ingredientId" class="form-control">
                                        <option value="1">Sodium Lauryl Sulfate</option>
                                        <option value="2">Cocamidopropyl Betaine</option>
                                        <option value="3">Glycerin</option>
                                        <option value="4">Benzyl Alcohol</option>
                                        <option value="5">Fragrance (Limonene)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">Analyze Toxicity</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Ingredients != null && Model.Ingredients.Any())
    {
        var ingredient = Model.Ingredients.First();
        
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Ingredient Analysis</h5>
                    </div>
                    <div class="card-body">
                        <h4>@Model.ProductName</h4>
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="alert @(Model.ToxicityClassification.Contains("High") ? "alert-danger" : 
                                                  Model.ToxicityClassification.Contains("Moderate") ? "alert-warning" : "alert-success")">
                                    <h5>Toxicity Level: @Model.OverallToxicityScore.ToString("F2")</h5>
                                    <p><strong>Classification:</strong> @Model.ToxicityClassification</p>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="alert alert-info">
                                    <h5>Safety Recommendation:</h5>
                                    <p>@Model.SafetyRecommendation</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ingredient Specific Recommendations -->
        @if (Model.IngredientSpecificRecommendations != null && Model.IngredientSpecificRecommendations.ContainsKey(ingredient.IngredientId))
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Specific Recommendations</h5>
                        </div>
                        <div class="card-body">
                            <p>@Model.IngredientSpecificRecommendations[ingredient.IngredientId]</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Alternative Ingredients (if high toxicity) -->
        @if (Model.IngredientAlternatives != null && Model.IngredientAlternatives.ContainsKey(ingredient.IngredientId))
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Suggested Alternatives</h5>
                        </div>
                        <div class="card-body">
                            <ul>
                                @foreach (var alternative in Model.IngredientAlternatives[ingredient.IngredientId])
                                {
                                    <li>@alternative</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Ingredient Details -->
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Ingredient Details</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Ingredient ID</td>
                                    <td>@ingredient.IngredientId</td>
                                </tr>
                                <tr>
                                    <td>Name</td>
                                    <td>@ingredient.IngredientName</td>
                                </tr>
                                <tr>
                                    <td>Toxicity Level</td>
                                    <td>
                                        <div class="progress">
                                            <div class="progress-bar @(ingredient.IngredientToxicity >= 0.7 ? "bg-danger" : 
                                                                      ingredient.IngredientToxicity >= 0.3 ? "bg-warning" : "bg-success")" 
                                                 role="progressbar" 
                                                 style="width: @(ingredient.IngredientToxicity * 100)%" 
                                                 aria-valuenow="@(ingredient.IngredientToxicity * 100)" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                                @(ingredient.IngredientToxicity.ToString("P0"))
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Threshold Quantity</td>
                                    <td>@ingredient.ThresholdQuantity @ingredient.MeasurementUnit</td>
                                </tr>
                                <tr>
                                    <td>Reorder Status</td>
                                    <td>
                                        @if (ingredient.ReorderStatus)
                                        {
                                            <span class="badge bg-danger">Reorder Required</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td>Last Updated</td>
                                    <td>@ingredient.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p>No ingredient data found. Please select an ingredient to analyze.</p>
        </div>
    }
</div>