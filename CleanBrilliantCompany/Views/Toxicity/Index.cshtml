@model CleanBrilliantCompany.DTO.ToxicityReport
@{
    ViewData["Title"] = "Ingredient Toxicity Analysis";
    var currentProduct = ViewBag.CurrentProduct ?? Model?.ProductName ?? "Eco-Friendly Shampoo";
}

<div id="wrapper" class="d-flex flex-nowrap min-vh-100">
    @await Html.PartialAsync("_Sidebar") 
    <div class="dashboard-content px-4">
        <div id="content" class="dashboard-container">
            <div class="container-fluid px-4">
    <h1 class="mt-4 mb-4">Ingredient Toxicity Analysis</h1>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Select Product</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("ViewByProductName", "Toxicity")" class="mb-0">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="productName" class="form-label">Select Product:</label>
                                    <select id="productName" name="productName" class="form-select form-control">
                                        @foreach (var product in ViewBag.Products ?? new string[] { "Eco-Friendly Shampoo", "sp1o0", "Bleach", "Organic Surface Spray", "All-Purpose Cleaner" })
                                        {
                                            if (product == currentProduct)
                                            {
                                                <option value="@product" selected>@product</option>
                                            }
                                            else
                                            {
                                                <option value="@product">@product</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-search me-1"></i> View Toxicity Analysis
                                </button>
                                <a href="@Url.Action("AddIngredient", "Toxicity", new { productName = currentProduct })" class="btn btn-success">
                                    <i class="fas fa-plus me-1"></i> Add New Ingredient
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Ingredients != null && Model.Ingredients.Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Product Toxicity Analysis</h5>
                    </div>
                    <div class="card-body">
                        <h4 class="mb-3">@Model.ProductName</h4>
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="alert @(Model.ToxicityClassification.Contains("High") ? "alert-danger" : 
                                                  Model.ToxicityClassification.Contains("Moderate") ? "alert-warning" : "alert-success")">
                                    <h5 class="mb-2">Overall Toxicity: @Model.OverallToxicityScore.ToString("F2")</h5>
                                    <p class="mb-0"><strong>Classification:</strong> @Model.ToxicityClassification</p>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="alert alert-info">
                                    <h5 class="mb-2">Safety Recommendation:</h5>
                                    <p class="mb-0">@Model.SafetyRecommendation</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Enhanced Analysis Section -->
        @if (Model.ProductSafetyAnalysis != null && Model.ProductSafetyAnalysis.Any())
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Safety Analysis</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var analysis in Model.ProductSafetyAnalysis)
                            {
                                <div class="alert alert-secondary mb-3">
                                    <h6 class="mb-2">@analysis.Key</h6>
                                    <p class="mb-0">@analysis.Value</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- New Toxicity Trends Section -->
        @if (Model.ToxicityTrends != null && Model.ToxicityTrends.Any())
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Toxicity Distribution Analysis</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var trend in Model.ToxicityTrends)
                            {
                                <div class="alert alert-info mb-3">
                                    <h6 class="mb-2">@trend.Key</h6>
                                    <p class="mb-0">@trend.Value</p>
                                </div>
                            }
                            
                            <!-- Visual representation of toxicity distribution -->
                            <div class="row mt-4">
                                <div class="col-md-12">
                                    <h6 class="mb-3">Visual Toxicity Distribution</h6>
                                    <div class="progress" style="height: 30px;">
                                        @{ 
                                            var lowCount = Model.GetLowToxicityCount();
                                            var modCount = Model.GetModerateToxicityCount();
                                            var highCount = Model.GetHighToxicityCount();
                                            var total = lowCount + modCount + highCount;
                                            
                                            var lowPercent = total > 0 ? (float)lowCount / total * 100 : 0;
                                            var modPercent = total > 0 ? (float)modCount / total * 100 : 0;
                                            var highPercent = total > 0 ? (float)highCount / total * 100 : 0;
                                        }
                                        
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @lowPercent%" 
                                             aria-valuenow="@lowPercent" aria-valuemin="0" aria-valuemax="100">
                                            @if (lowPercent > 10) { <span>Low (@lowCount)</span> }
                                        </div>
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @modPercent%" 
                                             aria-valuenow="@modPercent" aria-valuemin="0" aria-valuemax="100">
                                            @if (modPercent > 10) { <span>Moderate (@modCount)</span> }
                                        </div>
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: @highPercent%" 
                                             aria-valuenow="@highPercent" aria-valuemin="0" aria-valuemax="100">
                                            @if (highPercent > 10) { <span>High (@highCount)</span> }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- New Correlation Analysis Section -->
        @if (Model.CorrelationAnalysis != null && Model.CorrelationAnalysis.Any())
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Ingredient Interaction Analysis</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var correlation in Model.CorrelationAnalysis)
                            {
                                <div class="alert @(correlation.Key.Contains("Positive") ? "alert-success" : "alert-warning") mb-3">
                                    <h6 class="mb-2">@correlation.Key</h6>
                                    <p class="mb-0">@correlation.Value</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Carbon Footprint Info -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Carbon Footprint Information</h5>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.CarbonFootprint != null)
                        {
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="alert alert-info">
                                        <h6 class="mb-2">Carbon Footprint Value:</h6>
                                        <p class="mb-0">@ViewBag.CarbonFootprint units</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="alert alert-info">
                                        <h6 class="mb-2">Environmental Impact:</h6>
                                        <p class="mb-0">@ViewBag.CarbonFootprintImpact</p>
                                    </div>
                                </div>
                            </div>
                            <p class="mt-3">High toxicity ingredients (@Model.GetHighToxicityCount()) in this product may contribute approximately @(Model.GetHighToxicityCount() * 15)% more to its carbon footprint during production compared to low-toxicity alternatives.</p>
                        }
                        else
                        {
                            <p class="text-muted mb-2">Carbon footprint data from Team 1 will be integrated here when available.</p>
                            <p class="fst-italic mb-0">This section will display the carbon footprint impact of the product's ingredients when data becomes available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Ingredient Breakdown</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Ingredient Name</th>
                                        <th>Toxicity Level</th>
                                        <th>Classification</th>
                                        <th>Threshold Quantity</th>
                                        <th>Measurement Unit</th>
                                        <th>Reorder Status</th>
                                        <th>Alternatives</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ingredient in Model.Ingredients)
                                    {
                                        <tr>
                                            <td>@ingredient.IngredientId</td>
                                            <td>@ingredient.IngredientName</td>
                                            <td>
                                                <div class="progress">
                                                    <div class="progress-bar @(ingredient.IngredientToxicity >= 0.7 ? "bg-danger" : 
                                                                              ingredient.IngredientToxicity >= 0.3 ? "bg-warning" : "bg-success")" 
                                                         role="progressbar" 
                                                         style="width: @(ingredient.IngredientToxicity * 100)%" 
                                                         aria-valuenow="@(ingredient.IngredientToxicity * 100)" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @(ingredient.IngredientToxicity.ToString("P0"))
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @{
                                                    string classification = ingredient.IngredientToxicity >= 0.7 ? "High" : 
                                                                           ingredient.IngredientToxicity >= 0.3 ? "Moderate" : "Low";
                                                    string badgeClass = ingredient.IngredientToxicity >= 0.7 ? "bg-danger" : 
                                                                       ingredient.IngredientToxicity >= 0.3 ? "bg-warning" : "bg-success";
                                                }
                                                <span class="badge @badgeClass">@classification Toxicity</span>
                                            </td>
                                            <td>@ingredient.ThresholdQuantity</td>
                                            <td>@ingredient.MeasurementUnit</td>
                                            <td>
                                                @if (ingredient.ReorderStatus)
                                                {
                                                    <span class="badge bg-danger">Reorder Required</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">In Stock</span>
                                                }
                                            </td>
                                            <td>
                                                @if (ingredient.IngredientToxicity >= 0.7 && Model.IngredientAlternatives.ContainsKey(ingredient.IngredientId))
                                                {
                                                    <button class="btn btn-sm btn-info" type="button" data-bs-toggle="collapse" 
                                                            data-bs-target="#alternatives-@ingredient.IngredientId" aria-expanded="false">
                                                        <i class="fas fa-exchange-alt me-1"></i> View Alternatives
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Not Required</span>
                                                }
                                            </td>
                                        </tr>
                                        @if (ingredient.IngredientToxicity >= 0.7 && Model.IngredientAlternatives.ContainsKey(ingredient.IngredientId))
                                        {
                                            <tr>
                                                <td colspan="8" class="p-0">
                                                    <div class="collapse" id="alternatives-@ingredient.IngredientId">
                                                        <div class="card card-body border-0 bg-light">
                                                            <h6 class="mb-3">Safer Alternatives for @ingredient.IngredientName:</h6>
                                                            <ul class="mb-0">
                                                                @foreach (var alternative in Model.IngredientAlternatives[ingredient.IngredientId])
                                                                {
                                                                    <li class="mb-2">@alternative</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Generate Report Button -->
        <div class="row mt-4 mb-5">
            <div class="col-md-12 text-center">
                <a href="@Url.Action("GenerateReport", "Toxicity", new { productName = Model.ProductName })" 
                   class="btn btn-lg btn-success" target="_blank">
                    <i class="fas fa-file-download me-2"></i> Generate Toxicity Report
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p class="mb-0">No ingredients found for the selected product. Please choose a different product or add ingredients.</p>
        </div>
    }
</div>
        </div>
    </div>
</div>

