@model CleanBrilliantCompany.DTO.ToxicityReport

@{
    ViewData["Title"] = "Ingredient Toxicity Analysis";
}

<div class="container">
    <h2 class="my-4">Ingredient Toxicity Analysis</h2>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Select Product</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("ViewByProductName", "Toxicity")">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="productName">Select Product:</label>
                                    <select id="productName" name="productName" class="form-control">
                                        <option value="Eco-Friendly Shampoo">Eco-Friendly Shampoo</option>
                                        <option value="sp1o0">sp1o0</option>
                                        <option value="Bleach">Bleach</option>
                                        <option value="Organic Surface Spray">Organic Surface Spray</option>
                                        <option value="All-Purpose Cleaner">All-Purpose Cleaner</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">View Toxicity Analysis</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add New Ingredient</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" asp-controller="Toxicity" method="post">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label for="IngredientName">Ingredient Name</label>
                                    <input name="IngredientName" id="IngredientName" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label for="IngredientToxicity">Toxicity Level (0.0-1.0)</label>
                                    <input type="number" step="0.1" min="0" max="1" name="IngredientToxicity" id="IngredientToxicity" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label for="ProductId">Product ID</label>
                                    <input type="number" name="ProductId" id="ProductId" class="form-control" value="2" required />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label for="ThresholdQuantity">Threshold Quantity</label>
                                    <input type="number" name="ThresholdQuantity" id="ThresholdQuantity" class="form-control" value="50" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label for="MeasurementUnit">Measurement Unit</label>
                                    <input type="text" name="MeasurementUnit" id="MeasurementUnit" class="form-control" value="ml" required />
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">Analyze</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Ingredients != null && Model.Ingredients.Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Product Toxicity Analysis</h5>
                    </div>
                    <div class="card-body">
                        <h4>@Model.ProductName</h4>
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="alert @(Model.ToxicityClassification.Contains("High") ? "alert-danger" : 
                                                  Model.ToxicityClassification.Contains("Moderate") ? "alert-warning" : "alert-success")">
                                    <h5>Overall Toxicity: @Model.OverallToxicityScore.ToString("F2")</h5>
                                    <p><strong>Classification:</strong> @Model.ToxicityClassification</p>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="alert alert-info">
                                    <h5>Safety Recommendation:</h5>
                                    <p>@Model.SafetyRecommendation</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Enhanced Analysis Section -->
        @if (Model.ProductSafetyAnalysis != null && Model.ProductSafetyAnalysis.Any())
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Safety Analysis</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var analysis in Model.ProductSafetyAnalysis)
                            {
                                <div class="alert alert-secondary">
                                    <h6>@analysis.Key</h6>
                                    <p>@analysis.Value</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- New Toxicity Trends Section -->
        @if (Model.ToxicityTrends != null && Model.ToxicityTrends.Any())
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Toxicity Distribution Analysis</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var trend in Model.ToxicityTrends)
                            {
                                <div class="alert alert-info">
                                    <h6>@trend.Key</h6>
                                    <p>@trend.Value</p>
                                </div>
                            }
                            
                            <!-- Visual representation of toxicity distribution -->
                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <h6>Visual Toxicity Distribution</h6>
                                    <div class="progress" style="height: 30px;">
                                        @{ 
                                            var lowCount = Model.GetLowToxicityCount();
                                            var modCount = Model.GetModerateToxicityCount();
                                            var highCount = Model.GetHighToxicityCount();
                                            var total = lowCount + modCount + highCount;
                                            
                                            var lowPercent = total > 0 ? (float)lowCount / total * 100 : 0;
                                            var modPercent = total > 0 ? (float)modCount / total * 100 : 0;
                                            var highPercent = total > 0 ? (float)highCount / total * 100 : 0;
                                        }
                                        
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @lowPercent%" 
                                             aria-valuenow="@lowPercent" aria-valuemin="0" aria-valuemax="100">
                                            @if (lowPercent > 10) { <span>Low (@lowCount)</span> }
                                        </div>
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @modPercent%" 
                                             aria-valuenow="@modPercent" aria-valuemin="0" aria-valuemax="100">
                                            @if (modPercent > 10) { <span>Moderate (@modCount)</span> }
                                        </div>
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: @highPercent%" 
                                             aria-valuenow="@highPercent" aria-valuemin="0" aria-valuemax="100">
                                            @if (highPercent > 10) { <span>High (@highCount)</span> }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- New Correlation Analysis Section -->
        @if (Model.CorrelationAnalysis != null && Model.CorrelationAnalysis.Any())
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Ingredient Interaction Analysis</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var correlation in Model.CorrelationAnalysis)
                            {
                                <div class="alert @(correlation.Key.Contains("Positive") ? "alert-success" : "alert-warning")">
                                    <h6>@correlation.Key</h6>
                                    <p>@correlation.Value</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Carbon Footprint Info Placeholder -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Carbon Footprint Information</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Carbon footprint data from Module 1 will be integrated here when available.</p>
                        <p><em>This section will display the carbon footprint impact of the product's ingredients when data becomes available.</em></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Ingredient Breakdown</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Ingredient Name</th>
                                    <th>Toxicity Level</th>
                                    <th>Classification</th>
                                    <th>Threshold Quantity</th>
                                    <th>Measurement Unit</th>
                                    <th>Reorder Status</th>
                                    <th>Alternatives</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ingredient in Model.Ingredients)
                                {
                                    <tr>
                                        <td>@ingredient.IngredientId</td>
                                        <td>@ingredient.IngredientName</td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar @(ingredient.IngredientToxicity >= 0.7 ? "bg-danger" : 
                                                                          ingredient.IngredientToxicity >= 0.3 ? "bg-warning" : "bg-success")" 
                                                     role="progressbar" 
                                                     style="width: @(ingredient.IngredientToxicity * 100)%" 
                                                     aria-valuenow="@(ingredient.IngredientToxicity * 100)" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                    @(ingredient.IngredientToxicity.ToString("P0"))
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                string classification = ingredient.IngredientToxicity >= 0.7 ? "High" : 
                                                                       ingredient.IngredientToxicity >= 0.3 ? "Moderate" : "Low";
                                                string badgeClass = ingredient.IngredientToxicity >= 0.7 ? "bg-danger" : 
                                                                   ingredient.IngredientToxicity >= 0.3 ? "bg-warning" : "bg-success";
                                            }
                                            <span class="badge @badgeClass">@classification Toxicity</span>
                                        </td>
                                        <td>@ingredient.ThresholdQuantity</td>
                                        <td>@ingredient.MeasurementUnit</td>
                                        <td>
                                            @if (ingredient.ReorderStatus)
                                            {
                                                <span class="badge bg-danger">Reorder Required</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">In Stock</span>
                                            }
                                        </td>
                                        <td>
                                            @if (ingredient.IngredientToxicity >= 0.7 && Model.IngredientAlternatives.ContainsKey(ingredient.IngredientId))
                                            {
                                                <button class="btn btn-sm btn-info" type="button" data-bs-toggle="collapse" 
                                                        data-bs-target="#alternatives-@ingredient.IngredientId" aria-expanded="false">
                                                    View Alternatives
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Required</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (ingredient.IngredientToxicity >= 0.7 && Model.IngredientAlternatives.ContainsKey(ingredient.IngredientId))
                                    {
                                        <tr>
                                            <td colspan="8" class="p-0">
                                                <div class="collapse" id="alternatives-@ingredient.IngredientId">
                                                    <div class="card card-body">
                                                        <h6>Safer Alternatives for @ingredient.IngredientName:</h6>
                                                        <ul>
                                                            @foreach (var alternative in Model.IngredientAlternatives[ingredient.IngredientId])
                                                            {
                                                                <li>@alternative</li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Generate Report Button -->
        <div class="row mt-4 mb-5">
            <div class="col-md-12 text-center">
                <a href="@Url.Action("GenerateReport", "Toxicity", new { productName = Model.ProductName })" 
                   class="btn btn-lg btn-success" target="_blank">
                    <i class="bi bi-file-earmark-pdf me-2"></i> Generate Toxicity Report
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p>No ingredients found for the selected product. Please choose a different product or add ingredients.</p>
        </div>
    }
</div>