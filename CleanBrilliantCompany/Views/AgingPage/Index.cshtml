@model AgingDashboardRdm
@{
    ViewData["Title"] = "Aging Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; 
    var productToBatchMap = Model != null ? Model.getProductToBatchMap() : new Dictionary<int, List<int>>();
    var allMetrics = Model != null
        ? productToBatchMap
            .SelectMany(p => p.Value
                .SelectMany(batch => Model.GetBatchAnalytics(batch)
                    .SelectMany(a => a.CalculateBatchSummary().Keys)))
            .Distinct()
            .ToList()
        : new List<string>();

    var productToNameMap = Model != null ? Model.getProductIDToNameMap() : new Dictionary<int, String>();
}

<h2>Aging Dashboard</h2>

    @if (Model != null)
    {
        <div>
            <p><strong>Dashboard Name:</strong> @Model.Name</p>
            <p><strong>Generated On:</strong> @(Model.GeneratedDate?.ToString("yyyy-MM-dd") ?? "Not Generated")</p>
            <p><strong>Validity Duration:</strong> @Model.ValidityDuration days</p>
        </div>

        <h3>Analytics</h3>
        <div class="mb-3">
            <input id="productSearchInput" type="text" class="form-control" placeholder="Search by Product Name...">
        </div>
        <div class="mb-4">
            <button class="btn btn-outline-primary me-2" id="showBatchView">Batch View</button>
            <button class="btn btn-outline-secondary" id="showProductView">Product View</button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
                Generate Dashboard
            </button>

            <!-- Modal -->
            <div class="modal fade" id="generateModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-controller="AgingPage" asp-action="GenerateDashboard" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                    <h5 class="modal-title">Generate New Dashboard</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                    <div class="mb-3">
                        <label for="ValidityDuration" class="form-label">Validity (days)</label>
                        <input type="number" class="form-control" name="ValidityDuration" required />
                    </div>
                    <div class="mb-3">
                        <label for="RequestedStartDate" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id = "RequestedStartDate" name="RequestedStartDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        <div class ="invalid-feedback" id = "startDateError">
                            Start Date must be before End Date and not be future dates
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="RequestedEndDate" class="form-label">End Date</label>
                        <input type="date" class="form-control" id = "RequestedEndDate" name="RequestedEndDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        <div class ="invalid-feedback" id= "endDateError">
                            End Date must be after Start Date and not be future dates
                        </div>
                    </div>
                    </div>

                    <div class="modal-footer">
                    <button type="submit" id = "generateDashboardBtn" class="btn btn-primary">Generate</button>
                    </div>
                </div>
                </form>
            </div>
            </div>
        </div>



        @if (productToBatchMap.Any())
        {

            <div id="batchViewContainer">
                <!-- your current batch-level chart rendering here -->
                
                    @* ✅ Loop through each product *@
                    @foreach (var product in productToBatchMap)
                    {
                        <div class="product-section col-12" data-product-id="@product.Key" data-product-name= "@productToNameMap[product.Key]">
                            @* <h4 class="text-primary">Product ID: @product.Key</h4> *@
                            <h4 class="text-primary">@productToNameMap[product.Key]</h4>
                            @* ✅ Get all unique metrics from all batches in this product *@
                            @{
                                var productMetrics = product.Value
                                    .SelectMany(batch => Model.GetBatchAnalytics(batch)
                                        .SelectMany(analytics => analytics.CalculateBatchSummary().Keys))
                                    .Distinct()
                                    .ToList();
                            }

                            @* ✅ Loop through each metric and create a chart comparing batches *@
                            @for (int i = 0; i < productMetrics.Count; i += 2)
                            {
                                <div class="row">
                                    <div class="@(i + 1 < productMetrics.Count ? "col-md-6" : "col-12")">
                                        <div class="card p-3 mb-3">
                                            <h5>@productMetrics[i]</h5>
                                            <canvas id="chart-@product.Key-@productMetrics[i]" class="shared-chart-size"></canvas>
                                        </div>
                                    </div>

                                    @if (i + 1 < productMetrics.Count)
                                    {
                                        <div class="col-md-6">
                                            <div class="card p-3 mb-3">
                                                <h5>@productMetrics[i + 1]</h5>
                                                <canvas id="chart-@product.Key-@productMetrics[i + 1]" class="shared-chart-size"></canvas>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    }
                
            </div>

            <div id="productViewContainer" style="display: none;">
                <div class="card mb-4 p-3">
                    <h4>Remaining Days Risk Summary</h4>
                    <ul class="list-group">
                        @foreach (var product in productToBatchMap)
                        {
                            var matchingValues = product.Value
                                .SelectMany(batch => Model.GetBatchAnalytics(batch))
                                .SelectMany(a => a.CalculateBatchSummary())
                                .Where(kv => kv.Key == "RemainingDays")
                                .Select(kv => Convert.ToSingle(kv.Value))
                                .ToList();

                            if (matchingValues.Any())
                            {
                                var expiringSoon = matchingValues.Count(v => v <= 30);
                                var medium = matchingValues.Count(v => v > 30 && v <= 90);
                                var safe = matchingValues.Count(v => v > 90);

                                var maxCount = Math.Max(expiringSoon, Math.Max(medium, safe));
                                var status = "Unknown";
                                var badge = "secondary";

                                if (maxCount == expiringSoon)
                                {
                                    status = "Expiring Soon (≤30)";
                                    badge = "danger";
                                }
                                else if (maxCount == medium)
                                {
                                    status = "Medium (30–90)";
                                    badge = "warning";
                                }
                                else if (maxCount == safe)
                                {
                                    status = "Safe (>90)";
                                    badge = "success";
                                }

                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @* Product @product.Key *@
                                    @productToNameMap[product.Key]
                                    <span class="badge bg-@badge">@status</span>
                                </li>
                            }
                        }
                    </ul>
                </div>

                @* Your chart canvases (added via JS) will still go here *@

            </div>

            
        } else {
            <p>No analytics data available</p>
            }
    } else {
        <p>No dashboard available</p>
        }


    <!-- Your Custom JS Script Here -->
    <script>
        const allMetrics = @Html.Raw(Json.Serialize(allMetrics));
        const productToBatchMap = @Html.Raw(Json.Serialize(productToBatchMap)); 


        // filtering the product sections based on the search input
        document.addEventListener("DOMContentLoaded", function () {
            const input = document.getElementById("productSearchInput");

            input.addEventListener("input", function () {
                const query = input.value.trim().toLowerCase();
                const productSections = document.querySelectorAll(".product-section");

                productSections.forEach(section => {
                    @* const productId = section.getAttribute("data-product-id").toLowerCase();
                    section.style.display = productId.includes(query) ? "block" : "none"; *@

                    // trying out product name instead 
                    const productName = section.getAttribute("data-product-name").toLowerCase(); 
                    section.style.display = productName.includes(query) ? "block" : "none"; 
                });
            });
        });

        // date validator 
        document.addEventListener("DOMContentLoaded", function () 
        {
            const endDateInput = document.getElementById("RequestedEndDate");
            const startDateInput = document.getElementById("RequestedStartDate");
            const generateBtn = document.getElementById("generateDashboardBtn");
            const today = new Date().toISOString().split('T')[0]; // "YYYY-MM-DD"
            
            endDateInput.addEventListener("change", function () 
            {
                const selectedEndDate = endDateInput.value;
                if (selectedEndDate) 
                {
                    console.log("setting max")
                    startDateInput.max = selectedEndDate;

                    if (startDateInput.value > selectedEndDate) 
                    {
                        startDateInput.value = selectedEndDate;
                    }
                } else 
                {
                    console.log("removing max")
                    startDateInput.removeAttribute("max");
                }
            });

            //2. Validate on submit 
            generateBtn.addEventListener("click", function (e) 
            {
                const startDate = new Date(startDateInput.value);
                const endDate = new Date(endDateInput.value);
                let isValid = true; 

                [startDateInput,endDateInput].forEach( input => input.classList.remove("is-invalid") )

                // check if the dates are in future
                if (startDate > today || endDate > today) 
                {
                    isValid = false;
                    document.getElementById("startDateError").textContent = "Start date cannot be in the future.";
                    document.getElementById("endDateError").textContent = "End date cannot be in the future.";
                }
                //check end date earlier than start date 
                if (startDate > endDate) 
                {
                    isValid = false;
                    document.getElementById("startDateError").textContent = "Start date cannot be after end date.";
                    document.getElementById("endDateError").textContent = "End date must be after start date.";
                } 
                if (!isValid)
                {
                    e.preventDefault();
                    [startDateInput,endDateInput].forEach( input => input.classList.add("is-invalid") )  
                }

                
            });
        });

        // Show Batch View Button Click Event
        document.getElementById("showBatchView").addEventListener("click", () => {
            document.getElementById("batchViewContainer").style.display = "block";
            document.getElementById("productViewContainer").style.display = "none";
            // show the searchbar as well
            document.getElementById("productSearchInput").style.display = "block"; 

        });
        
        // Show Product View Button Click Event
        document.getElementById("showProductView").addEventListener("click", () => {
            document.getElementById("batchViewContainer").style.display = "none";
            document.getElementById("productViewContainer").style.display = "block";
            // remove the searchbar as well
            document.getElementById("productSearchInput").style.display = "none";
            });


        document.addEventListener("DOMContentLoaded", function () 
            {
                generateBatchCharts(); 
                generateProductCharts();
            });

 

    function generateBatchCharts() 
    {
        @foreach (var product in Model.getProductToBatchMap())
        {
            var productKey = product.Key;
            var batchList = product.Value;
            foreach (var metric in allMetrics)
            {
                var batchData = new Dictionary<int, object>();

                foreach (var batchcode in batchList)
                {
                    var batchMetrics = Model.GetBatchAnalytics(batchcode)
                        .SelectMany(a => a.CalculateBatchSummary()) 
                        .ToDictionary(e => e.Key, e => e.Value);

                    if (batchMetrics.ContainsKey(metric))
                    {
                        batchData[batchcode] = batchMetrics[metric];
                    }
                }

                var chartId = $"chart-{productKey}-{metric}";
                var jsChartId = $"{productKey}{metric}";
                var valuesJson = Json.Serialize(batchData.Values);
                var labelsJson = Json.Serialize(batchData.Keys);
                //Console.WriteLine("valuesJson" + valuesJson); 
                //Console.WriteLine("labelsJson" + labelsJson); 
                var axis = metric == "StorageDuration" ? "y" : "x";

                // need to mod the data for deadstockpercentage as each value should be 100 percent but 2 different colors 
                if (metric == "DeadStockPercentage")
                {
                    var deadstockValues = batchData.Values.Select(v => Convert.ToDouble(v)).ToList();
                    var usedValues = deadstockValues.Select(v => 100 - v).ToList();

                    var usedJson = Json.Serialize(usedValues);
                    var deadJson = Json.Serialize(deadstockValues);

                    <text>
                        renderStackedChart(
                            "@chartId",
                            @Html.Raw(labelsJson),
                            @Html.Raw(usedJson),
                            @Html.Raw(deadJson)
                        );
                    </text>

                } else if (metric == "RemainingDays")
                {
                    var RemainingDaysList = batchData.Values.Select(v => Convert.ToInt32(v)).ToList(); 
                    int expiringSoon = RemainingDaysList.Count(v => v <= 30); 
                    int medium = RemainingDaysList.Count(v => v > 30 && v <= 90); 
                    int safe = RemainingDaysList.Count(v => v > 90); 
                    var binLabels = Json.Serialize(new[] { "Expiring Soon (≤30)", "Medium (30–90)", "Safe (>90)" });
                    var binCounts = Json.Serialize(new[] { expiringSoon, medium, safe });

                    <text>
                        renderDonutChart(
                            "@chartId",
                            @Html.Raw(binLabels),
                            @Html.Raw(binCounts)
                        ); 
                    </text> 

                } else 
                {
                    <text>
                        renderChart(
                            "@chartId", "@metric", @Html.Raw(labelsJson), @Html.Raw(valuesJson),null,"bar","@axis"
                            ); 
                    </text>                    
                }


            }
        }
    }




    Chart.register(ChartDataLabels); 

    function renderDonutChart(chartId, labels, data, colors) 
    {
        const ctx = document.getElementById(chartId).getContext('2d');

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors || [
                        'rgba(75, 192, 192, 0.7)',   // Fresh
                        'rgba(255, 205, 86, 0.7)',   // Medium
                        'rgba(255, 99, 132, 0.7)'    // Long
                    ],
                    borderColor: [
                        'rgba(75, 192, 192, 1)',
                        'rgba(255, 205, 86, 1)',
                        'rgba(255, 99, 132, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true, // ✅ allows height control from CSS
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Remaining Days Distribution'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `${context.label}: ${context.raw} batch(es)`;
                            }
                        }
                    }
                }
            }
        });
    }



    function renderStackedChart(chartId, labels, usedData, deadData) 
    {
        const ctx = document.getElementById(chartId).getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Used Stock',
                        data: usedData,
                        backgroundColor: 'rgba(54, 162, 235, 0.7)',
                        stack: 'stack1'
                    },
                    {
                        label: 'Dead Stock',
                        data: deadData,
                        backgroundColor: 'rgba(255, 99, 132, 0.7)',
                        stack: 'stack1'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    },
                },
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, beginAtZero: true }
                }
            }
        });
    }


    function renderChart ( chartId, chartLabel, labels, data , barColors = null, chartType = "bar", indexAxis = "x")
    {
        console.log ("chartLabel", chartLabel); 
        console.log ("labels", labels); 
        console.log ("data", data); 
        const ctx = document.getElementById(chartId).getContext('2d'); 

        // 🧠 Check for boolean values and convert accordingly
        let finalData = data;
        let finalColors = barColors;
        let max = Math.min(Math.max(...data),100) ; 

        if (typeof data[0] === "boolean") 
        {
            // Convert booleans to 1s
            finalData = data.map(val => val ? 1 : 1); // Always height of 1
            finalColors = data.map(val => val ? "red" : "green"); // Green for true, red for false
            max = 1.5
        }
        

        new Chart( ctx , 
        {
            type: chartType, 
            data : 
            {
                labels : labels,
                datasets:[
                {
                    label : chartLabel,
                    data : finalData,
                    backgroundColor: finalColors || 
                    [
                    'rgba(255, 99, 132, 0.6)',
                    'rgba(54, 162, 235, 0.6)',
                    'rgba(255, 206, 86, 0.6)',
                    'rgba(75, 192, 192, 0.6)',
                    'rgba(153, 102, 255, 0.6)'
                    ],
                borderWidth : 1 
                }]
            },
            options: 
            {
                responsive: true,
                indexAxis: indexAxis,
                plugins : 
                {
                    tooltip : 
                    {
                        //on hover controls what is appearing
                        callbacks: 
                        {
                            label: function(context)
                            {
                                if (typeof data[0] === "boolean") {
                                    return data[context.dataIndex] ? "Expired" : "Still Good";
                                }
                                if (indexAxis === "y") {
                                    return context.dataset.label + ": " + context.parsed.x; 
                                }
                                return context.dataset.label + ": " + context.parsed.y; 
                            }
                        }
                    },
                    datalabels: 
                    {
                        color: 'black',
                        anchor: 'end',
                        align: 'top',
                        font: { weight: 'bold' },
                        formatter: function(value, context) {
                            if (typeof data[0] === "boolean") {
                                return data[context.dataIndex] ? "Expired" : "Still Good";
                            }
                            return ""; // No label if not boolean
                        }
                    }
                },
                @* scales: chartType === "bar" ? 
                {
                    y: 
                    {
                        beginAtZero: true,
                        max: max,
                        ticks: 
                        {
                            // if data is boolean , we can use 0/1 
                            callback : function (value) {
                                  return typeof data[0] === "boolean" ? (value === 1 ? chartLabel : "") : value;
                            }
                        }
                    }
                } : {} *@
                scales : indexAxis ==="y" ?
                {
                    x : 
                    {
                        beginAtZero: true,
                    }
                } : 
                {
                    y : 
                    {
                        beginAtZero: true,
                        max: max,
                        ticks: 
                        {
                            // if data is boolean , we can use 0/1 
                            callback : function (value) {
                                  return typeof data[0] === "boolean" ? (value === 1 ? chartLabel : "") : value;
                            }
                        }
                    }
                } 
            }
        });
    }

    function generateProductCharts()
    {

        @foreach (var metric in allMetrics)
        {
            if (metric != "TurnOverRate" && metric != "DeadStockPercentage")
            {
                continue; 
            }
            var productLabels = new List<string>();
            var productValues = new List<float>();
            Console.WriteLine("Doing Metric: " + metric); 
            foreach (var product in productToBatchMap)
            {
                Console.WriteLine("product" + product.Key); 
                Console.WriteLine("=============================="); 
                // find the name of the product 
                var productName = productToNameMap[product.Key]; 

                var batchCodes = product.Value;
                var allAnalytics = batchCodes
                    .SelectMany(batch => Model.GetBatchAnalytics(batch))
                    .ToList();

                var matchingValues = allAnalytics
                    .SelectMany(a => a.CalculateBatchSummary())
                    .Where(kv => kv.Key == metric)
                    .Select(kv => Convert.ToSingle(kv.Value))
                    .ToList();
                
                Console.WriteLine("matchingValues Count: " + matchingValues.Count); 
                foreach (var value in matchingValues)
                {
                    Console.Write ("Value: " + value);
                }
                // so if the metric is remainingdays 
                // we will track how many batches is expiring soon, medium and safe 
                if (matchingValues.Any())
                {

                    productLabels.Add(productName);
                    productValues.Add(matchingValues.Average()); // Use Sum/Max/etc if preferred

                }

                Console.WriteLine(" ");
                Console.WriteLine("End of product " + product.Key); 
                
            }

            var safeId = metric.Replace(" ", "").Replace("-", "").Replace(".", "");
            var labelsJson = Json.Serialize(productLabels);
            var valuesJson = Json.Serialize(productValues);
            Console.WriteLine("Creating the product chart for " + metric); 

            <text>
                const canvas_@safeId = document.createElement('canvas');
                canvas_@(safeId).id = "product-chart-@safeId";
                canvas_@(safeId).classList.add("mb-4");


                document.getElementById("productViewContainer").appendChild(canvas_@safeId);

                const ctx_@safeId = canvas_@(safeId).getContext("2d");
                
                renderChart(
                    "product-chart-@safeId",
                    "@metric",
                    @Html.Raw(labelsJson),
                    @Html.Raw(valuesJson),
                    null, // barColors (optional)
                    "bar", // chartType
                    "x"    // indexAxis
                );

            </text>



            Console.WriteLine("End of Metric");
        }
    }



</script>




